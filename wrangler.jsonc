{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "deployz-website",
  "compatibility_date": "2026-08-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "deployz.dev", "custom_domain": true }
  ]
}
