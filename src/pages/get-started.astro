---
import { ArrowRight } from 'lucide-react';
import PageHeader from '@/components/site/PageHeader.astro';
import Section from '@/components/site/Section.astro';
import Base from '../layouts/Base.astro';

const steps = [
  { title: 'Create your account', text: 'Sign up, or sign in if you already have an account.' },
  { title: 'Connect GitHub', text: 'Authorize the Deployz GitHub connection. It has read-only access to the repository contents.' },
  { title: 'Select a repository', text: 'Select the application repository. The analysis starts immediately and usually takes a few minutes.' },
  { title: 'Review the result', text: 'See what passed, what needs attention, and what blocks deployment.' },
];

const does = [
  'Read the default branch of the repository that you select',
  'Find the container build, port, health check, commands, and environment variables',
  'Find the PostgreSQL, Redis, and file-storage requirements',
  'Show what passed, what needs attention, and what blocks deployment',
  'Send limited repository excerpts to an AI service when a question stays open. Deployz redacts values that look like secrets first.',
];

const doesNot = [
  'Write to your repository. The GitHub connection is read-only.',
  'Give your customer access to your repository',
  'Ask for a card or start a charge',
  'Need access to an AWS account for the analysis',
];

const after = [
  { lead: 'Build a release.', text: 'Correct the items that block deployment, then build the first version. One test deployment of your own application is free.' },
  { lead: 'Send your customer one link.', text: 'The customer reviews the access and connects their AWS account. They do not need a Deployz account.' },
  { lead: 'Deploy.', text: 'The first deployment typically takes 20 to 45 minutes. The charges start with your first customer environment.' },
];
---

<Base
  title="Get Started with Deployz — Check Your Application"
  description="Connect your repository and find out in a few minutes if your SaaS application is ready for deployment in customer-owned AWS accounts. The evaluation is free."
>
  <PageHeader title="Find out in a few minutes if your application is ready">
    Connect your repository. Deployz tells you what is ready and what you must change. The
    evaluation is free, and no card is necessary.
    <Fragment slot="actions">
      <a class="btn btn-primary btn-lg" href="https://app.deployz.dev/sign-up">Connect my application</a>
      <a class="btn btn-secondary btn-lg" href="https://app.deployz.dev/sign-in">Sign in</a>
    </Fragment>
    <!-- Readiness path: the four steps, kept beside the CTA -->
    <div slot="aside" class="lg:border-l lg:border-border lg:pl-12">
      <h2 class="text-[16px] font-semibold">Four steps to your readiness report</h2>
      <ol class="mt-6">
        {steps.map((step, index) => (
          <li class="path-step grid grid-cols-[28px_minmax(0,1fr)] gap-x-4 pb-6 last:pb-0">
            <span class="path-node">{index + 1}</span>
            <div class="min-w-0">
              <h3 class="text-[16px] leading-7 font-semibold">{step.title}</h3>
              <p class="mt-1 text-[14px] text-muted-foreground">{step.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </PageHeader>

  <!-- Does / does not: two columns split by a hairline -->
  <Section labelledby="scope-title">
    <h2 id="scope-title" class="text-h2 max-w-[640px]">What the analysis does and does not do</h2>
    <div class="mt-10 grid gap-12 md:grid-cols-2 md:gap-0 lg:mt-12">
      <div class="md:pr-12 lg:pr-16">
        <h3 class="text-h3 border-t border-foreground pt-5">Deployz does</h3>
        <ul class="mt-4 border-b border-border">
          {does.map((item) => <li class="border-t border-border py-3 text-muted-foreground">{item}</li>)}
        </ul>
      </div>
      <div class="md:border-l md:border-border md:pl-12 lg:pl-16">
        <h3 class="text-h3 border-t border-foreground pt-5">Deployz does not</h3>
        <ul class="mt-4 border-b border-border">
          {doesNot.map((item) => <li class="border-t border-border py-3 text-muted-foreground">{item}</li>)}
        </ul>
      </div>
    </div>
    <a class="link-arrow mt-8" href="/#example-report">See an example report <ArrowRight className="size-4" aria-hidden="true" /></a>
  </Section>

  <!-- After the analysis: three quiet columns -->
  <Section tone="subtle" labelledby="after-title">
    <h2 id="after-title" class="text-h2">After the analysis</h2>
    <ol class="mt-10 grid gap-10 md:grid-cols-3 md:gap-8 lg:mt-12 lg:gap-12">
      {after.map((item, index) => (
        <li class="border-t border-foreground pt-5">
          <span class="text-[14px] font-medium text-subtle tabular-nums">{String(index + 1).padStart(2, '0')}</span>
          <p class="mt-3 text-muted-foreground"><strong class="font-semibold text-foreground">{item.lead}</strong> {item.text}</p>
        </li>
      ))}
    </ol>
    <a class="link-arrow mt-8" href="/docs#supported-architecture">View supported architecture <ArrowRight className="size-4" aria-hidden="true" /></a>
  </Section>
</Base>

<style>
  .path-step {
    position: relative;
  }
  .path-step:not(:last-child)::before {
    content: '';
    position: absolute;
    left: 13.5px;
    top: 34px;
    bottom: 6px;
    width: 1px;
    background: var(--border-strong);
  }
  .path-node {
    position: relative;
    z-index: 1;
    display: flex;
    height: 28px;
    width: 28px;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--border-strong);
    border-radius: 9999px;
    background: var(--background);
    font-size: 13px;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }
</style>
