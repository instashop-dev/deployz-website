---
import { ArrowRight, Building2, RefreshCw, ServerCog } from 'lucide-react';
import CtaSection from '@/components/site/CtaSection.astro';
import DeploymentDiagram from '@/components/site/DeploymentDiagram.astro';
import FaqList from '@/components/site/FaqList.astro';
import ProductPreview from '@/components/site/ProductPreview.astro';
import Section from '@/components/site/Section.astro';
import SectionHeading from '@/components/site/SectionHeading.astro';
import { BASE_PRICE, CTA_LABEL, ENVIRONMENT_PRICE, SIGNUP_URL } from '@/lib/site';
import Base from '../layouts/Base.astro';

const benefits = [
  {
    icon: Building2,
    title: 'Say yes to customer-hosted deals',
    text: 'Offer customer-hosted installs without a custom project for each deal.',
  },
  {
    icon: ServerCog,
    title: 'Skip the infrastructure work',
    text: 'Deployz sets up the network, containers, database, cache, storage, and HTTPS.',
  },
  {
    icon: RefreshCw,
    title: 'Ship updates to every customer',
    text: 'Build a release once. Choose when each customer gets it.',
  },
];

const steps = [
  { title: 'Connect GitHub', text: 'Deployz reads your repository and reports what your app needs.' },
  { title: 'Configure and build a release', text: 'Fill in settings, fix any blockers, and build a versioned release.' },
  { title: 'Your customer connects AWS', text: 'They open your installation link and approve access in their AWS console.' },
  { title: 'Deploy and manage updates', text: 'Deployz deploys the release. You choose when each customer updates.' },
];

const supported = [
  'One Linux x86-64 container image from your Dockerfile',
  'Optional workers from the same image',
  'Optional PostgreSQL 16 or MySQL 8.0',
  'Optional Redis-compatible cache',
  'S3 file storage and HTTPS',
];

const questions = [
  {
    question: 'Do I need DevOps or AWS expertise?',
    answer:
      'No dedicated DevOps team is needed. Deployz finds what your app needs and sets up the supported AWS infrastructure. You still review the configuration and fix issues in your own code.',
  },
  {
    question: 'Does my customer need an AWS account?',
    answer:
      'Yes. Your customer approves the connection in their own AWS account, and AWS bills them for the resources. They do not need a Deployz account.',
  },
  {
    question: 'What does it cost?',
    answer: `Evaluation is free, with no card: analysis, release builds, and one test deployment per application in your own AWS account. After you subscribe, Deployz costs $${BASE_PRICE} a month plus $${ENVIRONMENT_PRICE} a month for each billable customer environment. AWS costs are separate.`,
  },
];
---

<Base
  title="Deployz — Deploy Your SaaS in Customer AWS Accounts"
  description="Deploy your SaaS in your customers' AWS accounts. Connect GitHub, build a release, send an installation link, and manage updates from Deployz."
>
  <!-- H1. Hero -->
  <section aria-labelledby="hero-title" class="pt-16 pb-16 sm:pt-24 sm:pb-20 lg:pt-28 lg:pb-24">
    <div class="container-site">
      <div class="mx-auto max-w-[870px] text-center">
        <h1 id="hero-title" class="text-display">Deploy your SaaS in your customers' AWS accounts.</h1>
        <p class="text-lead mx-auto mt-6 max-w-[680px] text-muted-foreground">
          Connect GitHub. Deployz checks what your app needs, sets up the AWS infrastructure in each
          customer's account, deploys your releases, and manages updates.
        </p>
        <a class="btn btn-primary btn-lg mt-8" href={SIGNUP_URL} data-cta="home-hero">{CTA_LABEL}</a>
        <p class="mt-4 text-[14px] text-muted-foreground">Free evaluation · No credit card required</p>
      </div>
      <div class="mt-12 sm:mt-14 lg:mt-16">
        <DeploymentDiagram />
      </div>
    </div>
  </section>

  <!-- H2. Benefits -->
  <Section divider labelledby="benefits-title">
    <SectionHeading id="benefits-title" title="Customer-hosted deployments without a DevOps project." />
    <ul class="mt-12 grid gap-10 md:grid-cols-3 md:gap-8 lg:mt-14 lg:gap-12">
      {benefits.map((item) => (
        <li>
          <item.icon className="size-5 text-foreground" strokeWidth={1.75} aria-hidden="true" />
          <h3 class="mt-4 text-[18px] leading-snug font-semibold tracking-[-0.01em]">{item.title}</h3>
          <p class="mt-2 text-muted-foreground">{item.text}</p>
        </li>
      ))}
    </ul>
  </Section>

  <!-- H3. How it works -->
  <Section divider labelledby="process-title">
    <SectionHeading id="process-title" title="How it works" />
    <ol class="process mt-12 grid gap-0 lg:mt-14 lg:grid-cols-4 lg:gap-8">
      {steps.map((step, index) => (
        <li class="process-step relative grid grid-cols-[40px_minmax(0,1fr)] gap-4 pb-8 lg:block lg:pb-0">
          <span class="relative z-10 flex size-10 items-center justify-center rounded-full border border-border-strong bg-background text-[14px] font-semibold tabular-nums">{index + 1}</span>
          <div class="lg:mt-6">
            <h3 class="text-[18px] leading-snug font-semibold tracking-[-0.01em]">{step.title}</h3>
            <p class="mt-2 text-muted-foreground">{step.text}</p>
          </div>
        </li>
      ))}
    </ol>
    <div class="mt-4 flex flex-wrap items-center gap-x-7 gap-y-2 lg:mt-12">
      <a class="btn btn-primary" href={SIGNUP_URL} data-cta="home-steps">{CTA_LABEL}</a>
      <a class="link-arrow text-[15px]" href="/how-it-works/">See each step <ArrowRight className="size-4" aria-hidden="true" /></a>
    </div>
  </Section>

  <!-- H4. Product preview -->
  <Section divider labelledby="preview-title">
    <SectionHeading id="preview-title" title="Configure, deploy, and manage in one place." />
    <div class="mt-10 lg:mt-12">
      <ProductPreview />
    </div>
  </Section>

  <!-- H5. Ownership and compatibility -->
  <Section divider labelledby="security-title">
    <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
      <div>
        <h2 id="security-title" class="text-h2 max-w-[520px]">Your app runs in your customer's AWS account.</h2>
        <p class="mt-5 max-w-[520px] text-muted-foreground">
          The app and its data run in the customer's account. Deployz deploys through a connector the
          customer approves, and it does not receive database, cache, or file data.
        </p>
        <a class="link-arrow mt-6" href="/security/">Security and architecture <ArrowRight className="size-4" aria-hidden="true" /></a>
      </div>
      <div>
        <h3 class="text-[16px] font-semibold">Supported today</h3>
        <ul class="mt-4 border-b border-border">
          {supported.map((item) => (
            <li class="flex items-start gap-3 border-t border-border py-3">
              <svg aria-hidden="true" viewBox="0 0 16 16" class="mt-[5px] size-4 shrink-0 text-foreground" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8.5l3 3 7-7" /></svg>
              <span>{item}</span>
            </li>
          ))}
        </ul>
        <a class="link-arrow mt-6" href="/how-it-works/#compatibility">Full compatibility list <ArrowRight className="size-4" aria-hidden="true" /></a>
      </div>
    </div>
  </Section>

  <!-- H6. FAQ -->
  <Section divider labelledby="faq-title">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,4fr)_minmax(0,8fr)] lg:gap-16">
      <h2 id="faq-title" class="text-h2 max-w-[440px]">Questions</h2>
      <FaqList items={questions} class="max-w-[760px]" />
    </div>
  </Section>

  <!-- H7. Final CTA -->
  <CtaSection title="See what your app needs to deploy." cta="home-closing">
    Connect GitHub for a free readiness report.
  </CtaSection>
</Base>

<style>
  /* Process rail: a vertical line on narrow screens, a horizontal line on wide screens. */
  .process-step::before {
    content: '';
    position: absolute;
    left: 20px;
    top: 40px;
    bottom: 0;
    width: 1px;
    background: var(--border);
  }

  .process-step:last-child::before {
    display: none;
  }

  @media (min-width: 1024px) {
    .process-step::before {
      left: 48px;
      right: -24px;
      top: 20px;
      bottom: auto;
      width: auto;
      height: 1px;
    }
  }
</style>
