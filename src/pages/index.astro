---
import { ArrowRight } from 'lucide-react';
import CtaSection from '@/components/site/CtaSection.astro';
import DeploymentDiagram from '@/components/site/DeploymentDiagram.astro';
import FaqList from '@/components/site/FaqList.astro';
import ProductPreview from '@/components/site/ProductPreview.astro';
import Section from '@/components/site/Section.astro';
import SectionHeading from '@/components/site/SectionHeading.astro';
import { CTA_LABEL, SIGNUP_URL } from '@/lib/site';
import Base from '../layouts/Base.astro';

const benefits = [
  {
    title: 'Say yes to more customers',
    text: 'Offer private deployments when customers need your SaaS running in their own AWS account.',
  },
  {
    title: 'Keep building your product',
    text: 'Spend less engineering time on deployment infrastructure and more time shipping features.',
  },
  {
    title: 'Give customers more control',
    text: 'Let customers run your software in their own AWS environment.',
  },
];

const steps = [
  {
    title: 'Connect your app',
    text: 'Connect GitHub. Deployz analyzes your app and identifies what it needs to run.',
  },
  {
    title: 'Review & configure',
    text: 'Review the suggested setup and configure your app for deployment.',
  },
  {
    title: 'Send your customer an installation link',
    text: 'Share an installation link. Your customer authorizes their AWS account, and Deployz deploys your app.',
  },
];

const trustPoints = ['Customer-owned AWS', 'Customer-hosted application data', 'Defined AWS permissions'];

const questions = [
  {
    question: 'Do I need DevOps or AWS expertise?',
    answer:
      "No dedicated DevOps team is required to get started. Deployz helps identify your application's infrastructure needs and handles supported deployment setup. You'll still need to review configuration and resolve any app-specific issues.",
  },
  {
    question: 'Will Deployz work with my SaaS?',
    answer:
      'Deployz currently supports apps that build from a Dockerfile into one container image: a web or API service, with optional background workers that use the same image. It can add PostgreSQL or MySQL, a Redis-compatible cache, and S3 storage in AWS. Connect your GitHub repository to check what your app needs and what may need to change.',
  },
  {
    question: 'Does my customer need an AWS account?',
    answer:
      'Yes. Your customer needs an AWS account and must authorize the required setup. The deployed application and its infrastructure run in their account. They do not need a Deployz account.',
  },
  {
    question: 'Can I update my app after deploying it?',
    answer:
      'Yes. You choose when each customer gets a new release, and you can see deployment status. If a new version fails its health check, the previous version keeps running. You can roll back to an earlier release, but a rollback does not reverse database migrations.',
  },
  {
    question: 'Can I try Deployz before paying?',
    answer:
      'Yes. Application analysis, release builds, and one test deployment of your own app per application are free, with no card required. The test deployment runs in your own AWS account, which pays its AWS costs. Your subscription starts when you start your first customer deployment. See Pricing for details.',
  },
];
---

<Base
  title="Deployz — Deploy Your SaaS Into Customer AWS"
  description="Deploy your SaaS in your customers' AWS accounts. Connect GitHub, configure your app, and manage private deployments with Deployz."
>
  <!-- H1. Hero -->
  <section aria-labelledby="hero-title" class="pt-16 pb-16 sm:pt-24 sm:pb-20 lg:pt-28 lg:pb-24">
    <div class="container-site">
      <div class="mx-auto max-w-[870px] text-center">
        <p class="text-[15px] font-medium text-muted-foreground">The deploy button for your SaaS.</p>
        <h1 id="hero-title" class="text-display mt-5">The easiest way to deploy your SaaS in your customers' AWS accounts.</h1>
        <p class="text-lead mx-auto mt-6 max-w-[650px] text-muted-foreground">
          Connect GitHub, configure your app, and deploy. Deployz takes care of the infrastructure, so you
          don't need a DevOps team.
        </p>
        <a class="btn btn-primary btn-lg mt-8" href={SIGNUP_URL} data-cta="home-hero">{CTA_LABEL}</a>
        <p class="mt-4 text-[14px] text-muted-foreground">Free readiness check · No credit card required</p>
      </div>
      <div class="mt-12 sm:mt-14 lg:mt-16">
        <DeploymentDiagram />
      </div>
    </div>
  </section>

  <!-- H2. The problem -->
  <Section divider labelledby="problem-title">
    <div class="grid gap-6 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-16">
      <h2 id="problem-title" class="text-h2 max-w-[560px]">Your customer wants your SaaS in their AWS. Now what?</h2>
      <p class="text-lead max-w-[640px] text-muted-foreground lg:pt-2">
        You've built the product. But deploying it in your customer's cloud means infrastructure setup,
        technical complexity, and ongoing maintenance. That's a lot for a small SaaS team.
      </p>
    </div>
  </Section>

  <!-- H3. Solution and benefits -->
  <Section divider labelledby="solution-title">
    <SectionHeading id="solution-title" title="You build the SaaS. Deployz handles the deployment.">
      Deployz handles infrastructure setup, deployments, and updates, so your team can focus on building
      your product.
    </SectionHeading>
    <ul class="mt-12 grid gap-10 md:grid-cols-3 md:gap-8 lg:mt-14 lg:gap-12">
      {benefits.map((item) => (
        <li class="border-t border-foreground pt-6">
          <h3 class="text-[18px] leading-snug font-semibold tracking-[-0.01em]">{item.title}</h3>
          <p class="mt-3 text-muted-foreground">{item.text}</p>
        </li>
      ))}
    </ul>
  </Section>

  <!-- H4. How it works -->
  <Section divider labelledby="process-title">
    <SectionHeading id="process-title" title="From your code to your customer's cloud. In 3 steps." />
    <ol class="process mt-12 grid gap-0 lg:mt-14 lg:grid-cols-3 lg:gap-10">
      {steps.map((step, index) => (
        <li class="process-step relative grid grid-cols-[40px_minmax(0,1fr)] gap-4 pb-8 lg:block lg:pb-0">
          <span class="relative z-10 flex size-10 items-center justify-center rounded-full border border-border-strong bg-background text-[14px] font-semibold tabular-nums">{index + 1}</span>
          <div class="lg:mt-6">
            <h3 class="text-[18px] leading-snug font-semibold tracking-[-0.01em]">{step.title}</h3>
            <p class="mt-2 text-muted-foreground">{step.text}</p>
          </div>
        </li>
      ))}
    </ol>
    <p class="mt-4 text-muted-foreground lg:mt-10">Need to make changes later? Manage updates and rollbacks from Deployz.</p>
    <div class="mt-8 flex flex-wrap items-center gap-x-7 gap-y-2">
      <a class="btn btn-primary" href={SIGNUP_URL} data-cta="home-steps">{CTA_LABEL}</a>
      <a class="link-arrow text-[15px]" href="/how-it-works">See how it works <ArrowRight className="size-4" aria-hidden="true" /></a>
    </div>
  </Section>

  <!-- H5. Product preview -->
  <Section divider labelledby="preview-title">
    <SectionHeading id="preview-title" title="One place to manage your customer deployments.">
      From configuring your SaaS to tracking deployments and updates, everything stays organized in
      Deployz.
    </SectionHeading>
    <div class="mt-10 lg:mt-12">
      <ProductPreview />
    </div>
  </Section>

  <!-- H6. Security and FAQ -->
  <Section divider labelledby="security-title">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-16">
      <div>
        <h2 id="security-title" class="text-h2 max-w-[520px]">Your customer's cloud. Their data. Their control.</h2>
        <p class="mt-5 max-w-[520px] text-muted-foreground">
          Your SaaS runs in your customer's own AWS account, with their application infrastructure and
          data under their control. Deployz manages deployments without hosting the application itself.
        </p>
        <ul class="mt-6 border-b border-border">
          {trustPoints.map((item) => (
            <li class="flex items-start gap-3 border-t border-border py-3">
              <svg aria-hidden="true" viewBox="0 0 16 16" class="mt-[5px] size-4 shrink-0 text-foreground" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8.5l3 3 7-7" /></svg>
              <span>{item}</span>
            </li>
          ))}
        </ul>
        <a class="link-arrow mt-6" href="/security">Security &amp; Architecture <ArrowRight className="size-4" aria-hidden="true" /></a>
      </div>
      <div>
        <h3 id="faq-title" class="text-h3">Frequently asked questions</h3>
        <FaqList items={questions} class="mt-6 max-w-[760px]" />
      </div>
    </div>
  </Section>

  <!-- H7. Final CTA -->
  <CtaSection title="Ready to deploy your SaaS into your customer's AWS account?" cta="home-closing">
    Connect your GitHub repository and see how Deployz can help you get started.
  </CtaSection>
</Base>

<style>
  /* Process rail: a vertical line on narrow screens, a horizontal line on wide screens. */
  .process-step::before {
    content: '';
    position: absolute;
    left: 20px;
    top: 40px;
    bottom: 0;
    width: 1px;
    background: var(--border);
  }

  .process-step:last-child::before {
    display: none;
  }

  @media (min-width: 1024px) {
    .process-step::before {
      left: 48px;
      right: -32px;
      top: 20px;
      bottom: auto;
      width: auto;
      height: 1px;
    }
  }
</style>
