---
import { ArrowRight, Check, ClipboardCheck, Minus, Repeat, ShieldCheck } from 'lucide-react';
import { Badge } from '@/components/ui/badge';
import { buttonVariants } from '@/components/ui/button';
import { Card, CardContent, CardDescription, CardFooter, CardHeader, CardTitle } from '@/components/ui/card';
import { cn } from '@/lib/utils';
import Base from '../layouts/Base.astro';

const terminalLines = [
  { text: 'deployz install --customer acme-corp', prompt: true },
  { text: '→ customer AWS account connected', dim: true },
  { text: '✓ repository analyzed · 12 checks passed' },
  { text: '✓ stack provisioned in customer VPC' },
  { text: '✓ application deployed · v2.41.0' },
  { text: 'updates managed by deployz · customer keeps the keys', dim: true },
];

const control = [
  { label: 'You', title: 'Your application', text: 'You select each release.' },
  { label: 'Deployz', title: 'Installation and updates', text: 'Deployz deploys it and reports the status.' },
  { label: 'Your customer', title: 'Their AWS account', text: 'They own the infrastructure and the data.' },
];

const stats = [
  { value: 'A few minutes', label: 'Usual time for the analysis' },
  { value: '20–45 min', label: 'Typical first deployment' },
  { value: '$0', label: 'Until your first customer environment' },
  { value: '0', label: 'AWS credentials held by Deployz' },
];

const report = [
  { check: 'Container configuration', result: 'Dockerfile detected', status: 'Passed', variant: 'outline' },
  { check: 'Health check', result: '/api/health', status: 'Passed', variant: 'outline' },
  { check: 'Database connection', result: 'DATABASE_URL generated by Deployz', status: 'Managed', variant: 'outline' },
  { check: 'Application secret', result: 'STRIPE_SECRET_KEY must be provided', status: 'Configuration required', variant: 'secondary' },
  { check: 'File storage', result: 'Writes detected in /app/uploads', status: 'Action needed', variant: 'default' },
] as const;

const questions = [
  {
    question: 'What happens if Deployz is unavailable?',
    answer: "Your application runs in your customer's AWS account, not in Deployz. A healthy environment continues to serve traffic, and its data stays available. New deployments, updates, and status can be unavailable until Deployz returns.",
  },
  {
    question: 'What must my customer do?',
    answer: 'Open your installation link, review the access, and launch the Deployz connector from their own AWS console. They need an AWS account. They do not need a Deployz account.',
  },
  {
    question: 'How long does it take?',
    answer: 'The analysis usually takes a few minutes. The first deployment typically takes 20 to 45 minutes. The time depends on the AWS resources, the application startup time, and the HTTPS setup.',
  },
  {
    question: "What can Deployz see in my customer's account?",
    answer: 'Deployment status, resource identifiers, and deployment errors. Deployz does not receive database contents, cache contents, stored files, or application logs.',
  },
  {
    question: 'Can my customer see my source code?',
    answer: 'Your customer gets no access to your repository. Their AWS account pulls a container image of each release. A container image is not a source-protection mechanism.',
  },
  {
    question: 'What if my application does not fit?',
    answer: 'The free analysis shows each item that blocks deployment, before you promise anything to your customer.',
  },
];
---

<Base title="Deployz — Deploy Your SaaS in Your Customer's AWS Account">
  <section class="relative pt-2 pb-8 md:pb-10 lg:pt-4 lg:pb-12">
    <div class="pointer-events-none absolute inset-0 -z-10 bg-grid-dots [mask-image:radial-gradient(ellipse_80%_60%_at_50%_0%,black,transparent)]" aria-hidden="true"></div>
    <div class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-80 hero-glow" aria-hidden="true"></div>
    <div class="mx-auto max-w-3xl text-center">
      <p class="reveal inline-flex items-center rounded-full border border-border bg-muted/50 px-3.5 py-1.5 font-mono text-[0.7rem] font-medium tracking-[0.12em] text-muted-foreground uppercase">
        Bring your own cloud (BYOC) for B2B SaaS
      </p>
      <h1 class="reveal mt-6 text-[2.5rem] leading-[1.05] font-semibold tracking-[-0.035em] text-balance sm:text-6xl lg:text-7xl" style="--reveal-delay:60ms">
        Your customer wants your SaaS in their AWS account. Say yes.
      </h1>
      <p class="reveal mx-auto mt-5 max-w-2xl text-lg leading-relaxed text-pretty text-muted-foreground" style="--reveal-delay:120ms">
        Deployz installs and updates your application in each customer's AWS account. You do not
        build a deployment platform.
      </p>
      <div class="reveal mt-8 flex flex-wrap justify-center gap-3" style="--reveal-delay:180ms">
        <a class={cn(buttonVariants({ size: 'lg' }), 'h-auto min-h-11 shrink text-center whitespace-normal')} href="/get-started">Check my application</a>
        <a class={cn(buttonVariants({ size: 'lg', variant: 'outline' }), 'h-auto min-h-11 shrink text-center whitespace-normal')} href="/how-it-works">See how it works</a>
      </div>
      <p class="reveal mt-4 font-mono text-xs tracking-wide text-muted-foreground" style="--reveal-delay:240ms">Free analysis. No card. Read-only GitHub access.</p>
    </div>
    <div class="reveal mx-auto mt-12 max-w-3xl lg:mt-16" style="--reveal-delay:160ms">
      <div class="overflow-hidden rounded-xl bg-surface-inverse shadow-e3 ring-1 ring-foreground/10">
        <div class="flex items-center gap-2 border-b border-surface-inverse-foreground/10 px-4 py-3">
          <span class="size-2.5 rounded-full bg-surface-inverse-foreground/20" aria-hidden="true"></span>
          <span class="size-2.5 rounded-full bg-surface-inverse-foreground/20" aria-hidden="true"></span>
          <span class="size-2.5 rounded-full bg-surface-inverse-foreground/20" aria-hidden="true"></span>
          <p class="ml-2 font-mono text-xs text-surface-inverse-foreground/60">deployz — acme-corp · eu-central-1</p>
          <span class="ml-auto inline-flex items-center gap-1.5 rounded-full border border-surface-inverse-foreground/20 px-2 py-0.5 font-mono text-[0.65rem] tracking-wide text-surface-inverse-foreground/70">
            <span class="size-1.5 animate-pulse rounded-full bg-surface-inverse-foreground/70" aria-hidden="true"></span>
            LIVE
          </span>
        </div>
        <pre class="px-5 py-6 font-mono text-[0.8rem] leading-7 break-words whitespace-pre-wrap sm:text-sm"><code>{terminalLines.map((line) => (
          <span class={line.dim || line.prompt ? '' : 'text-surface-inverse-foreground'}>
            {line.prompt ? <span class="text-surface-inverse-foreground/60">$ </span> : null}
            <span class={line.dim ? 'text-surface-inverse-foreground/60' : ''}>{line.text}</span>{'\n'}
          </span>
        ))}</code></pre>
      </div>
    </div>
    <ol
      aria-label="How control is divided between you, Deployz, and your customer"
      class="reveal mx-auto mt-8 grid max-w-4xl gap-px overflow-hidden rounded-xl border bg-border sm:grid-cols-3 lg:mt-10" style="--reveal-delay:80ms"
    >
      {control.map((item) => (
        <li class="bg-background p-5">
          <p class="font-mono text-[0.7rem] font-medium tracking-[0.14em] text-muted-foreground uppercase">{item.label}</p>
          <p class="mt-2 font-semibold">{item.title}</p>
          <p class="mt-1 text-sm leading-normal text-muted-foreground">{item.text}</p>
        </li>
      ))}
    </ol>
  </section>

  <section aria-label="Deployz in numbers" class="pb-6 md:pb-8 lg:pb-12">
    <dl class="reveal grid grid-cols-2 gap-px overflow-hidden rounded-xl border bg-border lg:grid-cols-4">
      {stats.map((stat) => (
        <div class="flex flex-col-reverse justify-end gap-1.5 bg-background p-5 md:p-6">
          <dt class="text-sm leading-normal text-muted-foreground">{stat.label}</dt>
          <dd class="font-mono text-xl font-medium tracking-tight tabular-nums md:text-2xl">{stat.value}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="py-6 md:py-8 lg:py-12">
    <div class="max-w-2xl">
      <p class="font-mono text-xs font-medium tracking-[0.14em] text-muted-foreground uppercase">The problem</p>
      <h2 class="mt-3 text-2xl font-semibold tracking-tight text-balance sm:text-3xl">Your product is ready. Your deployment model isn't.</h2>
      <p class="mt-3 leading-relaxed">
        "Can your software run in our AWS account?" One question can turn a sale into a platform
        project:
      </p>
    </div>
    <ul class="mt-6 grid gap-x-6 md:mt-8 md:grid-cols-3">
      <li class="border-t py-4 leading-normal">AWS infrastructure for each customer, maintained for years</li>
      <li class="border-t py-4 leading-normal">Onboarding that a security team will approve</li>
      <li class="border-t py-4 leading-normal">Releases, failures, and updates in accounts you cannot see</li>
    </ul>
    <p class="mt-6 max-w-2xl leading-relaxed">Deployz turns that project into a product feature, from $49 a month.</p>
  </section>

  <section class="py-6 md:py-8 lg:py-12">
    <div class="max-w-2xl">
      <p class="font-mono text-xs font-medium tracking-[0.14em] text-muted-foreground uppercase">What you get</p>
      <h2 class="mt-3 max-w-3xl text-2xl font-semibold tracking-tight text-balance sm:text-3xl">Offer private deployment without becoming an infrastructure company</h2>
    </div>
    <ul class="mt-6 grid gap-4 md:mt-8 md:gap-5 lg:grid-cols-3">
      <li class="reveal group rounded-xl border bg-card p-6 shadow-e1 transition-all duration-200 hover:-translate-y-0.5 hover:border-foreground/20 hover:shadow-e2 md:p-8 lg:col-span-2 lg:row-span-2">
        <div class="grid size-11 place-items-center rounded-lg border border-border bg-muted/60">
          <ShieldCheck className="size-5" aria-hidden="true" />
        </div>
        <h3 class="mt-6 text-lg font-semibold">Close the deals that security reviews stop</h3>
        <p class="mt-2 max-w-md leading-normal text-muted-foreground">A guided path for each customer to run your SaaS in their AWS account.</p>
      </li>
      <li class="reveal group rounded-xl border bg-card p-6 shadow-e1 transition-all duration-200 hover:-translate-y-0.5 hover:border-foreground/20 hover:shadow-e2" style="--reveal-delay:60ms">
        <div class="grid size-11 place-items-center rounded-lg border border-border bg-muted/60">
          <ClipboardCheck className="size-5" aria-hidden="true" />
        </div>
        <h3 class="mt-5 text-lg font-semibold">Know the answer before you promise</h3>
        <p class="mt-2 leading-normal text-muted-foreground">The free analysis shows what is ready and what blocks deployment.</p>
      </li>
      <li class="reveal group rounded-xl border bg-card p-6 shadow-e1 transition-all duration-200 hover:-translate-y-0.5 hover:border-foreground/20 hover:shadow-e2" style="--reveal-delay:120ms">
        <div class="grid size-11 place-items-center rounded-lg border border-border bg-muted/60">
          <Repeat className="size-5" aria-hidden="true" />
        </div>
        <h3 class="mt-5 text-lg font-semibold">One workflow for customer 1 and customer 50</h3>
        <p class="mt-2 leading-normal text-muted-foreground">The same isolated environment each time. No new project.</p>
      </li>
    </ul>
  </section>

  <section id="example-report" class="scroll-mt-24 py-6 md:py-8 lg:py-12">
    <div class="max-w-2xl">
      <p class="font-mono text-xs font-medium tracking-[0.14em] text-muted-foreground uppercase">Readiness report</p>
      <h2 class="mt-3 text-2xl font-semibold tracking-tight text-balance sm:text-3xl">See what the analysis tells you</h2>
      <p class="mt-3 leading-relaxed">Connect your repository. A few minutes later, you know what to change. This is an example report.</p>
    </div>
    <Card className="reveal mt-6 shadow-e1 md:mt-8">
      <CardHeader>
        <CardTitle><h3>Example application: Acme Analytics</h3></CardTitle>
        <CardDescription>12 checks · 1 action needed · 1 configuration item required</CardDescription>
      </CardHeader>
      <CardContent>
        <ul class="grid wrap-anywhere">
          {report.map((row) => (
            <li class="grid gap-1 border-t py-3 md:grid-cols-[14rem_1fr_auto] md:items-center md:gap-6">
              <span class="font-medium">{row.check}</span>
              <span class="font-mono text-muted-foreground">{row.result}</span>
              <Badge variant={row.variant} className="h-auto whitespace-normal">{row.status}</Badge>
            </li>
          ))}
          <li class="border-t py-3 text-muted-foreground">+ 7 more checks with no action needed</li>
        </ul>
      </CardContent>
      <CardFooter className="grid gap-2 wrap-anywhere">
        <h4 class="font-semibold">Action needed: file storage</h4>
        <p class="leading-normal text-muted-foreground">
          Your application writes uploads to its local filesystem (src/services/uploads.ts). Local
          files do not always survive a replacement or recovery.
        </p>
        <p class="leading-normal text-muted-foreground">
          Fix: use the object storage that Deployz provides. Deployz can generate the fix
          instructions.
        </p>
      </CardFooter>
    </Card>
    <a class={cn(buttonVariants({ size: 'lg' }), 'mt-8 h-auto min-h-11 shrink text-center whitespace-normal')} href="/get-started">Check my application</a>
  </section>

  <section class="py-6 md:py-8 lg:py-12">
    <div class="max-w-2xl">
      <p class="font-mono text-xs font-medium tracking-[0.14em] text-muted-foreground uppercase">Process</p>
      <h2 class="text-2xl font-semibold tracking-tight text-balance sm:text-3xl">From repository to customer AWS in four steps</h2>
    </div>
    <ol class="mt-6 grid gap-6 sm:grid-cols-2 md:mt-8 lg:grid-cols-4">
      <li class="reveal border-t pt-5">
        <span class="grid size-9 place-items-center rounded-md border bg-muted/50 font-mono text-sm font-medium text-muted-foreground">01</span>
        <h3 class="mt-4 text-lg font-semibold">Connect your repository</h3>
        <p class="mt-2 leading-normal text-muted-foreground">Read-only GitHub access.</p>
      </li>
      <li class="reveal border-t pt-5" style="--reveal-delay:60ms">
        <span class="grid size-9 place-items-center rounded-md border bg-muted/50 font-mono text-sm font-medium text-muted-foreground">02</span>
        <h3 class="mt-4 text-lg font-semibold">Read the readiness report</h3>
        <p class="mt-2 leading-normal text-muted-foreground">Usually ready in a few minutes.</p>
      </li>
      <li class="reveal border-t pt-5" style="--reveal-delay:120ms">
        <span class="grid size-9 place-items-center rounded-md border bg-muted/50 font-mono text-sm font-medium text-muted-foreground">03</span>
        <h3 class="mt-4 text-lg font-semibold">Send your customer one link</h3>
        <p class="mt-2 leading-normal text-muted-foreground">They connect their AWS account. No Deployz account.</p>
      </li>
      <li class="reveal border-t pt-5" style="--reveal-delay:180ms">
        <span class="grid size-9 place-items-center rounded-md border bg-muted/50 font-mono text-sm font-medium text-muted-foreground">04</span>
        <h3 class="mt-4 text-lg font-semibold">Deploy, then ship updates</h3>
        <p class="mt-2 leading-normal text-muted-foreground">First deployment: typically 20 to 45 minutes.</p>
      </li>
    </ol>
    <a class={cn(buttonVariants({ variant: 'link' }), 'mt-6 h-auto min-h-11 shrink px-0 text-left whitespace-normal')} href="/how-it-works">See the complete workflow <ArrowRight className="size-4" /></a>
  </section>

  <section class="py-6 md:py-8 lg:py-12">
    <div class="max-w-2xl">
      <p class="font-mono text-xs font-medium tracking-[0.14em] text-muted-foreground uppercase">FAQ</p>
      <h2 class="text-2xl font-semibold tracking-tight text-balance sm:text-3xl">The questions you and your customer will ask</h2>
    </div>
    <div class="mt-6 max-w-3xl border-b md:mt-8">
      {questions.map((item) => (
        <details class="border-t">
          <summary class="-mx-3 flex cursor-pointer list-none items-center justify-between gap-4 rounded-lg px-3 py-3.5 font-semibold transition-colors hover:bg-muted/60 [&::-webkit-details-marker]:hidden after:shrink-0 after:text-lg after:leading-none after:text-muted-foreground after:transition-transform after:duration-150 after:content-['+'] open:after:rotate-45 focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-ring/50">{item.question}</summary>
          <p class="pb-4 leading-normal text-muted-foreground">{item.answer}</p>
        </details>
      ))}
    </div>
    <a class={cn(buttonVariants({ variant: 'link' }), 'mt-6 h-auto min-h-11 shrink px-0 text-left whitespace-normal')} href="/security">Review security and architecture <ArrowRight className="size-4" /></a>
  </section>

  <section class="py-6 md:py-8 lg:py-12">
    <div class="reveal rounded-2xl border bg-muted/50 p-6 md:p-10">
      <h2 class="max-w-3xl text-2xl font-semibold tracking-tight text-balance sm:text-3xl">Built for one type of application, deliberately</h2>
      <div class="mt-6 grid gap-8 md:mt-8 md:grid-cols-2">
        <div>
          <h3 class="text-lg font-semibold">Good fit</h3>
          <ul class="mt-4 grid gap-2.5">
            <li class="flex items-start gap-2.5"><Check className="mt-0.5 size-4 shrink-0" aria-hidden="true" /><span>B2B SaaS with a customer that requires AWS</span></li>
            <li class="flex items-start gap-2.5"><Check className="mt-0.5 size-4 shrink-0" aria-hidden="true" /><span>One web or API container</span></li>
            <li class="flex items-start gap-2.5"><Check className="mt-0.5 size-4 shrink-0" aria-hidden="true" /><span>PostgreSQL, a Redis-compatible cache, object storage</span></li>
            <li class="flex items-start gap-2.5"><Check className="mt-0.5 size-4 shrink-0" aria-hidden="true" /><span>No Kubernetes</span></li>
          </ul>
        </div>
        <div>
          <h3 class="text-lg font-semibold">Not a fit today</h3>
          <ul class="mt-4 grid gap-2.5">
            <li class="flex items-start gap-2.5"><Minus className="mt-0.5 size-4 shrink-0" aria-hidden="true" /><span>Azure, Google Cloud, or on-premises</span></li>
            <li class="flex items-start gap-2.5"><Minus className="mt-0.5 size-4 shrink-0" aria-hidden="true" /><span>More than one service, workers, or scheduled jobs</span></li>
            <li class="flex items-start gap-2.5"><Minus className="mt-0.5 size-4 shrink-0" aria-hidden="true" /><span>MySQL, MongoDB, Kafka, or GPU workloads</span></li>
            <li class="flex items-start gap-2.5"><Minus className="mt-0.5 size-4 shrink-0" aria-hidden="true" /><span>An existing customer VPC</span></li>
          </ul>
        </div>
      </div>
      <a class={cn(buttonVariants({ variant: 'link' }), 'mt-6 h-auto min-h-11 shrink px-0 text-left whitespace-normal')} href="/docs#supported-architecture">View supported architecture <ArrowRight className="size-4" /></a>
    </div>
  </section>

  <section class="py-6 md:py-8 lg:py-12">
    <div class="max-w-2xl">
      <p class="font-mono text-xs font-medium tracking-[0.14em] text-muted-foreground uppercase">The team</p>
      <h2 class="mt-3 text-2xl font-semibold tracking-tight text-balance sm:text-3xl">Built by a team that operates SaaS products</h2>
      <p class="mt-3 leading-relaxed">
        Tejas Sangoi and the bootstrapped team at Thalia Technologies build Deployz. The same team
        has operated CSVBox, Spreadr, and other SaaS products in production for years.
      </p>
    </div>
  </section>

  <section class="py-6 md:py-8 lg:py-12">
    <div class="reveal relative overflow-hidden rounded-2xl bg-surface-inverse p-8 text-surface-inverse-foreground shadow-e3 md:p-14">
      <div class="pointer-events-none absolute inset-0 bg-grid-dots-inverse opacity-40 [mask-image:radial-gradient(70%_70%_at_50%_0%,black,transparent)]" aria-hidden="true"></div>
      <div class="relative flex flex-col items-start justify-between gap-6 md:flex-row md:items-center">
        <div class="max-w-2xl">
          <h2 class="text-2xl font-semibold tracking-tight text-balance sm:text-3xl">Don't let a deployment requirement block the deal</h2>
          <p class="mt-3 leading-relaxed text-surface-inverse-foreground/70">Find out in a few minutes if your application is ready. The analysis is free, and no card is necessary.</p>
        </div>
        <a class="inline-flex h-auto min-h-11 shrink-0 items-center justify-center rounded-lg bg-surface-inverse-foreground px-5 text-center text-sm font-medium whitespace-normal text-surface-inverse shadow-sm transition-all outline-none select-none hover:-translate-y-px hover:shadow-md focus-visible:ring-3 focus-visible:ring-surface-inverse-foreground/40 active:translate-y-0" href="/get-started">Check my application</a>
      </div>
    </div>
  </section>
</Base>
