---
import { ArrowDown, ArrowRight, ClipboardCheck, Repeat, ShieldCheck } from 'lucide-react';
import { Badge } from '@/components/ui/badge';
import { buttonVariants } from '@/components/ui/button';
import { Card, CardContent, CardDescription, CardFooter, CardHeader, CardTitle } from '@/components/ui/card';
import { cn } from '@/lib/utils';
import Base from '../layouts/Base.astro';

const stats = [
  { value: 'A few minutes', label: 'Usual time for the analysis' },
  { value: '20–45 min', label: 'Typical first deployment' },
  { value: '$0', label: 'Until your first customer environment' },
  { value: '0', label: 'AWS credentials held by Deployz' },
];

const report = [
  { check: 'Container configuration', result: 'Dockerfile detected', status: 'Passed', variant: 'outline' },
  { check: 'Health check', result: '/api/health', status: 'Passed', variant: 'outline' },
  { check: 'Database connection', result: 'DATABASE_URL generated by Deployz', status: 'Managed', variant: 'outline' },
  { check: 'Application secret', result: 'STRIPE_SECRET_KEY must be provided', status: 'Configuration required', variant: 'secondary' },
  { check: 'File storage', result: 'Writes detected in /app/uploads', status: 'Action needed', variant: 'default' },
] as const;

const questions = [
  {
    question: 'What happens if Deployz is unavailable?',
    answer: "Your application runs in your customer's AWS account, not in Deployz. A healthy environment continues to serve traffic, and its data stays available. New deployments, updates, and status can be unavailable until Deployz returns.",
  },
  {
    question: 'What must my customer do?',
    answer: 'Open your installation link, review the access, and launch the Deployz connector from their own AWS console. They need an AWS account. They do not need a Deployz account.',
  },
  {
    question: 'How long does it take?',
    answer: 'The analysis usually takes a few minutes. The first deployment typically takes 20 to 45 minutes. The time depends on the AWS resources, the application startup time, and the HTTPS setup.',
  },
  {
    question: "What can Deployz see in my customer's account?",
    answer: 'Deployment status, resource identifiers, and deployment errors. Deployz does not receive database contents, cache contents, stored files, or application logs.',
  },
  {
    question: 'Can my customer see my source code?',
    answer: 'Your customer gets no access to your repository. Their AWS account pulls a container image of each release. A container image is not a source-protection mechanism.',
  },
  {
    question: 'What if my application does not fit?',
    answer: 'The free analysis shows each item that blocks deployment, before you promise anything to your customer.',
  },
];
---

<Base title="Deployz — Deploy Your SaaS in Your Customer's AWS Account">
  <section class="grid gap-10 pt-6 pb-4 md:pt-10 md:pb-6 lg:grid-cols-[1fr_22rem] lg:items-center lg:gap-8 lg:pt-16 lg:pb-8">
    <div class="max-w-3xl">
      <Badge variant="outline" className="h-auto whitespace-normal">Bring your own cloud (BYOC) for B2B SaaS</Badge>
      <h1 class="mt-4 text-4xl leading-tight font-semibold tracking-tight text-balance sm:text-5xl">
        Your customer wants your SaaS in their AWS account. Say yes.
      </h1>
      <p class="mt-4 max-w-2xl text-lg text-pretty">
        Deployz installs and updates your application in each customer's AWS account. You do not
        build a deployment platform.
      </p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a class={cn(buttonVariants({ size: 'lg' }), 'h-auto min-h-11 shrink text-center whitespace-normal')} href="/get-started">Check my application</a>
        <a class={cn(buttonVariants({ size: 'lg', variant: 'outline' }), 'h-auto min-h-11 shrink text-center whitespace-normal')} href="/how-it-works">See how it works</a>
      </div>
      <p class="mt-4 text-sm leading-normal text-muted-foreground">Free analysis. No card. Read-only GitHub access.</p>
    </div>
    <ol
      aria-label="How control is divided between you, Deployz, and your customer"
      class="grid gap-3 md:grid-cols-[1fr_auto_1fr_auto_1fr] md:items-stretch lg:grid-cols-1"
    >
      <li class="rounded-xl border p-5">
        <svg aria-hidden="true" class="mb-4 h-16 w-full" viewBox="0 0 240 64" preserveAspectRatio="xMinYMid meet" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <rect x="1" y="5" width="92" height="54" rx="6" class="fill-background stroke-foreground" />
          <path d="M1 17h92" class="stroke-foreground" />
          <path d="M9 11h.01M15 11h.01M21 11h.01" class="stroke-foreground" stroke-width="3" />
          <path d="M10 27h34M18 35h44M18 43h32M10 51h24" class="stroke-muted-foreground" />
          <path d="M101 32h22" class="stroke-muted-foreground" stroke-dasharray="3 4" />
          <path d="M121 28l4 4-4 4" class="stroke-muted-foreground" />
          <rect x="133" y="19" width="70" height="26" rx="13" class="fill-muted stroke-foreground" />
          <circle cx="147" cy="32" r="3" class="stroke-foreground" />
          <path d="M157 32h34" class="stroke-foreground" />
        </svg>
        <p class="text-xs font-medium tracking-wide">You</p>
        <p class="mt-2 font-semibold">Your application</p>
        <p class="mt-1 text-sm leading-normal text-muted-foreground">You select each release.</p>
      </li>
      <li aria-hidden="true" class="flex items-center justify-center text-muted-foreground">
        <ArrowDown className="size-5 md:hidden lg:block" />
        <ArrowRight className="hidden size-5 md:block lg:hidden" />
      </li>
      <li class="rounded-xl border p-5">
        <svg aria-hidden="true" class="mb-4 h-16 w-full" viewBox="0 0 240 64" preserveAspectRatio="xMinYMid meet" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M33 32h38M97 32h38" class="stroke-foreground" />
          <path d="M161 32h38" class="stroke-muted-foreground" stroke-dasharray="3 4" />
          <circle cx="20" cy="32" r="12" class="fill-foreground stroke-foreground" />
          <path d="M15 32l3.5 3.5 7-7" class="stroke-background" />
          <circle cx="84" cy="32" r="12" class="fill-foreground stroke-foreground" />
          <path d="M79 32l3.5 3.5 7-7" class="stroke-background" />
          <circle cx="148" cy="32" r="12" class="fill-background stroke-border" />
          <path d="M148 20a12 12 0 0 1 12 12" class="stroke-foreground" />
          <circle cx="212" cy="32" r="12" class="stroke-muted-foreground" stroke-dasharray="3 4" />
        </svg>
        <p class="text-xs font-medium tracking-wide">Deployz</p>
        <p class="mt-2 font-semibold">Installation and updates</p>
        <p class="mt-1 text-sm leading-normal text-muted-foreground">Deployz deploys it and reports the status.</p>
      </li>
      <li aria-hidden="true" class="flex items-center justify-center text-muted-foreground">
        <ArrowDown className="size-5 md:hidden lg:block" />
        <ArrowRight className="hidden size-5 md:block lg:hidden" />
      </li>
      <li class="rounded-xl border p-5">
        <svg aria-hidden="true" class="mb-4 h-16 w-full" viewBox="0 0 240 64" preserveAspectRatio="xMinYMid meet" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <rect x="1" y="1" width="238" height="62" rx="10" class="fill-muted stroke-muted-foreground" stroke-dasharray="4 4" />
          <rect x="20" y="18" width="28" height="28" rx="5" class="fill-background stroke-foreground" />
          <path d="M27 27h14M27 32h14M27 37h8" class="stroke-muted-foreground" />
          <path d="M76 22v20c0 2.8 6.3 5 14 5s14-2.2 14-5V22" class="fill-background stroke-foreground" />
          <ellipse cx="90" cy="22" rx="14" ry="5" class="fill-background stroke-foreground" />
          <path d="M76 32c0 2.8 6.3 5 14 5s14-2.2 14-5" class="stroke-foreground" />
          <rect x="134" y="19" width="32" height="7" rx="3.5" class="fill-background stroke-foreground" />
          <rect x="134" y="29" width="32" height="7" rx="3.5" class="fill-background stroke-foreground" />
          <rect x="134" y="39" width="32" height="7" rx="3.5" class="fill-background stroke-foreground" />
          <path d="M192 20h28l-4 26h-20z" class="fill-background stroke-foreground" />
          <path d="M193.5 30h25" class="stroke-foreground" />
        </svg>
        <p class="text-xs font-medium tracking-wide">Your customer</p>
        <p class="mt-2 font-semibold">Their AWS account</p>
        <p class="mt-1 text-sm leading-normal text-muted-foreground">They own the infrastructure and the data.</p>
      </li>
    </ol>
  </section>

  <section aria-label="Deployz in numbers" class="pt-4 pb-6 md:pt-6 md:pb-8 lg:pt-8 lg:pb-12">
    <dl class="grid gap-6 rounded-xl bg-muted p-6 sm:grid-cols-2 md:p-8 lg:grid-cols-4">
      {stats.map((stat) => (
        <div class="flex flex-col-reverse justify-end gap-1">
          <dt class="text-sm leading-normal">{stat.label}</dt>
          <dd class="text-3xl font-semibold tracking-tight">{stat.value}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="py-6 md:py-8 lg:py-12">
    <div class="max-w-2xl">
      <h2 class="text-2xl font-semibold tracking-tight text-balance sm:text-3xl">Your product is ready. Your deployment model isn't.</h2>
      <p class="mt-3 leading-relaxed">
        "Can your software run in our AWS account?" One question can turn a sale into a platform
        project:
      </p>
    </div>
    <ul class="mt-6 grid gap-x-6 md:mt-8 md:grid-cols-3">
      <li class="border-t py-4 leading-normal">AWS infrastructure for each customer, maintained for years</li>
      <li class="border-t py-4 leading-normal">Onboarding that a security team will approve</li>
      <li class="border-t py-4 leading-normal">Releases, failures, and updates in accounts you cannot see</li>
    </ul>
    <p class="mt-6 max-w-2xl leading-relaxed">Deployz turns that project into a product feature, from $49 a month.</p>
  </section>

  <section class="py-6 md:py-8 lg:py-12">
    <h2 class="max-w-3xl text-2xl font-semibold tracking-tight text-balance sm:text-3xl">Offer private deployment without becoming an infrastructure company</h2>
    <ul class="mt-6 grid gap-6 md:mt-8 md:grid-cols-3">
      <li class="border-t pt-5">
        <ShieldCheck className="size-6" />
        <h3 class="mt-3 text-lg font-semibold">Close the deals that security reviews stop</h3>
        <p class="mt-2 leading-normal text-muted-foreground">A guided path for each customer to run your SaaS in their AWS account.</p>
      </li>
      <li class="border-t pt-5">
        <ClipboardCheck className="size-6" />
        <h3 class="mt-3 text-lg font-semibold">Know the answer before you promise</h3>
        <p class="mt-2 leading-normal text-muted-foreground">The free analysis shows what is ready and what blocks deployment.</p>
      </li>
      <li class="border-t pt-5">
        <Repeat className="size-6" />
        <h3 class="mt-3 text-lg font-semibold">One workflow for customer 1 and customer 50</h3>
        <p class="mt-2 leading-normal text-muted-foreground">The same isolated environment each time. No new project.</p>
      </li>
    </ul>
  </section>

  <section id="example-report" class="scroll-mt-8 py-6 md:py-8 lg:py-12">
    <div class="max-w-2xl">
      <h2 class="text-2xl font-semibold tracking-tight text-balance sm:text-3xl">See what the analysis tells you</h2>
      <p class="mt-3 leading-relaxed">Connect your repository. A few minutes later, you know what to change. This is an example report.</p>
    </div>
    <Card className="mt-6 md:mt-8">
      <CardHeader>
        <CardTitle><h3>Example application: Acme Analytics</h3></CardTitle>
        <CardDescription>12 checks · 1 action needed · 1 configuration item required</CardDescription>
      </CardHeader>
      <CardContent>
        <ul class="grid wrap-anywhere">
          {report.map((row) => (
            <li class="grid gap-1 border-t py-3 md:grid-cols-[14rem_1fr_auto] md:items-center md:gap-6">
              <span class="font-medium">{row.check}</span>
              <span class="font-mono text-muted-foreground">{row.result}</span>
              <Badge variant={row.variant} className="h-auto whitespace-normal">{row.status}</Badge>
            </li>
          ))}
          <li class="border-t py-3 text-muted-foreground">+ 7 more checks with no action needed</li>
        </ul>
      </CardContent>
      <CardFooter className="grid gap-2 wrap-anywhere">
        <h4 class="font-semibold">Action needed: file storage</h4>
        <p class="leading-normal text-muted-foreground">
          Your application writes uploads to its local filesystem (src/services/uploads.ts). Local
          files do not always survive a replacement or recovery.
        </p>
        <p class="leading-normal text-muted-foreground">
          Fix: use the object storage that Deployz provides. Deployz can generate the fix
          instructions.
        </p>
      </CardFooter>
    </Card>
    <a class={cn(buttonVariants({ size: 'lg' }), 'mt-8 h-auto min-h-11 shrink text-center whitespace-normal')} href="/get-started">Check my application</a>
  </section>

  <section class="py-6 md:py-8 lg:py-12">
    <h2 class="text-2xl font-semibold tracking-tight text-balance sm:text-3xl">From repository to customer AWS in four steps</h2>
    <ol class="mt-6 grid gap-6 sm:grid-cols-2 md:mt-8 lg:grid-cols-4">
      <li class="border-t pt-5">
        <span class="font-mono text-sm text-muted-foreground">01</span>
        <h3 class="mt-3 text-lg font-semibold">Connect your repository</h3>
        <p class="mt-2 leading-normal text-muted-foreground">Read-only GitHub access.</p>
      </li>
      <li class="border-t pt-5">
        <span class="font-mono text-sm text-muted-foreground">02</span>
        <h3 class="mt-3 text-lg font-semibold">Read the readiness report</h3>
        <p class="mt-2 leading-normal text-muted-foreground">Usually ready in a few minutes.</p>
      </li>
      <li class="border-t pt-5">
        <span class="font-mono text-sm text-muted-foreground">03</span>
        <h3 class="mt-3 text-lg font-semibold">Send your customer one link</h3>
        <p class="mt-2 leading-normal text-muted-foreground">They connect their AWS account. No Deployz account.</p>
      </li>
      <li class="border-t pt-5">
        <span class="font-mono text-sm text-muted-foreground">04</span>
        <h3 class="mt-3 text-lg font-semibold">Deploy, then ship updates</h3>
        <p class="mt-2 leading-normal text-muted-foreground">First deployment: typically 20 to 45 minutes.</p>
      </li>
    </ol>
    <a class={cn(buttonVariants({ variant: 'link' }), 'mt-6 h-auto min-h-11 shrink px-0 text-left whitespace-normal')} href="/how-it-works">See the complete workflow <ArrowRight className="size-4" /></a>
  </section>

  <section class="py-6 md:py-8 lg:py-12">
    <h2 class="text-2xl font-semibold tracking-tight text-balance sm:text-3xl">The questions you and your customer will ask</h2>
    <div class="mt-6 max-w-3xl border-b md:mt-8">
      {questions.map((item) => (
        <details class="border-t">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-3 font-semibold [&::-webkit-details-marker]:hidden after:shrink-0 after:text-lg after:leading-none after:text-muted-foreground after:transition-transform after:duration-150 after:content-['+'] open:after:rotate-45 focus-visible:rounded-lg focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-ring/50">{item.question}</summary>
          <p class="pb-4 leading-normal text-muted-foreground">{item.answer}</p>
        </details>
      ))}
    </div>
    <a class={cn(buttonVariants({ variant: 'link' }), 'mt-6 h-auto min-h-11 shrink px-0 text-left whitespace-normal')} href="/security">Review security and architecture <ArrowRight className="size-4" /></a>
  </section>

  <section class="py-6 md:py-8 lg:py-12">
    <div class="rounded-xl bg-muted p-6 md:p-10">
      <h2 class="max-w-3xl text-2xl font-semibold tracking-tight text-balance sm:text-3xl">Built for one type of application, deliberately</h2>
      <div class="mt-6 grid gap-8 md:mt-8 md:grid-cols-2">
        <div>
          <h3 class="text-lg font-semibold">Good fit</h3>
          <ul class="mt-4 grid list-disc gap-2 pl-5">
            <li>B2B SaaS with a customer that requires AWS</li>
            <li>One web or API container</li>
            <li>PostgreSQL, a Redis-compatible cache, object storage</li>
            <li>No Kubernetes</li>
          </ul>
        </div>
        <div>
          <h3 class="text-lg font-semibold">Not a fit today</h3>
          <ul class="mt-4 grid list-disc gap-2 pl-5">
            <li>Azure, Google Cloud, or on-premises</li>
            <li>More than one service, workers, or scheduled jobs</li>
            <li>MySQL, MongoDB, Kafka, or GPU workloads</li>
            <li>An existing customer VPC</li>
          </ul>
        </div>
      </div>
      <a class={cn(buttonVariants({ variant: 'link' }), 'mt-6 h-auto min-h-11 shrink px-0 text-left whitespace-normal')} href="/docs#supported-architecture">View supported architecture <ArrowRight className="size-4" /></a>
    </div>
  </section>

  <section class="py-6 md:py-8 lg:py-12">
    <div class="max-w-2xl">
      <h2 class="text-2xl font-semibold tracking-tight text-balance sm:text-3xl">Built by a team that operates SaaS products</h2>
      <p class="mt-3 leading-relaxed">
        Tejas Sangoi and the bootstrapped team at Thalia Technologies build Deployz. The same team
        has operated CSVBox, Spreadr, and other SaaS products in production for years.
      </p>
    </div>
  </section>

  <section class="py-6 md:py-8 lg:py-12">
    <div class="flex flex-col items-start justify-between gap-6 border-y py-10 md:flex-row md:items-center">
      <div class="max-w-2xl">
        <h2 class="text-2xl font-semibold tracking-tight text-balance sm:text-3xl">Don't let a deployment requirement block the deal</h2>
        <p class="mt-3 leading-relaxed">Find out in a few minutes if your application is ready. The analysis is free, and no card is necessary.</p>
      </div>
      <a class={cn(buttonVariants({ size: 'lg' }), 'h-auto min-h-11 shrink-0 text-center whitespace-normal')} href="/get-started">Check my application</a>
    </div>
  </section>
</Base>
