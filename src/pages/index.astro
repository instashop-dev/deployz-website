---
import { ArrowRight } from 'lucide-react';
import CtaSection from '@/components/site/CtaSection.astro';
import DeploymentDiagram from '@/components/site/DeploymentDiagram.astro';
import FaqList from '@/components/site/FaqList.astro';
import ProductPreview from '@/components/site/ProductPreview.astro';
import Section from '@/components/site/Section.astro';
import SectionHeading from '@/components/site/SectionHeading.astro';
import { CTA_LABEL, SIGNUP_URL } from '@/lib/site';
import Base from '../layouts/Base.astro';

const benefits = [
  {
    title: 'Say yes to customer-hosted deals',
    text: 'Offer customer-hosted installs without a custom project for each deal.',
  },
  {
    title: 'Skip the infrastructure work',
    text: 'Deployz sets up the network, containers, database, cache, storage, and HTTPS.',
  },
  {
    title: 'Ship updates to every customer',
    text: 'Build a release once. Choose when each customer gets it.',
  },
];

const steps = [
  { title: 'Connect GitHub', text: 'Deployz reads your repository and reports what your app needs.' },
  { title: 'Configure and build a release', text: 'Fill in settings, fix any blockers, and build a versioned release.' },
  { title: 'Your customer connects AWS', text: 'They open your installation link and approve access in their AWS console.' },
  { title: 'Deploy and manage updates', text: 'Deployz deploys the release. You choose when each customer updates.' },
];

const owners = [
  {
    owner: 'Your customer',
    title: 'Owns the AWS account',
    text: 'Approves the connector, pays AWS directly, and administers the account. The database, cache, and files stay there.',
  },
  {
    owner: 'You',
    title: 'Own the application',
    text: 'Your code, configuration, and integrations. You decide when each customer gets a new release.',
  },
  {
    owner: 'Deployz',
    title: 'Runs the deployments',
    text: 'Sets up the supported infrastructure, deploys releases, and handles updates, rollbacks, and status.',
  },
];

const questions = [
  {
    question: 'Does AI decide what gets deployed?',
    answer:
      "No. AI helps read your repository when Deployz's own checks leave a question open, and the report labels those values as inferred by AI. The infrastructure comes from Deployz's rule-based compiler, which can create only supported AWS resources. AI does not guarantee that your app is correct or secure.",
  },
  {
    question: 'Do I need DevOps or AWS expertise?',
    answer:
      'No dedicated DevOps team is needed. Deployz finds what your app needs and sets up the supported AWS infrastructure. You still review the configuration and fix issues in your own code.',
  },
  {
    question: 'Does my customer need an AWS account?',
    answer:
      'Yes. Your customer approves the connection in their own AWS account, and AWS bills them for the resources. They do not need a Deployz account.',
  },
  {
    question: 'What happens if Deployz is unavailable?',
    answer:
      "The application keeps running in the customer's account, because its requests do not pass through the Deployz management service. New installations and updates pause. Traffic to the default deployz.dev URL depends on the Deployz proxy; with a custom domain, traffic goes directly to the customer's load balancer.",
  },
];
---

<Base
  title="Deployz — Deploy Your SaaS Into Customer AWS"
  description="Deploy your SaaS into your customers' AWS accounts. Connect GitHub, review what Deployz detects, send an installation link, and manage updates."
>
  <!-- H1. Hero -->
  <section aria-labelledby="hero-title" class="pt-14 pb-16 sm:pt-20 sm:pb-20 lg:pt-24 lg:pb-24">
    <div class="container-site">
      <div class="mx-auto max-w-[870px] text-center">
        <p class="inline-flex min-h-8 items-center rounded-full border border-brand-border bg-brand-subtle px-3.5 text-[14px] font-medium text-brand-hover">For B2B SaaS Teams</p>
        <h1 id="hero-title" class="text-display mt-5">Deploy into customer AWS</h1>
        <p class="text-lead mx-auto mt-6 max-w-[640px] text-muted-foreground">
          Run your SaaS in each customer's own AWS account. Connect GitHub, and Deployz checks what your app
          needs, sets up the infrastructure, and deploys the releases you choose.
        </p>
        <div class="mt-8 flex flex-col items-stretch justify-center gap-3 min-[420px]:flex-row min-[420px]:items-center">
          <a class="btn btn-primary btn-lg" href={SIGNUP_URL} data-cta="home-hero">{CTA_LABEL}</a>
          <a class="btn btn-secondary btn-lg" href="/how-it-works/">See how it works</a>
        </div>
        <p class="mt-4 text-[14px] text-muted-foreground">Free evaluation · No credit card required</p>
      </div>
      <div class="mt-12 sm:mt-14 lg:mt-16">
        <DeploymentDiagram />
      </div>
    </div>
  </section>

  <!-- H2. Benefits -->
  <Section labelledby="benefits-title">
    <SectionHeading id="benefits-title" title="Customer-hosted deployments without a DevOps project." />
    <ul class="mt-12 grid gap-10 md:grid-cols-3 md:gap-8 lg:mt-14 lg:gap-12">
      {benefits.map((item) => (
        <li class="border-t border-foreground pt-5">
          <h3 class="text-[18px] leading-snug font-semibold tracking-[-0.01em]">{item.title}</h3>
          <p class="mt-2 text-muted-foreground">{item.text}</p>
        </li>
      ))}
    </ul>
  </Section>

  <!-- H3. How it works -->
  <Section labelledby="process-title">
    <SectionHeading id="process-title" title="How it works" />
    <ol class="process mt-12 grid gap-0 lg:mt-14 lg:grid-cols-4 lg:gap-8">
      {steps.map((step, index) => (
        <li class="process-step relative grid grid-cols-[40px_minmax(0,1fr)] gap-4 pb-8 lg:block lg:pb-0">
          <span class="relative z-10 flex size-10 items-center justify-center rounded-full border border-border-strong bg-background text-[14px] font-semibold tabular-nums">{index + 1}</span>
          <div class="lg:mt-6">
            <h3 class="text-[18px] leading-snug font-semibold tracking-[-0.01em]">{step.title}</h3>
            <p class="mt-2 text-muted-foreground">{step.text}</p>
          </div>
        </li>
      ))}
    </ol>
    <div class="mt-4 flex flex-wrap items-center gap-x-7 gap-y-2 lg:mt-12">
      <a class="btn btn-primary" href={SIGNUP_URL} data-cta="home-steps">{CTA_LABEL}</a>
      <a class="link-arrow text-[15px]" href="/how-it-works/">See each step <ArrowRight className="size-4" aria-hidden="true" /></a>
    </div>
  </Section>

  <!-- H4. Product preview -->
  <Section labelledby="preview-title">
    <SectionHeading id="preview-title" title="Configure, deploy, and manage in one place." />
    <div class="mt-10 lg:mt-12">
      <ProductPreview />
    </div>
  </Section>

  <!-- H5. Ownership -->
  <Section labelledby="ownership-title">
    <SectionHeading id="ownership-title" title="Your customer owns the account. You own the app. Deployz runs the deployments." />
    <ul class="mt-12 grid gap-10 md:grid-cols-3 md:gap-8 lg:mt-14 lg:gap-12">
      {owners.map((item, index) => (
        <li class:list={['border-t pt-5', index === 2 ? 'border-brand' : 'border-foreground']}>
          <p class="text-[14px] text-subtle">{item.owner}</p>
          <h3 class="mt-1 text-[18px] leading-snug font-semibold tracking-[-0.01em]">{item.title}</h3>
          <p class="mt-2 text-muted-foreground">{item.text}</p>
        </li>
      ))}
    </ul>
    <p class="mt-10 max-w-[720px] text-muted-foreground">
      Deployz works through a connector that the customer launches in their AWS console. It does not receive
      database data, cache contents, S3 data, or application logs.
    </p>
    <a class="link-arrow mt-4" href="/security/">Security and architecture <ArrowRight className="size-4" aria-hidden="true" /></a>
  </Section>

  <!-- H6. FAQ -->
  <Section labelledby="faq-title">
    <div class="grid grid-cols-[minmax(0,1fr)] gap-10 lg:grid-cols-[minmax(0,4fr)_minmax(0,8fr)] lg:gap-16">
      <h2 id="faq-title" class="text-h2 max-w-[440px]">Questions</h2>
      <FaqList items={questions} class="max-w-[760px]" />
    </div>
  </Section>

  <!-- H7. Final CTA -->
  <CtaSection title="See what your app needs to deploy." cta="home-closing">
    Connect GitHub for a free readiness report.
  </CtaSection>
</Base>

<style>
  /* Process rail: a vertical line on narrow screens, a horizontal line on wide screens. */
  .process-step::before {
    content: '';
    position: absolute;
    left: 20px;
    top: 40px;
    bottom: 0;
    width: 1px;
    background: var(--border);
  }

  .process-step:last-child::before {
    display: none;
  }

  @media (min-width: 1024px) {
    .process-step::before {
      left: 48px;
      right: -24px;
      top: 20px;
      bottom: auto;
      width: auto;
      height: 1px;
    }
  }
</style>
