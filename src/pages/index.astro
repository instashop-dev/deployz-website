---
import Base from '../layouts/Base.astro';
---

<Base title="Deployz — Ship your product into every customer's AWS account">
  <section>
    <h1>Ship your product into every customer's AWS&nbsp;account</h1>
    <p>
      Connect your application once. Deployz provisions, updates, monitors, and manages a
      private deployment in each customer's account — with no DevOps team.
    </p>
    <div style="display: flex; gap: 0.75rem; flex-wrap: wrap; margin-top: 1.5rem;">
      <a class="button" href="/docs">Get started</a>
      <a class="button ghost" href="#how-it-works">How it works</a>
    </div>
  </section>

  <section id="how-it-works">
    <h2>How it works</h2>
    <ol>
      <li><strong>Connect.</strong> Define your application deployment once.</li>
      <li><strong>Share.</strong> Give each customer a "Deploy to Your AWS" link.</li>
      <li><strong>Operate.</strong> Deployz provisions, upgrades, monitors, and diagnoses every deployment.</li>
    </ol>
  </section>

  <section>
    <h2>Why Deployz</h2>
    <div class="grid">
      <div class="card">
        <h3>Customer-owned, vendor-managed</h3>
        <p>Your product runs in the customer's own AWS account. You keep control of the full lifecycle.</p>
      </div>
      <div class="card">
        <h3>The full deployment layer</h3>
        <p>Infrastructure, IAM, networking, upgrades, rollbacks, monitoring, and troubleshooting — as a service.</p>
      </div>
      <div class="card">
        <h3>One architecture, done well</h3>
        <p>Deployz supports one opinionated architecture. Applications that fit get near zero-DevOps installs.</p>
      </div>
      <div class="card">
        <h3>Small team, many deployments</h3>
        <p>Track and operate every customer deployment from one place, without a platform team.</p>
      </div>
    </div>
  </section>
</Base>
