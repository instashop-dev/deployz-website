---
import { ArrowRight } from 'lucide-react';
import DeploymentDiagram from '@/components/site/DeploymentDiagram.astro';
import FaqList from '@/components/site/FaqList.astro';
import Section from '@/components/site/Section.astro';
import SectionHeading from '@/components/site/SectionHeading.astro';
import Base from '../layouts/Base.astro';

const problems = [
  'AWS infrastructure for each customer, maintained for years',
  'Onboarding that a security team will approve',
  'Releases, failures, and updates in accounts you cannot see',
];

const outcomes = [
  {
    title: 'Close the deals that security reviews stop',
    text: 'A guided path for each customer to run your SaaS in their AWS account.',
  },
  {
    title: 'Know the answer before you promise',
    text: 'The free analysis shows what is ready and what blocks deployment.',
  },
  {
    title: 'One workflow for customer 1 and customer 50',
    text: 'The same isolated environment each time. No new project.',
  },
];

const steps = [
  { title: 'Connect your repository', text: 'Read-only GitHub access.' },
  { title: 'Read the readiness report', text: 'Usually ready in a few minutes.' },
  { title: 'Send your customer one link', text: 'They connect their AWS account. No Deployz account.' },
  { title: 'Deploy, then ship updates', text: 'First deployment: typically 20 to 45 minutes.' },
];

const stats = [
  { value: 'A few minutes', label: 'Usual time for the analysis' },
  { value: '20–45 min', label: 'Typical first deployment' },
  { value: '$0', label: 'Until your first customer environment' },
  { value: '0', label: 'AWS credentials held by Deployz' },
];

const report = [
  { check: 'Container configuration', result: 'Dockerfile detected', status: 'Passed', tone: 'neutral' },
  { check: 'Health check', result: '/api/health', status: 'Passed', tone: 'neutral' },
  { check: 'Database connection', result: 'DATABASE_URL generated by Deployz', status: 'Managed', tone: 'neutral' },
  { check: 'Application secret', result: 'STRIPE_SECRET_KEY must be provided', status: 'Configuration required', tone: 'attention' },
  { check: 'File storage', result: 'Writes detected in /app/uploads', status: 'Action needed', tone: 'action' },
] as const;

const goodFit = [
  'B2B SaaS with a customer that requires AWS',
  'One web or API container',
  'PostgreSQL, a Redis-compatible cache, object storage',
  'No Kubernetes',
];

const notFit = [
  'Azure, Google Cloud, or on-premises',
  'More than one service, workers, or scheduled jobs',
  'MySQL, MongoDB, Kafka, or GPU workloads',
  'An existing customer VPC',
];

const questions = [
  {
    question: 'What happens if Deployz is unavailable?',
    answer: "Your application runs in your customer's AWS account, not in Deployz. A healthy environment continues to serve traffic, and its data stays available. New deployments, updates, and status can be unavailable until Deployz returns.",
  },
  {
    question: 'What must my customer do?',
    answer: 'Open your installation link, review the access, and launch the Deployz connector from their own AWS console. They need an AWS account. They do not need a Deployz account.',
  },
  {
    question: 'How long does it take?',
    answer: 'The analysis usually takes a few minutes. The first deployment typically takes 20 to 45 minutes. The time depends on the AWS resources, the application startup time, and the HTTPS setup.',
  },
  {
    question: "What can Deployz see in my customer's account?",
    answer: 'Deployment status, resource identifiers, and deployment errors. Deployz does not receive database contents, cache contents, stored files, or application logs.',
  },
  {
    question: 'Can my customer see my source code?',
    answer: 'Your customer gets no access to your repository. Their AWS account pulls a container image of each release. A container image is not a source-protection mechanism.',
  },
  {
    question: 'What if my application does not fit?',
    answer: 'The free analysis shows each item that blocks deployment, before you promise anything to your customer.',
  },
];
---

<Base title="Deployz — Deploy Your SaaS in Your Customer's AWS Account">
  <!-- 1. Hero -->
  <section aria-labelledby="hero-title" class="pt-16 pb-16 sm:pt-24 sm:pb-20 lg:pt-28 lg:pb-28">
    <div class="container-site">
      <div class="mx-auto max-w-[870px] text-center">
        <p class="text-[14px] font-medium text-muted-foreground">Bring your own cloud (BYOC) for B2B SaaS</p>
        <h1 id="hero-title" class="text-display mt-5">Your customer wants your SaaS in their AWS account. Say yes.</h1>
        <p class="text-lead mx-auto mt-6 max-w-[650px] text-muted-foreground">
          Deployz installs and updates your application in each customer's AWS account. You do not
          build a deployment platform.
        </p>
        <div class="mt-8 flex flex-col items-center justify-center gap-x-7 gap-y-2 sm:flex-row">
          <a class="btn btn-primary btn-lg" href="/get-started">Check my application</a>
          <a class="link-arrow text-[15px]" href="/how-it-works">See how it works <ArrowRight className="size-4" aria-hidden="true" /></a>
        </div>
        <p class="mt-4 text-[14px] text-muted-foreground">Free analysis. No card. Read-only GitHub access.</p>
      </div>
      <div class="mt-10 sm:mt-14 lg:mt-16">
        <DeploymentDiagram />
      </div>
    </div>
  </section>

  <!-- 2. Problem -->
  <Section divider labelledby="problem-title">
    <div class="grid gap-10 xl:grid-cols-[minmax(0,4fr)_minmax(0,8fr)] xl:gap-16">
      <div>
        <p class="text-eyebrow mb-3 text-muted-foreground">The problem</p>
        <h2 id="problem-title" class="text-h2 max-w-[640px]">Your product is ready. Your deployment model isn't.</h2>
      </div>
      <div class="max-w-[720px] xl:pt-8">
        <p class="text-lead">
          "Can your software run in our AWS account?" One question can turn a sale into a platform
          project:
        </p>
        <ol class="mt-8 border-b border-border">
          {problems.map((item, index) => (
            <li class="grid grid-cols-[32px_minmax(0,1fr)] gap-3 border-t border-border py-4">
              <span class="text-[14px] font-medium text-subtle tabular-nums">{String(index + 1).padStart(2, '0')}</span>
              <span>{item}</span>
            </li>
          ))}
        </ol>
        <p class="mt-8 font-medium">Deployz turns that project into a product feature, from $49 a month.</p>
      </div>
    </div>
  </Section>

  <!-- 3. Solution -->
  <Section tone="subtle" labelledby="solution-title">
    <SectionHeading id="solution-title" eyebrow="What you get" title="Offer private deployment without becoming an infrastructure company" />
    <ul class="mt-12 grid gap-10 md:grid-cols-3 md:gap-8 lg:mt-14 lg:gap-12">
      {outcomes.map((item) => (
        <li class="border-t border-foreground pt-6">
          <h3 class="text-[18px] leading-snug font-semibold tracking-[-0.01em]">{item.title}</h3>
          <p class="mt-3 text-muted-foreground">{item.text}</p>
        </li>
      ))}
    </ul>
  </Section>

  <!-- 4. How it works -->
  <Section labelledby="process-title">
    <SectionHeading id="process-title" eyebrow="Process" title="From repository to customer AWS in four steps" />
    <ol class="process mt-12 grid gap-0 lg:mt-14 lg:grid-cols-4 lg:gap-8">
      {steps.map((step, index) => (
        <li class="process-step relative grid grid-cols-[40px_minmax(0,1fr)] gap-4 pb-8 lg:block lg:pb-0">
          <span class="relative z-10 flex size-10 items-center justify-center rounded-full border border-border-strong bg-background text-[14px] font-semibold tabular-nums">{index + 1}</span>
          <div class="lg:mt-6">
            <h3 class="text-[18px] leading-snug font-semibold tracking-[-0.01em]">{step.title}</h3>
            <p class="mt-2 text-muted-foreground">{step.text}</p>
          </div>
        </li>
      ))}
    </ol>
    <a class="link-arrow mt-4 lg:mt-10" href="/how-it-works">See the complete workflow <ArrowRight className="size-4" aria-hidden="true" /></a>

    <div id="example-report" class="mt-16 grid gap-10 border-t border-border pt-16 lg:mt-24 lg:grid-cols-[minmax(0,4fr)_minmax(0,8fr)] lg:gap-16 lg:pt-24">
      <div>
        <p class="text-eyebrow mb-3 text-muted-foreground">Readiness report</p>
        <h2 class="text-h2">See what the analysis tells you</h2>
        <p class="mt-4 text-muted-foreground">Connect your repository. A few minutes later, you know what to change. This is an example report.</p>
        <a class="btn btn-primary mt-8" href="/get-started">Check my application</a>
      </div>
      <div class="min-w-0 overflow-hidden rounded-xl border border-border-strong bg-background">
        <div class="border-b border-border px-5 py-4 sm:px-6">
          <h3 class="text-[16px] leading-snug font-semibold">Example application: Acme Analytics</h3>
          <p class="mt-1 text-[14px] text-muted-foreground">12 checks · 1 action needed · 1 configuration item required</p>
        </div>
        <ul class="wrap-anywhere">
          {report.map((row) => (
            <li class="grid gap-1 border-b border-border px-5 py-3.5 sm:px-6 md:grid-cols-[13rem_minmax(0,1fr)_auto] md:items-center md:gap-6">
              <span class="text-[14px] font-medium">{row.check}</span>
              <span class="font-mono text-[13px] text-muted-foreground">{row.result}</span>
              <span
                class:list={[
                  'justify-self-start text-[13px] font-medium md:justify-self-end',
                  row.tone === 'neutral' && 'text-muted-foreground',
                  row.tone === 'attention' && 'text-foreground',
                  row.tone === 'action' && 'text-warning',
                ]}
              >
                {row.status}
              </span>
            </li>
          ))}
          <li class="border-b border-border px-5 py-3.5 text-[14px] text-muted-foreground sm:px-6">+ 7 more checks with no action needed</li>
        </ul>
        <div class="grid gap-2 bg-surface-subtle px-5 py-5 wrap-anywhere sm:px-6">
          <h4 class="text-[15px] font-semibold">Action needed: file storage</h4>
          <p class="text-[14px] text-muted-foreground">
            Your application writes uploads to its local filesystem (src/services/uploads.ts). Local
            files do not always survive a replacement or recovery.
          </p>
          <p class="text-[14px] text-muted-foreground">
            Fix: use the object storage that Deployz provides. Deployz can generate the fix
            instructions.
          </p>
        </div>
      </div>
    </div>
  </Section>

  <!-- 5. Benefits in numbers -->
  <Section label="Deployz in numbers" class="!pt-0">
    <dl class="grid grid-cols-1 min-[420px]:grid-cols-2 lg:grid-cols-4">
      {stats.map((stat) => (
        <div class="flex flex-col-reverse justify-end gap-2 border-t border-border py-6 min-[420px]:pr-6 lg:border-t-0 lg:border-l lg:py-2 lg:pr-6 lg:pl-8 lg:first:border-l-0 lg:first:pl-0">
          <dt class="text-[14px] text-muted-foreground">{stat.label}</dt>
          <dd class="text-[32px] leading-tight font-semibold tracking-[-0.03em] tabular-nums lg:text-[36px]">{stat.value}</dd>
        </div>
      ))}
    </dl>
  </Section>

  <!-- Scope -->
  <Section divider labelledby="fit-title">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,4fr)_minmax(0,8fr)] lg:gap-16">
      <div>
        <h2 id="fit-title" class="text-h2 max-w-[640px]">Built for one type of application, deliberately</h2>
        <a class="link-arrow mt-6" href="/docs#supported-architecture">View supported architecture <ArrowRight className="size-4" aria-hidden="true" /></a>
      </div>
      <div class="grid gap-10 sm:grid-cols-2 sm:gap-8">
        <div>
          <h3 class="text-[16px] font-semibold">Good fit</h3>
          <ul class="mt-4 border-b border-border">
            {goodFit.map((item) => (
              <li class="flex items-start gap-3 border-t border-border py-3">
                <svg aria-hidden="true" viewBox="0 0 16 16" class="mt-[5px] size-4 shrink-0 text-foreground" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8.5l3 3 7-7" /></svg>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
        <div>
          <h3 class="text-[16px] font-semibold">Not a fit today</h3>
          <ul class="mt-4 border-b border-border">
            {notFit.map((item) => (
              <li class="flex items-start gap-3 border-t border-border py-3 text-muted-foreground">
                <svg aria-hidden="true" viewBox="0 0 16 16" class="mt-[5px] size-4 shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M3.5 8h9" /></svg>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </Section>

  <!-- Team -->
  <Section labelledby="team-title">
    <div class="mx-auto max-w-[720px] text-center">
      <p class="text-eyebrow mb-3 text-muted-foreground">The team</p>
      <h2 id="team-title" class="text-h2">Built by a team that operates SaaS products</h2>
      <p class="text-lead mt-5 text-muted-foreground">
        Tejas Sangoi and the bootstrapped team at Thalia Technologies build Deployz. The same team
        has operated CSVBox, Spreadr, and other SaaS products in production for years.
      </p>
    </div>
  </Section>

  <!-- 6. FAQ -->
  <Section divider labelledby="faq-title">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,4fr)_minmax(0,8fr)] lg:gap-16">
      <div>
        <p class="text-eyebrow mb-3 text-muted-foreground">FAQ</p>
        <h2 id="faq-title" class="text-h2 max-w-[440px]">The questions you and your customer will ask</h2>
        <a class="link-arrow mt-6" href="/security">Review security and architecture <ArrowRight className="size-4" aria-hidden="true" /></a>
      </div>
      <FaqList items={questions} class="max-w-[760px]" />
    </div>
  </Section>

  <!-- 7. Closing CTA -->
  <section aria-labelledby="cta-title" class="border-t border-border">
    <div class="container-site py-20 text-center sm:py-24 lg:py-32">
      <h2 id="cta-title" class="text-h2 mx-auto max-w-[760px] [text-wrap:pretty]">Don't let a deployment requirement block the deal</h2>
      <p class="text-lead mx-auto mt-5 max-w-[560px] text-muted-foreground">Find out in a few minutes if your application is ready. The analysis is free, and no card is necessary.</p>
      <a class="btn btn-primary btn-lg mt-8" href="/get-started">Check my application</a>
    </div>
  </section>
</Base>

<style>
  /* Process rail: a vertical line on narrow screens, a horizontal line on wide screens. */
  .process-step::before {
    content: '';
    position: absolute;
    left: 20px;
    top: 40px;
    bottom: 0;
    width: 1px;
    background: var(--border);
  }

  .process-step:last-child::before {
    display: none;
  }

  @media (min-width: 1024px) {
    .process-step::before {
      left: 48px;
      right: -24px;
      top: 20px;
      bottom: auto;
      width: auto;
      height: 1px;
    }
  }
</style>
