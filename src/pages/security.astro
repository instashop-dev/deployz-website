---
import CtaSection from '@/components/site/CtaSection.astro';
import FaqList from '@/components/site/FaqList.astro';
import PageHeader from '@/components/site/PageHeader.astro';
import RelayDiagram from '@/components/site/diagram/RelayDiagram.astro';
import Section from '@/components/site/Section.astro';
import SectionHeading from '@/components/site/SectionHeading.astro';
import Base from '../layouts/Base.astro';

const permissions = [
  'Create a dedicated network (VPC), load balancer, and security groups',
  'Run the application on Amazon ECS',
  'Create the database, cache, and S3 bucket your app needs',
  'Create IAM roles for the application and AWS services',
  'Read and write secrets tagged for the installation',
];

const limits = [
  'The customer can review every requested IAM action before connecting.',
  'Most write actions are limited to resources tagged for the installation. The connector role has a permissions boundary; the CloudFormation role that creates app resources does not.',
  'The connector cannot read application logs.',
];

const responsibilities = [
  { owner: 'Deployz', text: 'Supported infrastructure, deployments, updates, rollbacks, and status.' },
  { owner: 'The SaaS vendor', text: 'Application code, configuration, data handling, and integrations.' },
  { owner: 'The AWS account owner', text: 'AWS account administration, billing, access, and governance.' },
];

const receives = [
  'Installation ID, AWS account ID, and Region',
  'Connector, release, and image versions',
  'Deployment state, health, and timestamps',
  'Resource IDs and AWS error messages',
  'Health-check status code and response time',
];

const doesNotReceive = ['Database data', 'Cache contents', 'S3 data', 'Application logs', 'In-memory app data'];

const notes = [
  {
    title: 'Secrets',
    text: "Held encrypted until the customer's account connects, then delivered to AWS Secrets Manager there. Values you set for every customer stay encrypted in Deployz.",
  },
  {
    title: 'Code and AI',
    text: 'Repository access is read-only. Release images are built in Deployz’s AWS account. AI may read redacted repository excerpts, but it never creates infrastructure.',
  },
  {
    title: 'Network routing',
    text: "Traffic to the default deployz.dev URL passes through the Deployz proxy on Cloudflare. A custom domain goes directly to the customer's load balancer.",
  },
];

const securityQuestions = [
  {
    question: 'Is Deployz SOC 2 certified?',
    answer:
      'No. Deployz has not completed its own SOC 2 audit. A Deployz SOC 2 Type II examination is planned. Provider reports cover only the providers’ own controls.',
  },
  {
    question: 'Does AI have access to customer AWS accounts?',
    answer: "No. Every change in a customer account goes through the customer's connector.",
  },
];

const lifecycle = [
  {
    question: 'Updates and rollbacks',
    answer:
      'You start each update; nothing updates automatically. If a new version fails, the previous one keeps running. Rollbacks do not reverse database migrations.',
  },
  {
    question: 'Removal and retained data',
    answer:
      'Removal deletes the app and most infrastructure but keeps the database, its credentials, and the S3 bucket, which still cost AWS charges. Deleting them is a separate, confirmed step.',
  },
  {
    question: 'Removing the connector',
    answer:
      'The customer deletes the connector stack to end Deployz access. Remove the deployment first; afterward Deployz cannot change the app.',
  },
  {
    question: 'If Deployz is unavailable',
    answer:
      'The app keeps running, and installs and updates pause. New app tasks pull images from the Deployz registry. The default deployz.dev URL needs the Deployz proxy; a custom domain does not.',
  },
];
---

<Base
  title="Deployz Security & Architecture — Customer AWS"
  description="Where Deployz-managed apps run, what the connector can do in customer AWS, what data Deployz receives, provider SOC 2 coverage, and what happens on update and removal."
>
  <!-- S1. Hero and what runs where -->
  <PageHeader eyebrow="Security & Architecture" title="Your app runs in your customer's AWS account.">
    Deployz coordinates deployments from outside the account, through a connector the customer approves.
    The connector calls out to Deployz; Deployz never connects in.
    <RelayDiagram slot="visual" />
  </PageHeader>

  <!-- S2. Access and responsibilities -->
  <Section id="aws-access" labelledby="access-title">
    <div class="grid grid-cols-[minmax(0,1fr)] gap-10 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-16">
      <div>
        <h2 id="access-title" class="text-h2">Your customer approves AWS access.</h2>
        <ul class="mt-6 grid max-w-[520px] list-disc gap-3 pl-5 text-[15px] text-muted-foreground marker:text-subtle">
          {limits.map((item) => <li>{item}</li>)}
        </ul>
      </div>
      <div class="min-w-0">
        <h3 class="text-[16px] font-semibold">The connector can:</h3>
        <ul class="mt-4 border-b border-border">
          {permissions.map((item) => <li class="border-t border-border py-3 text-muted-foreground">{item}</li>)}
        </ul>
      </div>
    </div>

    <h3 class="mt-16 text-[18px] font-semibold tracking-[-0.01em]">Who is responsible for what</h3>
    <dl class="mt-4 border-b border-border">
      {responsibilities.map((row) => (
        <div class="grid gap-1 border-t border-border py-4 sm:grid-cols-[220px_minmax(0,1fr)] sm:gap-x-8">
          <dt class="font-semibold">{row.owner}</dt>
          <dd class="text-muted-foreground">{row.text}</dd>
        </div>
      ))}
    </dl>
    <p class="mt-4 text-[15px] text-muted-foreground">Hosting in customer AWS does not by itself make an app compliant or secure.</p>
  </Section>

  <!-- S3. Data -->
  <Section divider labelledby="data-title">
    <SectionHeading id="data-title" title="What Deployz receives" />

    <div class="mt-10 grid border-t border-border-strong md:grid-cols-2 lg:mt-12">
      <div class="py-8 md:border-r md:border-border md:pr-10">
        <h3 class="text-[18px] font-semibold tracking-[-0.01em]">Deployz receives</h3>
        <ul class="mt-5 grid">
          {receives.map((item) => (
            <li class="border-t border-border py-3 text-[15px] leading-[1.5] first:border-t-0 first:pt-0">{item}</li>
          ))}
        </ul>
      </div>
      <div class="border-t border-border py-8 md:border-t-0 md:pl-10">
        <h3 class="text-[18px] font-semibold tracking-[-0.01em]">Deployz does not receive</h3>
        <ul class="mt-5 grid">
          {doesNotReceive.map((item) => (
            <li class="border-t border-border py-3 text-[15px] leading-[1.5] first:border-t-0 first:pt-0">{item}</li>
          ))}
        </ul>
      </div>
    </div>

    <div class="grid gap-x-12 gap-y-8 border-t border-border pt-8 md:grid-cols-3">
      {notes.map((note) => (
        <div>
          <h3 class="text-[16px] font-semibold">{note.title}</h3>
          <p class="mt-2 text-[15px] leading-[1.65] text-muted-foreground">{note.text}</p>
        </div>
      ))}
    </div>
  </Section>

  <!-- S4. Audited infrastructure -->
  <Section divider id="assurance" labelledby="assurance-title">
    <div class="grid grid-cols-[minmax(0,1fr)] gap-10 lg:grid-cols-[minmax(0,4fr)_minmax(0,8fr)] lg:gap-16">
      <h2 id="assurance-title" class="text-h2 max-w-[440px] wrap-break-word">Built on audited infrastructure</h2>
      <div class="min-w-0">
        <p class="text-muted-foreground">
          The Deployz API, database, builds, and image registry run on AWS services covered by the AWS SOC 2
          Type II report. DNS and the default-URL proxy run on Cloudflare services covered by its SOC 2 Type II
          report.
        </p>
        <FaqList items={securityQuestions} class="mt-8" />
      </div>
    </div>
  </Section>

  <!-- S5. After deployment -->
  <Section divider labelledby="lifecycle-title">
    <div class="grid grid-cols-[minmax(0,1fr)] gap-10 lg:grid-cols-[minmax(0,4fr)_minmax(0,8fr)] lg:gap-16">
      <h2 id="lifecycle-title" class="text-h2 max-w-[440px]">After deployment</h2>
      <FaqList items={lifecycle} class="max-w-[760px]" />
    </div>

    <p class="mt-16 max-w-[720px] border-t border-border pt-8 text-muted-foreground">
      Deployz is built by Thalia Technologies, the team behind CSVBox, Spreadr, and other SaaS products.
    </p>
  </Section>

  <!-- S6. Final CTA -->
  <CtaSection title="Check what your app needs before you promise a customer." cta="security-closing">
    Connect GitHub for a free readiness report.
  </CtaSection>
</Base>
