---
import { ArrowRight } from 'lucide-react';
import CtaSection from '@/components/site/CtaSection.astro';
import FaqList from '@/components/site/FaqList.astro';
import PageHeader from '@/components/site/PageHeader.astro';
import Section from '@/components/site/Section.astro';
import SectionHeading from '@/components/site/SectionHeading.astro';
import Base from '../layouts/Base.astro';

const deployzSide = [
  'Application and deployment configuration',
  'Deployment instructions and status',
  'Release management',
];

const customerSide = [
  'Running SaaS application',
  'Supported compute, database, storage, and network resources',
  'Customer-side deployment relay (the Deployz connector)',
];

const permissions = [
  'Create and manage a dedicated network (VPC), load balancer, and security groups',
  'Run the application on Amazon ECS',
  'Create the database, cache, and S3 bucket that your app needs',
  'Create IAM roles (AWS permission settings) that the application and AWS services use',
  'Write and read secrets tagged for the installation in AWS Secrets Manager',
];

const accessFacts = [
  { title: 'Customer owns the AWS account', text: 'The customer launches the connector as a CloudFormation stack from their own AWS console. Deployz never asks for AWS access keys.' },
  { title: 'AWS policies define integration permissions', text: 'Most write actions are limited to resources tagged for the installation, and the connector role has a permissions boundary (a limit on what the role can ever do). The CloudFormation role that creates application resources can create IAM roles and has no permissions boundary.' },
  { title: 'Authorization is required before deployment', text: 'Before connecting, the customer can review every IAM action that the connector requests. The connector has no permission to read application logs.' },
];

const responsibilities = [
  { title: 'Deployz handles', text: 'Supported infrastructure provisioning, deployment orchestration, update and rollback actions, and deployment status.' },
  { title: 'The SaaS vendor handles', text: 'Application code, application-specific configuration, remediation of issues in its own code, data-handling choices, and integrations.' },
  { title: 'The AWS account owner handles', text: 'AWS account administration, billing, and the access and governance controls of their environment.' },
];

const receives = [
  'Installation ID, AWS account ID, and AWS Region',
  'Connector version, and the release and image version that runs',
  'Deployment state, infrastructure status, health state, and timestamps',
  'Resource identifiers',
  'AWS error messages: stack events, stopped-task reasons, and exit codes',
  'Health-check status code and response time (not the response body)',
];

const doesNotReceive = [
  'The application runtime and its in-memory data',
  'Database data',
  'Cache contents',
  'S3 data',
  'Application CloudWatch logs',
];

const lifecycle = [
  {
    question: 'Updates and rollbacks',
    answer:
      'The SaaS vendor starts each update; deployments do not update automatically. If a migration or a new version fails, the previous version continues to run. Database migrations are not automatically reversed, and a rollback to an earlier release does not undo customer data changes.',
  },
  {
    question: 'Removal and retained data',
    answer:
      'Removing a deployment deletes the application, cache, load balancer, and most networking. It keeps the database (with deletion protection and automated backups), its credentials, the S3 bucket, and the network parts that the database uses. Retained resources can continue to cause AWS charges.',
  },
  {
    question: 'Data purge',
    answer:
      'Deleting retained data is a separate step that the vendor confirms. It permanently deletes the database, the bucket, and the secrets, with no final snapshot.',
  },
  {
    question: 'Connector removal',
    answer:
      'The customer deletes the connector stack in their AWS console. This ends Deployz access. Remove the deployment and its retained data first: after the connector is deleted, Deployz cannot change or remove the application.',
  },
  {
    question: 'If Deployz is unavailable',
    answer:
      "The application runs in the customer's AWS account and does not send its requests through the Deployz management service. While Deployz is unavailable, new installations, updates, status refreshes, and recovery actions pause. Traffic to the default deployz.dev URL depends on the Deployz DNS proxy, and new application tasks pull the release image from the Deployz registry. A custom domain routes directly to the customer's load balancer.",
  },
];
---

<Base
  title="Deployz Security & Architecture — Customer AWS"
  description="Learn where Deployz-managed applications run, how customer AWS access works, and what happens to resources and data."
>
  <!-- S1. Hero -->
  <PageHeader eyebrow="Security & Architecture" title="Your customer's infrastructure stays in their AWS account.">
    Deployz coordinates deployments while your SaaS runs in customer-owned AWS infrastructure. Here's how
    account access, application resources, and deployment management are separated.
  </PageHeader>

  <!-- S2. What runs where -->
  <Section labelledby="where-title">
    <SectionHeading id="where-title" title="Your application runs in their cloud.">
      The customer AWS account hosts the deployed application and supported infrastructure, such as
      application services, databases, and storage. Deployz operates a separate management service to
      configure and coordinate deployments.
    </SectionHeading>
    <div class="mt-10 grid gap-10 md:grid-cols-2 md:gap-12 lg:mt-12">
      <div class="border-t border-foreground pt-5">
        <h3 class="text-[18px] font-semibold tracking-[-0.01em]">Deployz management service</h3>
        <ul class="mt-4 grid gap-2 text-muted-foreground">
          {deployzSide.map((item) => <li>{item}</li>)}
        </ul>
      </div>
      <div class="border-t border-foreground pt-5">
        <h3 class="text-[18px] font-semibold tracking-[-0.01em]">Customer AWS</h3>
        <ul class="mt-4 grid gap-2 text-muted-foreground">
          {customerSide.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </div>
    <p class="mt-10 max-w-[780px] text-[15px] text-muted-foreground">
      Customer-hosted application data does not mean Deployz handles no operational information. Deployz
      processes deployment configuration, release images, and the status information listed below.
    </p>
  </Section>

  <!-- S3. Connecting the AWS account -->
  <Section divider labelledby="access-title">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-16">
      <div>
        <h2 id="access-title" class="text-h2">Your customer approves AWS access.</h2>
        <p class="mt-5 max-w-[520px] text-muted-foreground">
          Your customer starts the connector from their own AWS console. Its AWS roles and permissions
          govern deployment operations. The management service coordinates with the connector instead of
          using the customer's personal AWS login.
        </p>
        <a class="link-arrow mt-6" href="/docs/#aws-access">View AWS permissions and setup <ArrowRight className="size-4" aria-hidden="true" /></a>
      </div>
      <div class="min-w-0">
        <h3 class="text-[16px] font-semibold">The connector can create significant resources. In plain language, it can:</h3>
        <ul class="mt-4 border-b border-border">
          {permissions.map((item) => <li class="border-t border-border py-3 text-muted-foreground">{item}</li>)}
        </ul>
      </div>
    </div>
    <ul class="mt-12 grid gap-x-10 md:grid-cols-3">
      {accessFacts.map((fact) => (
        <li class="border-t border-border py-6">
          <h3 class="text-[16px] font-semibold tracking-[-0.01em]">{fact.title}</h3>
          <p class="mt-2 text-[15px] leading-[1.6] text-muted-foreground">{fact.text}</p>
        </li>
      ))}
    </ul>
  </Section>

  <!-- S4. Customer-side relay -->
  <Section divider labelledby="relay-title">
    <SectionHeading id="relay-title" title="A deployment connection initiated from customer AWS.">
      Deployz uses a relay in the customer's AWS account to request deployment instructions through
      outbound communication. The relay carries out supported deployment operations within the permissions
      granted to it.
    </SectionHeading>

    <figure class="schematic mt-10 lg:mt-12">
      <div class="sch-grid">
        <div class="boundary">
          <p class="boundary-label">Customer's AWS account</p>
          <ul class="resources">
            <li class="res res-app">Application</li>
            <li class="res">Database</li>
            <li class="res">Cache</li>
            <li class="res">S3 storage</li>
          </ul>
          <p class="connector-node">Deployz relay (connector), launched by the customer</p>
          <p class="boundary-note">Application data and logs stay here.</p>
        </div>

        <div class="lanes">
          <div class="lane lane-out">
            <p class="lane-label lane-label-out">Relay starts every request</p>
            <span class="rail rail-out" aria-hidden="true"></span>
          </div>
          <div class="lane lane-in">
            <span class="rail rail-in" aria-hidden="true"></span>
            <p class="lane-label">No inbound connections</p>
          </div>
        </div>

        <div class="dz">
          <p class="dz-name">
            <img src="/deployz-icon-master.svg" alt="" width="18" height="18" class="size-[18px]" />
            Deployz management service
          </p>
          <ul class="dz-rows">
            <li>Returns deployment instructions</li>
            <li>Receives status and errors</li>
            <li>Never asks for AWS access keys</li>
          </ul>
        </div>
      </div>
      <figcaption class="mt-6 max-w-[780px] text-[15px] text-muted-foreground">
        The relay checks in over outbound HTTPS about every minute. This describes the deployment-control
        connection, not every network interaction of the running app or AWS services.
      </figcaption>
    </figure>
  </Section>

  <!-- S5. Responsibilities and data -->
  <Section divider labelledby="owners-title">
    <SectionHeading id="owners-title" title="Clear ownership. Clear responsibilities." />
    <ul class="mt-10 grid gap-10 md:grid-cols-3 md:gap-8 lg:mt-12 lg:gap-12">
      {responsibilities.map((item) => (
        <li class="border-t border-foreground pt-5">
          <h3 class="text-[18px] font-semibold tracking-[-0.01em]">{item.title}</h3>
          <p class="mt-2 text-muted-foreground">{item.text}</p>
        </li>
      ))}
    </ul>
    <p class="mt-8 max-w-[780px] text-[15px] text-muted-foreground">
      Responsibilities may overlap. Hosting in customer AWS alone does not confer compliance or guarantee
      application security.
    </p>

    <div class="mt-14 grid border-t border-border-strong md:grid-cols-2">
      <div class="py-8 md:border-r md:border-border md:pr-10">
        <h3 class="text-[18px] font-semibold tracking-[-0.01em]">Operational metadata Deployz receives</h3>
        <ul class="mt-5 grid">
          {receives.map((item) => (
            <li class="border-t border-border py-3 text-[15px] leading-[1.5] first:border-t-0 first:pt-0">{item}</li>
          ))}
        </ul>
      </div>
      <div class="border-t border-border py-8 md:border-t-0 md:pl-10">
        <h3 class="text-[18px] font-semibold tracking-[-0.01em]">What Deployz does not receive</h3>
        <ul class="mt-5 grid">
          {doesNotReceive.map((item) => (
            <li class="border-t border-border py-3 text-[15px] leading-[1.5] first:border-t-0 first:pt-0">{item}</li>
          ))}
        </ul>
        <p class="mt-4 text-[15px] text-muted-foreground">Deployz does not automatically copy raw application logs outside the customer's AWS account.</p>
      </div>
    </div>

    <div class="grid gap-x-12 gap-y-8 border-t border-border pt-8 md:grid-cols-3">
      <div>
        <h3 class="text-[16px] font-semibold">Secrets</h3>
        <p class="mt-2 text-[15px] leading-[1.65] text-muted-foreground">
          Secrets you enter are sent to Deployz over HTTPS and stored encrypted until your AWS account
          connects. Deployz then delivers them to AWS Secrets Manager in your account and deletes the active
          copy. If your account does not connect within 24 hours, the secret is deleted and must be entered
          again. Encrypted backup copies may remain for up to 7 days. Deployz does not display secret values
          or write them to application logs.
        </p>
        <p class="mt-3 text-[15px] leading-[1.65] text-muted-foreground">Values that the SaaS vendor sets for every customer are stored encrypted in Deployz.</p>
      </div>
      <div>
        <h3 class="text-[16px] font-semibold">Code and AI</h3>
        <p class="mt-2 text-[15px] leading-[1.65] text-muted-foreground">
          Repository access is read-only. Deployz builds versioned container images in its own AWS account
          and stores them in a Deployz registry, and the customer account pulls them. To answer open
          questions during analysis, Deployz can send limited repository excerpts to an AI service after it
          redacts values that look like secrets. The AI does not change deployments.
        </p>
      </div>
      <div>
        <h3 class="text-[16px] font-semibold">Network routing</h3>
        <p class="mt-2 text-[15px] leading-[1.65] text-muted-foreground">
          Each deployment gets a default deployz.dev URL. Traffic to that URL, including its content, passes
          through the Deployz DNS proxy on Cloudflare before it reaches the load balancer in the customer's
          account. With a custom domain, traffic goes directly to the customer's load balancer.
        </p>
      </div>
    </div>
  </Section>

  <!-- S6. Updates, removal, and continuity -->
  <Section divider labelledby="lifecycle-title">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,4fr)_minmax(0,8fr)] lg:gap-16">
      <div>
        <h2 id="lifecycle-title" class="text-h2 max-w-[440px]">Know what happens after deployment.</h2>
        <a class="link-arrow mt-6" href="/docs/#lifecycle">Technical documentation <ArrowRight className="size-4" aria-hidden="true" /></a>
      </div>
      <FaqList items={lifecycle} class="max-w-[760px]" />
    </div>

    <div class="mt-16 max-w-[720px] border-t border-border pt-10">
      <h3 class="text-h3">Built by a team that runs SaaS products.</h3>
      <p class="mt-3 text-muted-foreground">
        Deployz is built by Thalia Technologies, the team behind CSVBox, Spreadr, and other SaaS products.
      </p>
    </div>
  </Section>

  <!-- S7. Final CTA -->
  <CtaSection title="Deploy into customer AWS with a clearer view of control." cta="security-closing">
    See how Deployz prepares and manages deployments in your customer's account.
  </CtaSection>
</Base>

<style>
  .schematic {
    --stroke: var(--border-strong);
    --lane-gap: 20px;
  }

  /* ---------- Layout: vertical on mobile, horizontal from 900px ---------- */
  .sch-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    max-width: 560px;
    margin-inline: auto;
  }

  /* ---------- Customer AWS account boundary ---------- */
  .boundary {
    border: 1px solid var(--border-strong);
    border-radius: 12px;
    background: var(--surface-subtle);
    padding: 20px;
  }

  .boundary-label {
    font-size: 14px;
    line-height: 1.4;
    font-weight: 600;
    color: var(--foreground);
  }

  .boundary {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }

  .resources {
    margin-top: 16px;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 8px;
  }

  @media (min-width: 640px) {
    .resources {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .res {
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--background);
    padding: 12px 14px;
    font-size: 14px;
    line-height: 1.4;
    font-weight: 500;
    color: var(--muted-foreground);
  }

  .res-app {
    border-color: var(--border-strong);
    font-weight: 600;
    color: var(--foreground);
  }

  .connector-node {
    margin-top: 12px;
    border: 1px solid var(--foreground);
    border-radius: 8px;
    background: var(--background);
    padding: 14px;
    font-size: 14px;
    line-height: 1.4;
    font-weight: 600;
    color: var(--foreground);
  }

  .boundary-note {
    margin-top: 16px;
    font-size: 14px;
    line-height: 1.5;
    color: var(--muted-foreground);
  }

  /* ---------- Relay lanes ---------- */
  .lanes {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: clamp(16px, 8vw, 56px);
  }

  .lane {
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
  }

  .lane-out {
    justify-content: flex-end;
  }

  .lane-out .lane-label {
    text-align: right;
  }

  .lane-label {
    min-width: 0;
    overflow-wrap: anywhere;
    font-size: 14px;
    line-height: 1.35;
    font-weight: 500;
    color: var(--muted-foreground);
  }

  .lane-label-out {
    color: var(--brand-hover);
    font-weight: 600;
  }

  .rail {
    position: relative;
    flex: none;
    display: block;
    width: 16px;
    height: 80px;
    color: var(--stroke);
  }

  .rail-out {
    color: var(--brand);
  }

  /* line */
  .rail::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 0;
    bottom: 0;
    margin-left: -0.75px;
    border-left: 1.5px solid currentColor;
  }

  .rail-in::before {
    border-left-style: dashed;
  }

  /* end marks: arrowhead (out) / stop bar (in) */
  .rail::after {
    content: '';
    position: absolute;
  }

  .rail-out::after {
    left: 50%;
    bottom: 1px;
    width: 9px;
    height: 9px;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: translateX(-50%) rotate(45deg);
    transform-origin: center;
    margin-bottom: 1px;
  }

  .rail-in::before {
    top: 6px;
  }

  .rail-in::after {
    left: 50%;
    top: 6px;
    width: 10px;
    margin-left: -5px;
    border-top: 2px solid var(--muted-foreground);
  }

  /* ---------- Deployz (the single blue element) ---------- */
  .dz {
    border: 1px solid var(--brand-border);
    border-radius: 12px;
    background: var(--brand-subtle);
    padding: 20px;
  }

  .dz-name {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 16px;
    line-height: 1.35;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--foreground);
  }

  .dz-rows {
    margin-top: 16px;
    border-top: 1px solid var(--brand-border);
  }

  .dz-rows li {
    padding-top: 10px;
    font-size: 14px;
    line-height: 1.45;
    font-weight: 500;
    color: var(--foreground);
  }

  @media (min-width: 900px) {
    .sch-grid {
      max-width: none;
      grid-template-columns: minmax(0, 1fr) 168px 248px;
      align-items: stretch;
    }

    .boundary {
      grid-template-columns: minmax(0, 1fr) 168px;
      grid-template-areas:
        'label conn'
        'res conn'
        'note conn';
      grid-template-rows: auto 1fr auto;
      column-gap: 24px;
      padding: 24px;
    }

    .boundary-label { grid-area: label; }
    .resources { grid-area: res; align-content: start; }
    .boundary-note { grid-area: note; margin-top: 20px; }

    .connector-node {
      grid-area: conn;
      align-self: center;
      margin-top: 0;
      padding: 18px 16px;
    }

    .lanes {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 32px;
      align-content: center;
      margin-left: -25px;
      position: relative;
    }

    .lane .lane-label {
      padding-left: 25px;
      text-align: center;
    }

    .lane-out {
      justify-content: initial;
    }

    .lane {
      flex-direction: column;
      align-items: stretch;
      gap: 8px;
    }

    .rail {
      width: 100%;
      height: 16px;
    }

    .rail::before {
      left: 0;
      right: 0;
      top: 50%;
      bottom: auto;
      margin-left: 0;
      margin-top: -0.75px;
      border-left: 0;
      border-top: 1.5px solid currentColor;
    }

    .rail-in::before {
      left: 31px;
      top: 50%;
      border-top-style: dashed;
    }

    .rail-out::after {
      left: auto;
      right: 1px;
      bottom: auto;
      top: 50%;
      margin-bottom: 0;
      transform: translateY(-50%) rotate(-45deg);
      border-right: 1.5px solid currentColor;
      border-bottom: 1.5px solid currentColor;
    }

    .rail-in::after {
      left: 31px;
      top: 50%;
      width: 0;
      height: 10px;
      margin-left: 0;
      margin-top: -5px;
      border-top: 0;
      border-left: 2px solid var(--muted-foreground);
    }

    .dz {
      align-self: center;
      padding: 24px;
    }
  }
</style>
