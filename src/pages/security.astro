---
import FaqList from '@/components/site/FaqList.astro';
import PageHeader from '@/components/site/PageHeader.astro';
import Section from '@/components/site/Section.astro';
import SectionHeading from '@/components/site/SectionHeading.astro';
import Base from '../layouts/Base.astro';

const ownership = [
  { area: 'Application source', vendor: 'Owns', customer: 'No access needed', deployz: 'Read-only' },
  { area: 'Application releases', vendor: 'Creates and selects', customer: 'Runs', deployz: 'Builds and stores the images' },
  { area: 'AWS account', vendor: 'No access, no credentials', customer: 'Owns and controls', deployz: 'No credentials. Instructs the connector.' },
  { area: 'AWS infrastructure bill', vendor: 'Not charged', customer: 'Pays AWS directly', deployz: 'Does not resell AWS' },
  { area: 'Application data', vendor: 'Defines the application behavior', customer: 'Controls', deployz: 'Does not receive' },
  { area: 'Deployment operations', vendor: 'Starts', customer: 'Authorizes, and can remove', deployz: 'Coordinates and reports' },
];

const lifecycle = [
  {
    event: 'Failed first installation',
    result: 'The deployment shows as failed with a diagnosis. The vendor can retry. A retry deletes the failed resources and creates them again.',
  },
  {
    event: 'Failed update',
    result: 'If a new version fails its health checks, the previous version continues to run. Database migrations are not reversed.',
  },
  {
    event: 'Rollback',
    result: 'The vendor selects an earlier successful release and deploys it. A rollback does not run migrations and does not change customer data.',
  },
  {
    event: 'Disconnect',
    result: 'Disconnect removes the application resources. It keeps the database, its credentials, and the stored files. Retained resources can continue to cause AWS charges.',
  },
  {
    event: 'Data purge',
    result: 'Purge is a separate step that the vendor confirms. It permanently deletes the retained data and does not make a final snapshot.',
  },
  {
    event: 'Connector removal',
    result: "The connector stays in the customer's account until the customer deletes it in its AWS console.",
  },
];

const connectorFacts = [
  {
    title: 'The customer starts the connection',
    text: 'From its own AWS console. Deployz does not see or store AWS credentials.',
  },
  {
    title: 'Outbound connection only',
    text: 'The connector calls Deployz. Deployz does not call into the account.',
  },
  {
    title: 'Scoped, but substantial, permissions',
    text: 'The connector creates network, compute, database, cache, storage, and access resources. Write access applies only to resources tagged for the installation, and a permissions boundary caps it.',
  },
  {
    title: 'No access to application logs',
    text: 'The connector has no permission to read them.',
  },
  {
    title: 'The customer can remove the connection',
    text: 'The customer deletes the connector in its AWS console. Deployz then shows the deployment as disconnected.',
  },
];

const receives = [
  'Installation ID, AWS account ID, and AWS region',
  'Release version and deployment state',
  'Infrastructure status and resource identifiers',
  'Deployment timestamps and health state',
  'Structured AWS deployment errors',
];

const doesNotReceive = [
  'PostgreSQL data',
  'Cache contents',
  'Stored files',
  'Application logs',
  'The application runtime and its in-memory data',
];
---

<Base
  title="Deployz Security and Architecture — Customer-Owned AWS Deployment"
  description="Understand how Deployz separates customer infrastructure ownership, application data control, vendor releases, and deployment access."
>
  <PageHeader title="Customer-owned infrastructure. Vendor-controlled releases.">
    The application runs in the customer's AWS account. Deployz holds no AWS credentials and
    does not receive application data.
    <a slot="actions" class="btn btn-primary btn-lg" href="/docs">Read the technical documentation</a>
  </PageHeader>

  <!-- 1. Account-boundary schematic + connector facts -->
  <Section labelledby="boundary-title">
    <SectionHeading id="boundary-title" title="What the connector can and cannot do in the customer's AWS account" />

    <figure class="schematic mt-10 lg:mt-12">
      <div class="sch-grid">
        <!-- Customer AWS account boundary -->
        <div class="boundary">
          <p class="boundary-label">Customer's AWS account</p>
          <ul class="resources">
            <li class="res res-app">Application container</li>
            <li class="res">PostgreSQL database</li>
            <li class="res">Redis-compatible cache</li>
            <li class="res">S3 file storage</li>
          </ul>
          <p class="connector-node">Deployz connector, installed by the customer</p>
          <p class="boundary-note">The data, the files, and the logs stay here.</p>
        </div>

        <!-- Relay lanes -->
        <div class="lanes">
          <div class="lane lane-out">
            <p class="lane-label lane-label-out">Outbound calls only</p>
            <span class="rail rail-out" aria-hidden="true"></span>
          </div>
          <div class="lane lane-in">
            <span class="rail rail-in" aria-hidden="true"></span>
            <p class="lane-label">No inbound calls</p>
          </div>
        </div>

        <!-- Deployz -->
        <div class="dz">
          <p class="dz-name">
            <img src="/deployz-icon-master.svg" alt="" width="18" height="18" class="size-[18px]" />
            Deployz
          </p>
          <ul class="dz-rows">
            <li>Sends deployment instructions</li>
            <li>Receives status and errors</li>
            <li>Holds no AWS credentials</li>
          </ul>
        </div>
      </div>
    </figure>

    <ul class="mt-14 grid gap-x-10 lg:mt-16 md:grid-cols-2 lg:grid-cols-6">
      {connectorFacts.map((fact, i) => (
        <li class:list={['border-t border-border py-6', i < 3 ? 'lg:col-span-2' : 'lg:col-span-3', i === 4 && 'md:col-span-2']}>
          <h3 class="text-[16px] font-semibold tracking-[-0.01em]">{fact.title}</h3>
          <p class="mt-2 max-w-[52ch] text-[15px] leading-[1.6] text-muted-foreground">{fact.text}</p>
        </li>
      ))}
    </ul>
  </Section>

  <!-- 2. Responsibility matrix -->
  <Section divider labelledby="owns-title">
    <SectionHeading id="owns-title" title="Who owns and controls what" />

    <!-- Desktop: real table -->
    <div class="mt-10 hidden md:block lg:mt-12">
      <table class="w-full table-fixed border-collapse text-left" aria-labelledby="owns-title">
        <thead>
          <tr class="border-b border-border-strong">
            <th scope="col" class="w-[22%] py-3 pr-6 text-[14px] font-semibold"><span class="sr-only">Area</span></th>
            <th scope="col" class="py-3 pr-6 text-[14px] font-semibold">SaaS vendor</th>
            <th scope="col" class="py-3 pr-6 text-[14px] font-semibold">Vendor's customer</th>
            <th scope="col" class="py-3 text-[14px] font-semibold">Deployz</th>
          </tr>
        </thead>
        <tbody>
          {ownership.map((row) => (
            <tr class="border-b border-border align-top">
              <th scope="row" class="py-5 pr-6 text-[16px] font-semibold tracking-[-0.01em]">{row.area}</th>
              <td class="py-5 pr-6 text-[15px] leading-[1.55] text-muted-foreground">{row.vendor}</td>
              <td class="py-5 pr-6 text-[15px] leading-[1.55] text-muted-foreground">{row.customer}</td>
              <td class="py-5 text-[15px] leading-[1.55] text-muted-foreground">{row.deployz}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <!-- Mobile: stacked per area -->
    <ul class="mt-10 border-b border-border md:hidden">
      {ownership.map((row) => (
        <li class="border-t border-border py-6">
          <h3 class="text-[18px] font-semibold tracking-[-0.01em]">{row.area}</h3>
          <dl class="mt-4 grid grid-cols-[minmax(0,7.5rem)_minmax(0,1fr)] gap-x-4 gap-y-3 text-[15px] leading-[1.5]">
            <dt class="text-subtle">SaaS vendor</dt>
            <dd>{row.vendor}</dd>
            <dt class="text-subtle">Vendor's customer</dt>
            <dd>{row.customer}</dd>
            <dt class="text-subtle">Deployz</dt>
            <dd>{row.deployz}</dd>
          </dl>
        </li>
      ))}
    </ul>
  </Section>

  <!-- 3. Data: receives / does not receive -->
  <Section tone="subtle" divider labelledby="data-title">
    <SectionHeading id="data-title" title="Application data stays in the customer's account" />

    <div class="mt-10 grid border-t border-border-strong md:grid-cols-2 lg:mt-12">
      <div class="py-8 md:border-r md:border-border md:pr-10">
        <h3 class="text-[18px] font-semibold tracking-[-0.01em]">Deployz receives</h3>
        <ul class="mt-5 grid">
          {receives.map((item) => (
            <li class="border-t border-border py-3 text-[15px] leading-[1.5] first:border-t-0 first:pt-0">{item}</li>
          ))}
        </ul>
      </div>
      <div class="border-t border-border py-8 md:border-t-0 md:pl-10">
        <h3 class="text-[18px] font-semibold tracking-[-0.01em]">Deployz does not receive</h3>
        <ul class="mt-5 grid">
          {doesNotReceive.map((item) => (
            <li class="border-t border-border py-3 text-[15px] leading-[1.5] first:border-t-0 first:pt-0">{item}</li>
          ))}
        </ul>
      </div>
    </div>

    <div class="grid gap-6 border-t border-border pt-8 text-[15px] leading-[1.65] text-muted-foreground md:grid-cols-2 md:gap-20">
      <p class="max-w-[60ch]">
        Secrets: values that you enter in Deployz are written to AWS Secrets Manager in the
        customer's account. Deployz does not store them in plain text. It stores non-secret
        configuration values.
      </p>
      <p class="max-w-[60ch]">
        Default URL: traffic to the default deployz.dev URL passes through the Deployz DNS proxy
        before it reaches the load balancer in the customer's account.
      </p>
    </div>
  </Section>

  <!-- 4. Releases / AI / Operator: quiet grid -->
  <Section labelledby="releases-title">
    <div class="grid gap-x-10 gap-y-12 md:grid-cols-3">
      <div class="border-t border-border-strong pt-6">
        <h2 id="releases-title" class="text-[22px] leading-[1.3] font-semibold tracking-[-0.015em] text-balance">Releases without repository access</h2>
        <p class="mt-3 text-[15px] leading-[1.65] text-muted-foreground">
          The customer's AWS account pulls a versioned container image from the Deployz registry.
          Access starts at installation and ends at removal. A container image is not a
          source-protection mechanism.
        </p>
      </div>
      <div class="border-t border-border-strong pt-6">
        <h2 class="text-[22px] leading-[1.3] font-semibold tracking-[-0.015em] text-balance">How Deployz uses AI during analysis</h2>
        <p class="mt-3 text-[15px] leading-[1.65] text-muted-foreground">
          Deployz can send limited repository excerpts to an AI service to resolve open questions.
          It redacts values that look like secrets first. The AI service does not call AWS and does
          not change deployments.
        </p>
      </div>
      <div class="border-t border-border-strong pt-6">
        <h2 class="text-[22px] leading-[1.3] font-semibold tracking-[-0.015em] text-balance">Who operates Deployz</h2>
        <p class="mt-3 text-[15px] leading-[1.65] text-muted-foreground">
          Tejas Sangoi and the bootstrapped team at Thalia Technologies build and operate Deployz.
          The same team has operated CSVBox, Spreadr, and other SaaS products in production for
          years.
        </p>
      </div>
    </div>
  </Section>

  <!-- 5. Deployz unavailable -->
  <Section divider labelledby="unavailable-title">
    <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
      <div>
        <h2 id="unavailable-title" class="text-h2 text-balance">If Deployz is unavailable, the application continues to run</h2>
        <p class="mt-5 max-w-[56ch] text-muted-foreground">
          A healthy environment continues to serve traffic. Its database, cache, and storage stay
          available. New deployments, updates, status refreshes, recovery actions, and deletion
          controls can be temporarily unavailable. An operation that is in progress can require
          reconciliation when Deployz returns.
        </p>
      </div>
      <div
        role="img"
        aria-label="Deployz is offline. The application in the customer's AWS account continues to serve traffic."
        class="off"
      >
        <div class="off-inner" aria-hidden="true">
          <div class="off-dz">
            <p class="off-dz-name">Deployz</p>
            <p class="off-dz-state">offline</p>
          </div>
          <div class="off-link">
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M3.5 3.5l9 9M12.5 3.5l-9 9" /></svg>
          </div>
          <div class="off-boundary">
            <p class="off-boundary-label">Customer's AWS account</p>
            <p class="off-node off-node-app">Application</p>
            <p class="off-node">Database</p>
          </div>
          <div class="off-traffic">
            <span class="off-arrow"></span>
            <span class="off-traffic-label">Traffic</span>
          </div>
        </div>
      </div>
    </div>
  </Section>

  <!-- 6. Lifecycle disclosures -->
  <Section tone="default" divider labelledby="lifecycle-title">
    <SectionHeading id="lifecycle-title" title="What happens when an operation fails or an environment is removed" />
    <FaqList class="mt-10 max-w-[760px] lg:mt-12" items={lifecycle.map((item) => ({ question: item.event, answer: item.result }))} />
  </Section>

  <!-- 7. Closing -->
  <Section divider labelledby="closing-title">
    <div class="flex flex-col items-start gap-8">
      <div class="max-w-[820px]">
        <h2 id="closing-title" class="text-h2 text-balance">Does your customer's security team have questions?</h2>
        <p class="mt-4 max-w-[640px] text-lead text-muted-foreground">Send them this page. It describes the access, the data, and the failure behavior.</p>
      </div>
      <div class="flex flex-wrap gap-3">
        <a class="btn btn-primary btn-lg" href="/docs">Read the technical documentation</a>
        <a class="btn btn-secondary btn-lg" href="/docs#supported-architecture">View supported architecture</a>
      </div>
    </div>
  </Section>
</Base>

<style>
  .schematic {
    --stroke: var(--border-strong);
    --lane-gap: 20px;
  }

  /* ---------- Layout: vertical on mobile, horizontal from 900px ---------- */
  .sch-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    max-width: 560px;
    margin-inline: auto;
  }

  /* ---------- Customer AWS account boundary ---------- */
  .boundary {
    border: 1px solid var(--border-strong);
    border-radius: 12px;
    background: var(--surface-subtle);
    padding: 20px;
  }

  .boundary-label {
    font-size: 14px;
    line-height: 1.4;
    font-weight: 600;
    color: var(--foreground);
  }

  .boundary {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }

  .resources {
    margin-top: 16px;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 8px;
  }

  @media (min-width: 640px) {
    .resources {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .res {
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--background);
    padding: 12px 14px;
    font-size: 14px;
    line-height: 1.4;
    font-weight: 500;
    color: var(--muted-foreground);
  }

  .res-app {
    border-color: var(--border-strong);
    font-weight: 600;
    color: var(--foreground);
  }

  .connector-node {
    margin-top: 12px;
    border: 1px solid var(--foreground);
    border-radius: 8px;
    background: var(--background);
    padding: 14px;
    font-size: 14px;
    line-height: 1.4;
    font-weight: 600;
    color: var(--foreground);
  }

  .boundary-note {
    margin-top: 16px;
    font-size: 14px;
    line-height: 1.5;
    color: var(--muted-foreground);
  }

  /* ---------- Relay lanes ---------- */
  .lanes {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: clamp(16px, 8vw, 56px);
  }

  .lane {
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
  }

  .lane-out {
    justify-content: flex-end;
  }

  .lane-out .lane-label {
    text-align: right;
  }

  .lane-label {
    min-width: 0;
    overflow-wrap: anywhere;
    font-size: 14px;
    line-height: 1.35;
    font-weight: 500;
    color: var(--muted-foreground);
  }

  .lane-label-out {
    color: var(--brand-hover);
    font-weight: 600;
  }

  .rail {
    position: relative;
    flex: none;
    display: block;
    width: 16px;
    height: 80px;
    color: var(--stroke);
  }

  .rail-out {
    color: var(--brand);
  }

  /* line */
  .rail::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 0;
    bottom: 0;
    margin-left: -0.75px;
    border-left: 1.5px solid currentColor;
  }

  .rail-in::before {
    border-left-style: dashed;
  }

  /* end marks: arrowhead (out) / stop bar (in) */
  .rail::after {
    content: '';
    position: absolute;
  }

  .rail-out::after {
    left: 50%;
    bottom: 1px;
    width: 9px;
    height: 9px;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: translateX(-50%) rotate(45deg);
    transform-origin: center;
    margin-bottom: 1px;
  }

  .rail-in::before {
    top: 6px;
  }

  .rail-in::after {
    left: 50%;
    top: 6px;
    width: 10px;
    margin-left: -5px;
    border-top: 2px solid var(--muted-foreground);
  }

  /* ---------- Deployz (the single blue element) ---------- */
  .dz {
    border: 1px solid var(--brand-border);
    border-radius: 12px;
    background: var(--brand-subtle);
    padding: 20px;
  }

  .dz-name {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 16px;
    line-height: 1.35;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--foreground);
  }

  .dz-rows {
    margin-top: 16px;
    border-top: 1px solid var(--brand-border);
  }

  .dz-rows li {
    padding-top: 10px;
    font-size: 14px;
    line-height: 1.45;
    font-weight: 500;
    color: var(--foreground);
  }

  @media (min-width: 900px) {
    .sch-grid {
      max-width: none;
      grid-template-columns: minmax(0, 1fr) 168px 248px;
      align-items: stretch;
    }

    .boundary {
      grid-template-columns: minmax(0, 1fr) 168px;
      grid-template-areas:
        'label conn'
        'res conn'
        'note conn';
      grid-template-rows: auto 1fr auto;
      column-gap: 24px;
      padding: 24px;
    }

    .boundary-label { grid-area: label; }
    .resources { grid-area: res; align-content: start; }
    .boundary-note { grid-area: note; margin-top: 20px; }

    .connector-node {
      grid-area: conn;
      align-self: center;
      margin-top: 0;
      padding: 18px 16px;
    }

    .lanes {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 32px;
      align-content: center;
      margin-left: -25px;
      position: relative;
    }

    .lane .lane-label {
      padding-left: 25px;
      text-align: center;
    }

    .lane-out {
      justify-content: initial;
    }

    .lane {
      flex-direction: column;
      align-items: stretch;
      gap: 8px;
    }

    .rail {
      width: 100%;
      height: 16px;
    }

    .rail::before {
      left: 0;
      right: 0;
      top: 50%;
      bottom: auto;
      margin-left: 0;
      margin-top: -0.75px;
      border-left: 0;
      border-top: 1.5px solid currentColor;
    }

    .rail-in::before {
      left: 31px;
      top: 50%;
      border-top-style: dashed;
    }

    .rail-out::after {
      left: auto;
      right: 1px;
      bottom: auto;
      top: 50%;
      margin-bottom: 0;
      transform: translateY(-50%) rotate(-45deg);
      border-right: 1.5px solid currentColor;
      border-bottom: 1.5px solid currentColor;
    }

    .rail-in::after {
      left: 31px;
      top: 50%;
      width: 0;
      height: 10px;
      margin-left: 0;
      margin-top: -5px;
      border-top: 0;
      border-left: 2px solid var(--muted-foreground);
    }

    .dz {
      align-self: center;
      padding: 24px;
    }
  }

  /* ---------- "Deployz is unavailable" illustration ---------- */
  .off {
    width: 100%;
    max-width: 520px;
    margin-inline: auto;
  }

  .off-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    justify-items: stretch;
  }

  .off-dz {
    border: 1px dashed var(--border-strong);
    border-radius: 12px;
    background: var(--background);
    padding: 16px 20px;
  }

  .off-dz-name {
    font-size: 14px;
    line-height: 1.4;
    font-weight: 600;
    color: var(--foreground);
  }

  .off-dz-state {
    font-size: 14px;
    line-height: 1.4;
    color: var(--muted-foreground);
  }

  .off-link {
    position: relative;
    height: 56px;
    color: var(--muted-foreground);
  }

  .off-link::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 0;
    bottom: 0;
    border-left: 1.5px dashed var(--border-strong);
  }

  .off-link svg {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 24px;
    height: 24px;
    margin: -12px 0 0 -12px;
    padding: 4px;
    background: var(--background);
  }

  .off-boundary {
    display: grid;
    gap: 8px;
    border: 1px solid var(--border-strong);
    border-radius: 12px;
    background: var(--surface-subtle);
    padding: 20px;
  }

  .off-boundary-label {
    font-size: 14px;
    line-height: 1.4;
    font-weight: 600;
    color: var(--foreground);
    margin-bottom: 6px;
  }

  .off-node {
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--background);
    padding: 12px 14px;
    font-size: 14px;
    line-height: 1.4;
    font-weight: 500;
    color: var(--muted-foreground);
  }

  .off-node-app {
    border-color: var(--border-strong);
    font-weight: 600;
    color: var(--foreground);
  }

  .off-traffic {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 0 0 28px;
    color: var(--foreground);
  }

  .off-arrow {
    position: relative;
    flex: none;
    width: 16px;
    height: 48px;
  }

  .off-arrow::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 1px;
    bottom: 0;
    margin-left: -0.75px;
    border-left: 1.5px solid currentColor;
  }

  .off-arrow::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 2px;
    width: 9px;
    height: 9px;
    border-left: 1.5px solid currentColor;
    border-top: 1.5px solid currentColor;
    transform: translateX(-50%) rotate(45deg);
  }

  .off-traffic-label {
    font-size: 14px;
    line-height: 1.4;
