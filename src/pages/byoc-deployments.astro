---
import { ArrowRight } from 'lucide-react';
import CtaSection from '@/components/site/CtaSection.astro';
import PageHeader from '@/components/site/PageHeader.astro';
import Section from '@/components/site/Section.astro';
import SectionHeading from '@/components/site/SectionHeading.astro';
import { CTA_LABEL, SIGNUP_URL } from '@/lib/site';
import Base from '../layouts/Base.astro';

const models = [
  {
    name: 'Hosted SaaS',
    rows: [
      ['App runs in', 'Your cloud'],
      ['Data infrastructure', 'You own it'],
      ['Installs', 'Not needed'],
      ['Updates', 'You ship them'],
      ['AWS bill', 'You pay'],
    ],
  },
  {
    name: 'BYOC with Deployz',
    brand: true,
    rows: [
      ['App runs in', "The customer's AWS account"],
      ['Data infrastructure', 'The customer owns it'],
      ['Installs', 'Customer approves; Deployz deploys'],
      ['Updates', 'You choose; Deployz deploys'],
      ['AWS bill', 'The customer pays AWS'],
    ],
  },
  {
    name: 'Self-hosted handoff',
    rows: [
      ['App runs in', "The customer's infrastructure"],
      ['Data infrastructure', 'The customer owns it'],
      ['Installs', "The customer's team runs them"],
      ['Updates', "The customer's team, when they choose"],
      ['AWS bill', 'The customer pays'],
    ],
  },
];

const platform = [
  { need: 'An installer customers trust', deployz: 'Installation links with a preview of resources, AWS cost estimate, and IAM actions' },
  { need: 'Cross-account access', deployz: 'A connector the customer launches; it connects out, and its role has a permissions boundary and is limited to its own installation' },
  { need: 'Infrastructure templates', deployz: 'Rule-based CloudFormation for supported AWS resources' },
  { need: 'A release pipeline', deployz: 'Versioned release images built from your repository' },
  { need: 'Updates and rollbacks', deployz: 'Per-customer releases, started by you' },
  { need: 'Status across accounts', deployz: 'Progress and health for every customer environment' },
];
---

<Base
  title="BYOC Deployments for SaaS on AWS — Deployz"
  description="Offer bring-your-own-cloud (BYOC) deployments on AWS. Deployz installs, updates, and monitors your SaaS in each customer's AWS account, without a platform team."
>
  <!-- B1. Hero -->
  <PageHeader eyebrow="BYOC deployments" title="Offer BYOC on AWS without building the platform.">
    Bring your own cloud (BYOC) means your SaaS runs in the customer's AWS account while you still deliver
    and update it. Deployz gives small teams that model.
    <a slot="actions" class="btn btn-primary btn-lg" href={SIGNUP_URL} data-cta="byoc-hero">{CTA_LABEL}</a>
  </PageHeader>

  <!-- B2. Models -->
  <Section labelledby="models-title">
    <SectionHeading id="models-title" title="BYOC sits between hosted SaaS and self-hosting.">
      Your customer keeps the infrastructure. You keep control of releases.
    </SectionHeading>
    <div class="mt-12 grid gap-10 md:grid-cols-3 md:gap-8 lg:mt-14 lg:gap-12">
      {models.map((model) => (
        <div class:list={['border-t pt-5', model.brand ? 'border-brand' : 'border-foreground']}>
          <h3 class="text-[18px] font-semibold tracking-[-0.01em]">{model.name}</h3>
          <dl class="mt-4 border-b border-border">
            {model.rows.map(([term, value]) => (
              <div class="grid grid-cols-[minmax(0,2fr)_minmax(0,3fr)] gap-4 border-t border-border py-3 text-[15px]">
                <dt class="text-subtle">{term}</dt>
                <dd class={model.brand ? 'text-foreground' : 'text-muted-foreground'}>{value}</dd>
              </div>
            ))}
          </dl>
        </div>
      ))}
    </div>
  </Section>

  <!-- B3. What a BYOC platform needs -->
  <Section labelledby="platform-title">
    <div class="grid grid-cols-[minmax(0,1fr)] gap-10 lg:grid-cols-[minmax(0,4fr)_minmax(0,8fr)] lg:gap-16">
      <div>
        <h2 id="platform-title" class="text-h2 max-w-[440px]">What a BYOC platform needs</h2>
        <p class="mt-5 max-w-[440px] text-muted-foreground">
          Teams that build BYOC themselves maintain each of these for every customer. Deployz includes them.
        </p>
        <a class="link-arrow mt-6" href="/how-it-works/">See how it works <ArrowRight className="size-4" aria-hidden="true" /></a>
      </div>
      <dl class="border-b border-border">
        {platform.map((row) => (
          <div class="grid gap-1 border-t border-border py-4 sm:grid-cols-[220px_minmax(0,1fr)] sm:gap-x-8">
            <dt class="font-semibold">{row.need}</dt>
            <dd class="text-muted-foreground">{row.deployz}</dd>
          </div>
        ))}
      </dl>
    </div>
  </Section>

  <!-- B4. Limits -->
  <Section labelledby="limits-title">
    <div class="max-w-[780px]">
      <h2 id="limits-title" class="text-h2">BYOC on AWS, for one supported architecture.</h2>
      <p class="text-lead mt-5 text-muted-foreground">
        Deployz deploys one container image, with optional workers, PostgreSQL or MySQL, a Redis-compatible
        cache, and S3, into a new network in the customer's AWS account. It does not support other clouds,
        Kubernetes, or existing customer VPCs.
      </p>
      <div class="mt-6 flex flex-wrap gap-x-8">
        <a class="link-arrow" href="/how-it-works/#compatibility">Check compatibility <ArrowRight className="size-4" aria-hidden="true" /></a>
        <a class="link-arrow" href="/security/">Security and architecture <ArrowRight className="size-4" aria-hidden="true" /></a>
      </div>
    </div>
  </Section>

  <CtaSection title="Add a BYOC option to your SaaS." cta="byoc-closing">
    Connect GitHub for a free readiness report.
  </CtaSection>
</Base>
