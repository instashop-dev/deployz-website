---
import FaqList from '@/components/site/FaqList.astro';
import PageHeader from '@/components/site/PageHeader.astro';
import Section from '@/components/site/Section.astro';
import Base from '../layouts/Base.astro';

const examples = [
  { environments: '1', price: '$68' },
  { environments: '5', price: '$144' },
  { environments: '10', price: '$239' },
  { environments: '25', price: '$524' },
];

const questions = [
  {
    question: 'What is an active customer environment?',
    answer: "One Deployz-managed installation of your application in a customer's AWS account that is ready and that you have not removed. Each environment counts separately.",
  },
  {
    question: 'What is free?',
    answer: 'Sign-up, analysis, release builds, and one test deployment of your own application for each application. No card is necessary.',
  },
  {
    question: 'When does the $49 charge start?',
    answer: 'The monthly base charge starts with your first customer environment.',
  },
  {
    question: 'When does the $19 charge start and stop?',
    answer: 'It starts when the environment first becomes ready. It stops when you start its removal or when the customer removes the connection.',
  },
  {
    question: 'Who pays for AWS?',
    answer: "Your customer. Infrastructure is created in the customer's AWS account, and AWS charges the customer directly. Deployz pricing does not include AWS infrastructure costs.",
  },
];

const included = [
  'Readiness analysis and release builds',
  'One free test deployment of your own application',
  'A guided installation link for each customer',
  'PostgreSQL, cache, file storage, HTTPS, custom domains',
  'Updates, retries, and rollbacks',
  'Status, failure diagnosis, and removal controls',
];
---

<Base
  title="Deployz Pricing — Simple Private Deployment Pricing"
  description="Deployz costs $49 a month plus $19 for each active customer environment. The evaluation is free, and the charges start with your first customer environment."
>
  <PageHeader title="$49 a month. $19 for each customer environment. Free until your first one.">
    One plan. No card for the evaluation. Your customer pays AWS directly.
    <Fragment slot="actions">
      <a class="btn btn-primary btn-lg" href="/get-started">Check my application</a>
      <span class="text-[14px] text-muted-foreground">Free analysis. No card.</span>
    </Fragment>
  </PageHeader>

  <Section labelledby="plan-title">
    <div class="grid gap-12 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] lg:gap-16">
      <div class="min-w-0 overflow-hidden rounded-xl border border-border-strong bg-background">
        <div class="px-6 pt-8 sm:px-8 sm:pt-8">
          <h2 id="plan-title" class="text-[18px] font-semibold tracking-[-0.01em]">One plan</h2>
          <p class="mt-1 text-muted-foreground">All features are included. There are no tiers.</p>
          <p class="mt-8 flex flex-wrap items-baseline gap-x-2">
            <span class="text-[64px] leading-none font-semibold tracking-[-0.04em] tabular-nums sm:text-[80px]">$49</span>
            <span class="text-[18px] text-muted-foreground">/month</span>
          </p>
          <p class="mt-4 text-[18px]">
            plus <span class="font-semibold tabular-nums">$19</span> per active customer environment/month
          </p>
        </div>
        <dl class="mt-8 grid grid-cols-2 border-t border-border sm:grid-cols-4">
          {examples.map((example) => (
            <div class="flex flex-col-reverse justify-end gap-1 border-b border-border px-6 py-5 sm:border-b-0 sm:border-l sm:first:border-l-0 sm:first:pl-8 sm:px-5 odd:max-sm:border-r">
              <dt class="text-[14px] whitespace-nowrap text-muted-foreground">{example.environments} {example.environments === '1' ? 'customer' : 'customers'}</dt>
              <dd class="text-[24px] leading-tight font-semibold tracking-[-0.02em] tabular-nums">{example.price}</dd>
            </div>
          ))}
        </dl>
        <div class="border-t border-border px-6 py-6 sm:px-8">
          <a class="btn btn-primary btn-lg w-full sm:w-auto" href="/get-started">Check my application</a>
          <p class="mt-4 text-[14px] text-muted-foreground">The evaluation is free. The charges start with your first customer environment.</p>
        </div>
      </div>
      <div class="min-w-0 lg:pt-2">
        <h2 class="text-[18px] font-semibold tracking-[-0.01em]">Included</h2>
        <ul class="mt-5 border-b border-border">
          {included.map((item) => (
            <li class="flex items-start gap-3 border-t border-border py-4">
              <svg aria-hidden="true" viewBox="0 0 16 16" class="mt-[5px] size-4 shrink-0 text-foreground" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8.5l3 3 7-7" /></svg>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </Section>

  <Section tone="subtle" labelledby="works-title">
    <h2 id="works-title" class="text-h2 max-w-[780px]">You pay only for customer environments that work</h2>
    <ul class="mt-12 grid gap-10 md:grid-cols-3 md:gap-8 lg:gap-12">
      <li class="border-t border-foreground pt-6">
        <h3 class="text-[18px] leading-snug font-semibold tracking-[-0.01em]">No charge for a failed installation</h3>
        <p class="mt-3 text-muted-foreground">An installation that does not become ready costs nothing.</p>
      </li>
      <li class="border-t border-foreground pt-6">
        <h3 class="text-[18px] leading-snug font-semibold tracking-[-0.01em]">No charge for each deployment</h3>
        <p class="mt-3 text-muted-foreground">Updates, retries, and rollbacks have no additional charge.</p>
      </li>
      <li class="border-t border-foreground pt-6">
        <h3 class="text-[18px] leading-snug font-semibold tracking-[-0.01em]">A failed payment never stops a customer</h3>
        <p class="mt-3 text-muted-foreground">Existing environments continue to run. Only new environments are blocked.</p>
      </li>
    </ul>
  </Section>

  <Section labelledby="billing-title">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,4fr)_minmax(0,8fr)] lg:gap-16">
      <div>
        <h2 id="billing-title" class="text-h2 max-w-[440px]">Billing questions</h2>
        <p class="mt-4 text-[14px] text-muted-foreground">Prices are in US dollars and are billed monthly.</p>
      </div>
      <FaqList items={questions} class="max-w-[760px]" />
    </div>
  </Section>

  <section aria-labelledby="cta-title" class="border-t border-border">
    <div class="container-site py-20 text-center sm:py-24 lg:py-28">
      <h2 id="cta-title" class="text-h2 mx-auto max-w-[680px]">Start free. Pay when your first customer environment starts.</h2>
      <p class="text-lead mx-auto mt-5 max-w-[560px] text-muted-foreground">Get the readiness report in a few minutes. No card is necessary.</p>
      <a class="btn btn-primary btn-lg mt-8" href="/get-started">Check my application</a>
    </div>
  </section>
</Base>
