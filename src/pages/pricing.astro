---
import CtaSection from '@/components/site/CtaSection.astro';
import FaqList from '@/components/site/FaqList.astro';
import PageHeader from '@/components/site/PageHeader.astro';
import Section from '@/components/site/Section.astro';
import { CTA_LABEL, SIGNUP_URL } from '@/lib/site';
import Base from '../layouts/Base.astro';

const BASE_PRICE = 49;
const ENVIRONMENT_PRICE = 19;
const DEFAULT_ENVIRONMENTS = 3;
const estimate = (count: number) => (count > 0 ? BASE_PRICE + ENVIRONMENT_PRICE * count : 0);

const free = [
  'Sign-up and readiness analysis',
  'Configuration and release builds',
  'One test deployment of your own app per application (AWS costs apply in your own account)',
  'No card required',
];

const included = [
  'Readiness analysis',
  'Release builds',
  'Guided customer installation links',
  'Supported infrastructure: PostgreSQL or MySQL, cache, S3 storage, HTTPS, custom domains',
  'Updates, retries, and rollbacks',
  'Deployment status, failure diagnosis, and removal controls',
];

const questions = [
  {
    question: 'Can I try Deployz for free?',
    answer:
      'Yes. Sign-up, readiness analysis, configuration, release builds, and one test deployment of your own app per application are free, with no card. The test deployment runs in your own AWS account, and AWS bills that account for its resources. Your subscription starts when you start your first customer deployment.',
  },
  {
    question: 'What counts as a billable environment?',
    answer:
      'One Deployz-managed deployment in a customer AWS account that has become ready and has not been removed. Each environment counts separately. A first installation that never becomes ready has no environment charge.',
  },
  {
    question: 'Are AWS costs included?',
    answer:
      "No. AWS costs are separate and billed by AWS to the AWS account owner. For a customer environment, that is your customer. Before they connect, your customer sees an AWS cost estimate for their Region.",
  },
  {
    question: 'What happens if an installation fails or a payment fails?',
    answer:
      'A first installation that never becomes ready has no $19 environment charge. The $49 base subscription starts when you start your first customer deployment, so it can already be active. Updates, retries, and rollbacks have no additional charge. If a payment fails, existing customer environments keep running, but you cannot start new customer deployments until the payment is resolved.',
  },
  {
    question: 'When do charges stop, and what happens if I cancel?',
    answer:
      "An environment's $19 charge stops when its removal starts. You manage invoices, payment details, and cancellation in the portal of our billing partner, Paddle. If you cancel, existing customer environments keep running, but you cannot start new customer deployments. Resources that stay in an AWS account after removal, such as a retained database, continue to cause AWS charges until they are deleted.",
  },
];
---

<Base
  title="Deployz Pricing — Simple Customer Deployment Pricing"
  description="Understand Deployz subscription and deployment charges, estimate fees, and see how AWS infrastructure costs are billed separately."
>
  <!-- P1. Hero -->
  <PageHeader eyebrow="Pricing" title="Simple pricing. No surprises.">
    Start with free application analysis. Your subscription starts with your first customer deployment.
    Your customer pays AWS separately.
  </PageHeader>

  <!-- P2. One plan -->
  <Section labelledby="plan-title">
    <div class="grid gap-12 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] lg:gap-16">
      <div class="min-w-0 overflow-hidden rounded-xl border border-border-strong bg-background">
        <div class="px-6 pt-8 sm:px-8">
          <p class="text-[15px] font-semibold">Deployz</p>
          <h2 id="plan-title" class="text-h3 mt-1">One plan. Pay as you grow.</h2>
          <p class="mt-8 flex flex-wrap items-baseline gap-x-2">
            <span class="text-[64px] leading-none font-semibold tracking-[-0.04em] tabular-nums sm:text-[80px]">$49</span>
            <span class="text-[18px] text-muted-foreground">/ month</span>
          </p>
          <p class="mt-4 text-[18px]">
            + <span class="font-semibold tabular-nums">$19</span> / active customer environment / month
          </p>
        </div>
        <div class="mt-8 border-t border-border px-6 py-6 sm:px-8">
          <h3 class="text-[16px] font-semibold">Free evaluation</h3>
          <ul class="mt-3 grid gap-x-6 gap-y-1 sm:grid-cols-2">
            {free.map((item) => (
              <li class="flex items-start gap-2.5 py-1 text-[15px] text-muted-foreground">
                <svg aria-hidden="true" viewBox="0 0 16 16" class="mt-[5px] size-4 shrink-0 text-foreground" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8.5l3 3 7-7" /></svg>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
        <div class="border-t border-border px-6 py-6 sm:px-8">
          <h3 class="text-[16px] font-semibold">When billing starts</h3>
          <p class="mt-2 text-[15px] text-muted-foreground">
            The $49 base subscription starts when you start your first customer deployment. The $19 for an
            environment starts when it first becomes ready and stops when its removal starts.
          </p>
        </div>
        <div class="border-t border-border px-6 py-6 sm:px-8">
          <a class="btn btn-primary btn-lg w-full sm:w-auto" href={SIGNUP_URL} data-cta="pricing-plan">{CTA_LABEL}</a>
          <p class="mt-4 text-[14px] text-muted-foreground">AWS charges are separate and are billed by AWS to the AWS account owner.</p>
        </div>
      </div>
      <div class="min-w-0 lg:pt-2">
        <h3 class="text-[18px] font-semibold tracking-[-0.01em]">Included</h3>
        <ul class="mt-5 border-b border-border">
          {included.map((item) => (
            <li class="flex items-start gap-3 border-t border-border py-4">
              <svg aria-hidden="true" viewBox="0 0 16 16" class="mt-[5px] size-4 shrink-0 text-foreground" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8.5l3 3 7-7" /></svg>
              <span>{item}</span>
            </li>
          ))}
        </ul>
        <p class="mt-5 text-[14px] text-muted-foreground">Prices are in US dollars and are billed monthly. Applicable taxes may be added.</p>
      </div>
    </div>
  </Section>

  <!-- P3. Cost estimator -->
  <Section divider labelledby="estimate-title">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-16">
      <div>
        <h2 id="estimate-title" class="text-h2">Estimate your Deployz cost.</h2>
        <p class="mt-5 max-w-[440px] text-muted-foreground">
          Choose the number of active billable customer environments to estimate your monthly Deployz
          subscription.
        </p>
      </div>
      <div data-estimator class="min-w-0 rounded-xl border border-border-strong p-6 sm:p-8">
        <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
          <label for="environments" class="text-[16px] font-semibold">Billable customer environments</label>
          <span data-estimator-count class="text-[22px] font-semibold tabular-nums">{DEFAULT_ENVIRONMENTS}</span>
        </div>
        <input
          id="environments"
          type="range"
          min="0"
          max="30"
          step="1"
          value={DEFAULT_ENVIRONMENTS}
          aria-describedby="estimate-formula"
          class="estimator-range mt-4 w-full"
        />
        <div class="mt-1 flex justify-between text-[13px] text-subtle" aria-hidden="true"><span>0</span><span>30</span></div>
        <div class="mt-8 border-t border-border pt-6">
          <p class="text-[14px] text-muted-foreground">Estimated Deployz charges / month</p>
          <output for="environments" data-estimator-total aria-live="polite" aria-atomic="true" class="mt-1 block text-[48px] leading-none font-semibold tracking-[-0.03em] tabular-nums">
            ${estimate(DEFAULT_ENVIRONMENTS)}
          </output>
          <p id="estimate-formula" class="mt-4 text-[15px] text-muted-foreground">
            Before your first customer deployment: $0 / month. After that: $49 + $19 × active billable
            environments.
          </p>
          <p class="mt-3 text-[14px] text-muted-foreground">
            Excludes AWS charges, applicable taxes, and any charges not covered by the published plan. The $49
            base starts with your first customer deployment, before it is ready. If you remove all
            environments, the $49 base continues until you cancel.
          </p>
        </div>
      </div>
    </div>
  </Section>

  <!-- P4. Deployz vs AWS -->
  <Section divider labelledby="costs-title">
    <h2 id="costs-title" class="text-h2 max-w-[780px]">Deployz fees and AWS costs are different.</h2>
    <div class="mt-10 grid gap-10 md:grid-cols-2 md:gap-12">
      <div class="border-t border-foreground pt-5">
        <h3 class="text-[18px] font-semibold tracking-[-0.01em]">Deployz</h3>
        <p class="mt-2 text-muted-foreground">Your subscription and billable managed deployments.</p>
      </div>
      <div class="border-t border-foreground pt-5">
        <h3 class="text-[18px] font-semibold tracking-[-0.01em]">AWS</h3>
        <p class="mt-2 text-muted-foreground">
          Computing, databases, networking, storage, and other resources used by your SaaS in the
          customer's account. AWS bills the account owner under their AWS arrangement.
        </p>
      </div>
    </div>
    <p class="mt-10 max-w-[780px] text-muted-foreground">
      AWS resource costs depend on region, configuration, and usage. They may continue while resources
      remain provisioned, even if an app deployment is stopped or some resources are retained.
    </p>
  </Section>

  <!-- P5. Billing questions -->
  <Section divider labelledby="billing-title">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,4fr)_minmax(0,8fr)] lg:gap-16">
      <h2 id="billing-title" class="text-h2 max-w-[440px]">Billing questions</h2>
      <FaqList items={questions} class="max-w-[760px]" />
    </div>
  </Section>

  <!-- P6. Final CTA -->
  <CtaSection title="Start with your SaaS. Grow from there." cta="pricing-closing">
    Connect your application and explore how Deployz prepares customer AWS deployments.
  </CtaSection>
</Base>

<style>
  .estimator-range {
    height: 44px;
    accent-color: var(--foreground);
    cursor: pointer;
  }
</style>

<script is:inline>
  (function () {
    var root = document.querySelector('[data-estimator]');
    if (!root) return;
    var input = root.querySelector('input');
    var count = root.querySelector('[data-estimator-count]');
    var total = root.querySelector('[data-estimator-total]');

    function update() {
      var environments = Number(input.value);
      count.textContent = String(environments);
      total.textContent = '$' + (environments > 0 ? 49 + 19 * environments : 0);
    }

    input.addEventListener('input', update);
    update();
  })();
</script>
