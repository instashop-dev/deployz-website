---
import BuildVsBuyDiagram from '@/components/site/diagram/BuildVsBuyDiagram.astro';
import CtaSection from '@/components/site/CtaSection.astro';
import FaqList from '@/components/site/FaqList.astro';
import PageHeader from '@/components/site/PageHeader.astro';
import Section from '@/components/site/Section.astro';
import { BASE_PRICE, CTA_LABEL, ENVIRONMENT_PRICE, SIGNUP_URL } from '@/lib/site';
import Base from '../layouts/Base.astro';

const DEFAULT_ENVIRONMENTS = 3;
const MAX_ENVIRONMENTS = 30;
const estimate = (count: number) => BASE_PRICE + ENVIRONMENT_PRICE * count;

const free = [
  'Readiness analysis and configuration',
  'Release builds',
  'One active test deployment per application, in your own AWS account',
  'No card and no time limit',
];

const included = [
  'GitHub readiness analysis and deployment checks',
  'Fix instructions for deployment blockers',
  'Environment variable and secret configuration',
  'Versioned releases built from your repository',
  'Shareable customer installation links',
  'AWS resource and cost previews before installation',
  'Network, container, and optional worker provisioning',
  'PostgreSQL or MySQL, Redis-compatible cache, and S3 provisioning',
  'HTTPS and custom domains',
  'Deployment progress and health status',
  'Per-customer release selection',
  'Updates, retries, and rollbacks',
  'Failure diagnosis and environment removal',
];

const benefits = [
  {
    title: 'Skip the upfront build',
    text: 'Use ready-made installation flows, infrastructure provisioning, and release tooling.',
  },
  {
    title: 'Reduce ongoing operations',
    text: 'Manage customer environments from one place instead of maintaining deployment scripts for every installation.',
  },
  {
    title: 'Keep costs predictable',
    text: `Your first customer environment costs $${estimate(1)}/month in Deployz fees. Three cost $${estimate(3)}/month.`,
  },
];

const questions = [
  {
    question: 'What is a billable customer environment?',
    answer:
      "One Deployz-managed deployment of your app in a customer's AWS account that has become ready and has not started removal. Test deployments in your own account are not billable.",
  },
  {
    question: 'Are AWS costs included?',
    answer:
      'No. AWS bills the AWS account owner directly. For a customer environment, that is your customer.',
  },
  {
    question: 'What happens if a payment fails or I cancel?',
    answer:
      'Existing customer environments keep running, and you can still update, roll back, and remove them. You cannot start new customer deployments until your subscription is active again. Manage invoices, payment details, and cancellation in the Paddle billing portal.',
  },
  {
    question: 'Do costs continue after I remove an environment?',
    answer:
      'The Deployz charge stops when removal starts. Removal keeps the database and the S3 bucket, and they continue to cause AWS charges until someone deletes them.',
  },
];
---

<Base
  title="Deployz Pricing — $49/month + $19 per Customer Environment"
  description="Free evaluation with no card. Then $49 a month plus $19 a month per billable customer environment. AWS bills infrastructure costs separately."
>
  <!-- P1. Hero -->
  <PageHeader eyebrow="Pricing" title="Private deployments. Small-team pricing.">
    Evaluate for free. Pay when you’re ready to deploy for customers.
  </PageHeader>

  <!-- P2. Plan -->
  <Section labelledby="plan-title">
    <div class="overflow-hidden rounded-xl border border-border-strong bg-background">
      <div class="grid grid-cols-[minmax(0,1fr)] lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)]">
        <div class="px-6 py-8 sm:px-8">
          <h2 id="plan-title" class="text-[18px] font-semibold tracking-[-0.01em]">One simple plan</h2>
          <p class="mt-6 flex flex-wrap items-baseline gap-x-2">
            <span class="text-[64px] leading-none font-semibold tracking-[-0.04em] tabular-nums sm:text-[80px]">${BASE_PRICE}</span>
            <span class="text-[18px] text-muted-foreground">/ month</span>
          </p>
          <p class="mt-4 text-[18px]">
            + <span class="font-semibold tabular-nums">${ENVIRONMENT_PRICE}</span> / billable customer environment / month
          </p>
          <a class="btn btn-primary btn-lg mt-8 w-full sm:w-auto" href={SIGNUP_URL} data-cta="pricing-plan">{CTA_LABEL}</a>
        </div>
        <div class="border-t border-border px-6 py-8 sm:px-8 lg:border-t-0 lg:border-l">
          <h3 class="text-[16px] font-semibold">Free evaluation</h3>
          <ul class="mt-3 grid gap-1">
            {free.map((item) => (
              <li class="flex items-start gap-2.5 py-1 text-[15px] text-muted-foreground">
                <svg aria-hidden="true" viewBox="0 0 16 16" class="mt-[5px] size-4 shrink-0 text-foreground" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8.5l3 3 7-7" /></svg>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>

    <h3 class="mt-14 text-[18px] font-semibold tracking-[-0.01em]">Included</h3>
    <ul class="mt-4 grid border-b border-border sm:grid-cols-2 sm:gap-x-10">
      {included.map((item) => (
        <li class="flex items-start gap-3 border-t border-border py-3 text-[15px]">
          <svg aria-hidden="true" viewBox="0 0 16 16" class="mt-[4px] size-4 shrink-0 text-foreground" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8.5l3 3 7-7" /></svg>
          <span>{item}</span>
        </li>
      ))}
    </ul>
  </Section>

  <!-- P3. Cost estimator -->
  <Section divider labelledby="estimate-title">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-16">
      <div>
        <h2 id="estimate-title" class="text-h2">Estimate your monthly cost.</h2>
        <p class="mt-5 max-w-[440px] text-muted-foreground">
          Before you subscribe, Deployz costs $0. After you subscribe, choose the number of billable customer
          environments.
        </p>
      </div>
      <div data-estimator class="min-w-0 rounded-xl border border-border-strong p-6 sm:p-8">
        <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
          <label for="environments" class="text-[16px] font-semibold">Billable customer environments</label>
          <span data-estimator-count class="text-[22px] font-semibold tabular-nums">{DEFAULT_ENVIRONMENTS}</span>
        </div>
        <input
          id="environments"
          type="range"
          min="0"
          max={MAX_ENVIRONMENTS}
          step="1"
          value={DEFAULT_ENVIRONMENTS}
          data-base={BASE_PRICE}
          data-environment={ENVIRONMENT_PRICE}
          aria-describedby="estimate-formula"
          class="estimator-range mt-4 w-full"
        />
        <div class="mt-1 flex justify-between text-[13px] text-subtle" aria-hidden="true"><span>0</span><span>{MAX_ENVIRONMENTS}</span></div>
        <div class="mt-8 border-t border-border pt-6">
          <p class="text-[14px] text-muted-foreground">Estimated Deployz charges / month, with an active subscription</p>
          <output for="environments" data-estimator-total aria-live="polite" aria-atomic="true" class="mt-1 block text-[48px] leading-none font-semibold tracking-[-0.03em] tabular-nums">
            ${estimate(DEFAULT_ENVIRONMENTS)}
          </output>
          <p id="estimate-formula" class="mt-4 text-[15px] text-muted-foreground">
            ${BASE_PRICE} + ${ENVIRONMENT_PRICE} × billable environments. Excludes AWS charges and taxes.
          </p>
        </div>
      </div>
    </div>
  </Section>

  <!-- P4. Value -->
  <Section divider labelledby="value-title">
    <h2 id="value-title" class="text-h2 max-w-[780px]">Build your product. Skip the deployment platform.</h2>
    <p class="text-lead mt-5 max-w-[650px] text-muted-foreground">
      Private deployments shouldn’t require a dedicated DevOps hire or months of infrastructure work.
    </p>
    <div class="mt-10 lg:mt-12">
      <BuildVsBuyDiagram />
    </div>
    <ul class="mt-12 grid gap-10 md:grid-cols-3 md:gap-8 lg:mt-14 lg:gap-12">
      {benefits.map((item) => (
        <li class="border-t border-foreground pt-5">
          <h3 class="text-[18px] leading-snug font-semibold tracking-[-0.01em]">{item.title}</h3>
          <p class="mt-2 text-muted-foreground">{item.text}</p>
        </li>
      ))}
    </ul>
    <p class="text-h3 mt-12 max-w-[780px] lg:mt-14">Your next big deal shouldn’t need a bigger team.</p>
  </Section>

  <!-- P5. Billing questions -->
  <Section divider labelledby="billing-title">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,4fr)_minmax(0,8fr)] lg:gap-16">
      <h2 id="billing-title" class="text-h2 max-w-[440px]">Billing questions</h2>
      <FaqList items={questions} class="max-w-[760px]" />
    </div>
  </Section>

  <!-- P6. Final CTA -->
  <CtaSection title="Start with a free readiness report." cta="pricing-closing">
    No card needed until you subscribe.
  </CtaSection>
</Base>

<style>
  :global(html:not(.js)) .estimator-range {
    display: none;
  }

  .estimator-range {
    height: 44px;
    accent-color: var(--foreground);
    cursor: pointer;
  }
</style>

<script is:inline>
  (function () {
    var root = document.querySelector('[data-estimator]');
    if (!root) return;
    var input = root.querySelector('input');
    var count = root.querySelector('[data-estimator-count]');
    var total = root.querySelector('[data-estimator-total]');
    var base = Number(input.dataset.base);
    var perEnvironment = Number(input.dataset.environment);

    function update() {
      var environments = Number(input.value);
      count.textContent = String(environments);
      total.textContent = '$' + (base + perEnvironment * environments);
    }

    input.addEventListener('input', update);
    update();
  })();
</script>
