---
import { ArrowRight } from 'lucide-react';
import FleetDiagram from '@/components/site/diagram/FleetDiagram.astro';
import CtaSection from '@/components/site/CtaSection.astro';
import PageHeader from '@/components/site/PageHeader.astro';
import Section from '@/components/site/Section.astro';
import Base from '../layouts/Base.astro';

const cases = [
  {
    id: 'customer-owned-infrastructure',
    quote: 'We need your software in our AWS account.',
    text: 'The customer owns and administers the AWS account. Deployz deploys and manages your app there, and you keep your hosted SaaS for everyone else.',
  },
  {
    id: 'customer-hosted-data',
    quote: 'Our application data needs to stay in our environment.',
    text: "The database, cache, and S3 storage run in the customer's account. Your app's integrations and external data flows still depend on your design. Traffic to the default deployz.dev URL passes through the Deployz proxy; with a custom domain, it goes directly to the customer's load balancer.",
  },
  {
    id: 'updates-after-installation',
    quote: 'How will you keep our installation up to date?',
    text: 'You choose when each customer gets a new release, see the status of every installation, and can roll back. Installations do not update automatically.',
  },
];
---

<Base
  title="Deployz Use Cases — Customer-Hosted SaaS"
  description="Answer customers who need your SaaS in their own AWS account: customer-owned infrastructure, customer-hosted data, and managed updates."
>
  <!-- U1. Hero -->
  <PageHeader eyebrow="Use cases" title="When a customer needs your SaaS in their own AWS.">
    Deploy to every customer's account with the same process, instead of a custom project for each deal.
    <FleetDiagram slot="aside" />
  </PageHeader>

  <!-- U2. Customer requests -->
  <Section label="Customer requests">
    <ul>
      {cases.map((item, index) => (
        <li
          id={item.id}
          class:list={[
            'grid scroll-mt-24 grid-cols-[minmax(0,1fr)] gap-5 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-16',
            index > 0 && 'mt-12 border-t border-border pt-12 lg:mt-16 lg:pt-16',
          ]}
        >
          <h2 class="text-h2 max-w-[520px] wrap-break-word">“{item.quote}”</h2>
          <p class="text-lead max-w-[640px] text-muted-foreground lg:pt-2">{item.text}</p>
        </li>
      ))}
    </ul>
  </Section>

  <!-- U3. Who Deployz is for -->
  <Section divider labelledby="fit-title">
    <div class="max-w-[780px]">
      <h2 id="fit-title" class="text-h2">Built for SaaS vendors, not general AWS hosting.</h2>
      <p class="text-lead mt-5 text-muted-foreground">
        Deployz does not support on-premises, other clouds, or every app. Check compatibility before you
        promise a customer a private installation.
      </p>
      <a class="link-arrow mt-6" href="/how-it-works/#compatibility">Check compatibility <ArrowRight className="size-4" aria-hidden="true" /></a>
    </div>
  </Section>

  <CtaSection title="Have a customer asking for their own AWS?" cta="use-cases-closing">
    Connect GitHub and see what your app needs.
  </CtaSection>
</Base>
