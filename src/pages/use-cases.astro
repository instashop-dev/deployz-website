---
import { ArrowRight } from 'lucide-react';
import FleetDiagram from '@/components/site/diagram/FleetDiagram.astro';
import CtaSection from '@/components/site/CtaSection.astro';
import PageHeader from '@/components/site/PageHeader.astro';
import Section from '@/components/site/Section.astro';
import Base from '../layouts/Base.astro';

const cases = [
  {
    id: 'saas-teams',
    audience: 'Small SaaS team',
    title: 'Focus on features, not infrastructure.',
    situation: 'A customer will sign only if your app runs in their AWS account. Your team has no DevOps engineer.',
    outcome: 'Connect GitHub, fix what the readiness report flags, build a release, and send an installation link. Deployz sets up the network, containers, database, and HTTPS in their account.',
    points: ['One release process for every customer', 'No dedicated DevOps hire to start'],
  },
  {
    id: 'indie-developers',
    audience: 'Indie developer',
    title: 'Ship more, manage less.',
    situation: 'You run your SaaS alone. A larger customer wants a dedicated install in their own AWS account.',
    outcome: 'Test the deployment for free in your own AWS account, then send the installation link. Start updates and rollbacks from Deployz.',
    points: ['Free readiness report and test deployment', 'Pay only when you deploy for customers'],
  },
  {
    id: 'ai-product-builders',
    audience: 'AI product builder',
    title: 'Your AI app. Their AWS.',
    situation: "Your AI app processes customer documents. The customer's security team wants the app and its data in their account.",
    outcome: "Deploy the app with its database and S3 storage in their account. Per-customer secrets, such as model API keys, go to their Secrets Manager. Your app still calls the model APIs you choose.",
    points: ['PostgreSQL 16 or MySQL 8.0, and S3 for documents', "Secrets in the customer's Secrets Manager"],
  },
  {
    id: 'ai-agent-developers',
    audience: 'AI agent developer',
    title: 'Build the agent. Skip the deployment plumbing.',
    situation: 'Your agent has an API and background workers. Each customer wants it running in their own AWS account.',
    outcome: 'Ship one container image. Deployz runs the API and the workers as separate services, with a Redis-compatible cache. Agents call hosted model APIs over outbound HTTPS.',
    points: ['Background workers from the same image', 'No GPU or self-hosted models'],
  },
];

const builds = [
  {
    id: 'customer-hosted-saas',
    title: 'Customer-hosted SaaS',
    text: 'Offer an install in the customer’s AWS account next to your hosted SaaS.',
  },
  {
    id: 'dedicated-environments',
    title: 'Dedicated environments',
    text: 'Give each customer their own app, database, and network, updated on your schedule.',
  },
  {
    id: 'data-sensitive-applications',
    title: 'Data-sensitive applications',
    text: "Keep the database, cache, and files in the customer's account. Your integrations still decide where other data goes.",
  },
];

const goodFit = [
  'You sell B2B software and some customers need it in their own AWS account',
  'Your app ships as one container image from a Dockerfile',
  'You want the same release process for every customer',
];

const notFit = [
  'Customers need on-premises or another cloud',
  'Your app needs Kubernetes, serverless, GPUs, or several separate images',
  'You must deploy into an existing customer VPC',
];
---

<Base
  title="Deployz Use Cases — Deploying Into Customer AWS"
  description="How small SaaS teams, indie developers, AI product builders, and AI agent developers can use Deployz to deploy into customer AWS accounts."
>
  <!-- C1. Hero -->
  <PageHeader eyebrow="Use cases" title="How small teams deploy into customer AWS.">
    Four common requests, and how Deployz handles each. These are example scenarios, not named customer
    stories.
    <FleetDiagram slot="aside" />
  </PageHeader>

  <!-- C2. Use cases -->
  <Section labelledby="cases-title">
    <h2 id="cases-title" class="sr-only">Use cases</h2>
    <ul>
      {cases.map((item, index) => (
        <li
          id={item.id}
          class:list={[
            'grid scroll-mt-24 grid-cols-[minmax(0,1fr)] gap-6 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-16',
            index > 0 && 'mt-14 lg:mt-20',
          ]}
        >
          <div>
            <p class="text-[14px] text-subtle">{item.audience}</p>
            <h3 class="text-h3 mt-1 max-w-[440px]">{item.title}</h3>
          </div>
          <div class="min-w-0">
            <dl class="grid gap-5">
              <div>
                <dt class="text-[14px] font-semibold">The situation</dt>
                <dd class="mt-1 text-muted-foreground">{item.situation}</dd>
              </div>
              <div>
                <dt class="text-[14px] font-semibold">With Deployz</dt>
                <dd class="mt-1 text-muted-foreground">{item.outcome}</dd>
              </div>
            </dl>
            <ul class="mt-5 grid gap-2">
              {item.points.map((point) => (
                <li class="flex items-start gap-3 text-[15px]">
                  <svg aria-hidden="true" viewBox="0 0 16 16" class="mt-[5px] size-4 shrink-0 text-foreground" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8.5l3 3 7-7" /></svg>
                  <span>{point}</span>
                </li>
              ))}
            </ul>
          </div>
        </li>
      ))}
    </ul>
  </Section>

  <!-- C3. What you can build -->
  <Section labelledby="build-title">
    <div class="grid grid-cols-[minmax(0,1fr)] gap-10 lg:grid-cols-[minmax(0,4fr)_minmax(0,8fr)] lg:gap-16">
      <h2 id="build-title" class="text-h2 max-w-[440px]">What you can build</h2>
      <dl class="border-b border-border">
        {builds.map((row) => (
          <div id={row.id} class="grid scroll-mt-24 gap-1 border-t border-border py-5 sm:grid-cols-[220px_minmax(0,1fr)] sm:gap-x-8">
            <dt class="font-semibold">{row.title}</dt>
            <dd class="text-muted-foreground">{row.text}</dd>
          </div>
        ))}
      </dl>
    </div>
  </Section>

  <!-- C4. Fit -->
  <Section labelledby="fit-title">
    <div class="grid grid-cols-[minmax(0,1fr)] gap-10 lg:grid-cols-[minmax(0,4fr)_minmax(0,8fr)] lg:gap-16">
      <div>
        <h2 id="fit-title" class="text-h2">Is Deployz right for you?</h2>
        <p class="mt-5 max-w-[440px] text-muted-foreground">
          Deployz is built for software vendors, not general AWS hosting. Check compatibility before you
          promise a customer a private installation.
        </p>
        <a class="link-arrow mt-6" href="/how-it-works/#compatibility">Check compatibility <ArrowRight className="size-4" aria-hidden="true" /></a>
      </div>
      <div class="grid gap-10 sm:grid-cols-2 sm:gap-8">
        <div>
          <h3 class="text-[16px] font-semibold">A good fit when</h3>
          <ul class="mt-4 border-b border-border">
            {goodFit.map((item) => (
              <li class="flex items-start gap-3 border-t border-border py-3">
                <svg aria-hidden="true" viewBox="0 0 16 16" class="mt-[5px] size-4 shrink-0 text-foreground" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8.5l3 3 7-7" /></svg>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
        <div>
          <h3 class="text-[16px] font-semibold">Not a fit when</h3>
          <ul class="mt-4 border-b border-border">
            {notFit.map((item) => (
              <li class="flex items-start gap-3 border-t border-border py-3 text-muted-foreground">
                <svg aria-hidden="true" viewBox="0 0 16 16" class="mt-[5px] size-4 shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M3.5 8h9" /></svg>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </Section>

  <CtaSection title="Have a customer asking for their own AWS?" cta="use-cases-closing">
    Connect GitHub and see what your app needs.
  </CtaSection>
</Base>
