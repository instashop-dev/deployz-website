---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/site/PageHeader.astro';

const toc = [
  { href: '#getting-started', label: 'Getting started' },
  { href: '#requirements', label: 'Requirements' },
  { href: '#supported-architecture', label: 'Supported architecture' },
];

const steps = [
  { title: 'Connect your application.', body: 'Connect GitHub and select the repository. Deployz analyzes it and shows what is ready and what you must change.' },
  { title: 'Send an installation link.', body: 'Build a release, then send the link. The customer uses it to install your product in their AWS account.' },
  { title: 'Operate.', body: 'Release updates, view status, and diagnose failures from Deployz.' },
];

const architecture = [
  { term: 'Application', desc: 'One Linux web or API container, built from the Dockerfile in your repository. CPU workloads only.' },
  { term: 'AWS regions', desc: 'Each customer environment runs in one AWS region from the Deployz region list.' },
  { term: 'PostgreSQL', desc: 'Optional. One encrypted Amazon RDS for PostgreSQL 16 instance in private subnets, with automated backups kept for 7 days.' },
  { term: 'Redis', desc: 'Optional. One Redis-compatible cache node (Amazon ElastiCache for Valkey). TLS connections, cluster mode, and Redis Stack modules are not currently supported.' },
  { term: 'File storage', desc: 'One encrypted, versioned Amazon S3 bucket. Deployz provides object storage, not attachable disk volumes.' },
  { term: 'HTTPS and custom domains', desc: 'Each deployment gets an HTTPS URL on a deployz.dev subdomain with no DNS work. A custom domain is optional. You or your customer add the DNS records, and the default URL stays available.' },
  { term: 'Networking', desc: 'Deployz creates a new, dedicated network for each customer environment. The database and cache run in private subnets.' },
  { term: 'Health checks', desc: 'Your application must expose an HTTP health-check endpoint. A deployment becomes ready only after its health check passes.' },
  { term: 'Updates and rollback', desc: 'You start each update. If a new version fails its health checks, the previous version continues to run. You can also redeploy an earlier successful release. Database migrations are not reversed.' },
  { term: 'Removal', desc: 'Disconnect removes the application resources and keeps the database, its credentials, and the stored files. Purge is a separate, confirmed step that permanently deletes the retained data. The customer removes the connector in its own AWS console.' },
];

const unsupported = [
  'Cloud providers other than AWS',
  'Kubernetes and serverless applications',
  'Deployment into an existing customer VPC',
  'Background workers and scheduled jobs',
  'Applications with more than one service',
  'Databases other than PostgreSQL, such as MySQL, MongoDB, and SQLite',
  'Message brokers, such as Kafka and RabbitMQ',
  'Attachable persistent disk volumes',
  'GPU workloads',
];
---

<Base title="Documentation — Deployz" description="Get started with Deployz and review the requirements for customer-owned AWS deployments.">
  <PageHeader eyebrow="Documentation" title="Documentation">
    Deployz deploys your application inside each customer's AWS account.
  </PageHeader>

  <div class="container-site pt-8 pb-20 sm:pb-24 lg:grid lg:grid-cols-[200px_minmax(0,720px)] lg:justify-between lg:gap-16 lg:pt-14 lg:pb-32">
    <nav aria-label="On this page" class="mb-10 border-b border-border pb-3 lg:sticky lg:top-24 lg:mb-0 lg:self-start lg:border-b-0 lg:pb-0">
      <p class="text-eyebrow mb-2 text-subtle">On this page</p>
      <ul class="flex flex-wrap gap-x-6 lg:flex-col lg:gap-x-0">
        {toc.map((item) => (
          <li>
            <a href={item.href} class="flex min-h-11 items-center text-[15px] text-muted-foreground transition-[color] duration-150 hover:text-brand">{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="min-w-0 text-[16px] leading-[1.65]">
      <section id="getting-started" class="scroll-mt-24">
        <h2 class="text-[26px] leading-tight font-semibold tracking-[-0.025em] sm:text-[28px]">Getting started</h2>
        <ol class="mt-6 border-b border-border">
          {steps.map((s, i) => (
            <li class="grid grid-cols-[2.25rem_minmax(0,1fr)] gap-x-2 border-t border-border py-5">
              <span class="pt-px text-[14px] font-medium text-subtle tabular-nums">{String(i + 1).padStart(2, '0')}</span>
              <p class="text-muted-foreground"><strong class="font-semibold text-foreground">{s.title}</strong> {s.body}</p>
            </li>
          ))}
        </ol>
      </section>

      <section id="requirements" class="mt-16 scroll-mt-24 sm:mt-20">
        <h2 class="text-[26px] leading-tight font-semibold tracking-[-0.025em] sm:text-[28px]">Requirements</h2>
        <ul class="mt-6 grid list-disc gap-3 pl-5 text-muted-foreground marker:text-subtle">
          <li>Each customer needs an AWS account.</li>
          <li>The application must use the supported deployment architecture.</li>
        </ul>
      </section>

      <section id="supported-architecture" class="mt-16 scroll-mt-24 sm:mt-20">
        <h2 class="text-[26px] leading-tight font-semibold tracking-[-0.025em] sm:text-[28px]">Supported architecture</h2>
        <p class="mt-4 text-muted-foreground">
          Deployz supports one application architecture on AWS. An application that fits this
          architecture can use the full workflow.
        </p>
        <dl class="mt-8 border-b border-border">
          {architecture.map((row) => (
            <div class="grid gap-1 border-t border-border py-5 sm:grid-cols-[170px_minmax(0,1fr)] sm:gap-x-8">
              <dt class="text-[15px] font-semibold text-foreground">{row.term}</dt>
              <dd class="text-[15px] leading-[1.6] text-muted-foreground">{row.desc}</dd>
            </div>
          ))}
        </dl>

        <h3 class="mt-12 text-[18px] font-semibold tracking-[-0.01em]">Not currently supported</h3>
        <ul class="mt-4 border-b border-border">
          {unsupported.map((item) => (
            <li class="border-t border-border py-3 text-[15px] text-muted-foreground">{item}</li>
          ))}
        </ul>
      </section>
    </div>
  </div>
</Base>
