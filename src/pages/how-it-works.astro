---
import { ArrowRight } from 'lucide-react';
import GuardrailsDiagram from '@/components/site/diagram/GuardrailsDiagram.astro';
import InfraDiagram from '@/components/site/diagram/InfraDiagram.astro';
import InstallDiagram from '@/components/site/diagram/InstallDiagram.astro';
import JourneyDiagram from '@/components/site/diagram/JourneyDiagram.astro';
import CtaSection from '@/components/site/CtaSection.astro';
import PageHeader from '@/components/site/PageHeader.astro';
import Section from '@/components/site/Section.astro';
import SectionHeading from '@/components/site/SectionHeading.astro';
import { CTA_LABEL, SIGNUP_URL } from '@/lib/site';
import Base from '../layouts/Base.astro';

const reportGroups = [
  { title: 'Passed', text: 'Checks your app already meets.' },
  { title: 'Needs input', text: 'Values you must provide, such as environment variables.' },
  { title: 'Blockers', text: 'Changes your app needs before it can deploy.' },
];

const connection = [
  { title: 'Open the installation link', text: 'They see the resources, an AWS cost estimate, and every IAM action requested.' },
  { title: 'Launch the connector', text: 'They create it as a CloudFormation stack in their own AWS console.' },
  { title: 'Deployz deploys the release', text: "The app and its resources are created in the customer's account." },
];

const guardrails = [
  {
    term: 'Checks first',
    desc: 'Rule-based detectors read your Dockerfile, package files, and configuration: runtime, port, health check, environment variables, database, cache, storage, and workers.',
  },
  {
    term: 'AI for open questions',
    desc: 'When the checks leave a question open, such as an unclear start command, AI reads a few relevant files. Values that look like secrets are redacted first.',
  },
  {
    term: 'Strict limits on AI',
    desc: 'AI answers must match a strict schema and only fill gaps. They never replace a value the checks found, and lower-confidence answers stay suggestions.',
  },
  {
    term: 'Clear labels',
    desc: 'Each detected value shows its source. AI values are marked “Inferred by AI analysis — verify before relying on it.”',
  },
  {
    term: 'Your review',
    desc: 'You check what Deployz detected, enter the values it needs, and override anything before you build a release.',
  },
  {
    term: 'Rule-based deployment',
    desc: "Deployz's own compiler turns the configuration into CloudFormation. It can create only supported AWS resources, in a fixed size profile. Preflight checks use no AI.",
  },
];

const infrastructure = [
  { need: 'Web or API service', aws: 'Amazon ECS on Fargate, behind an Application Load Balancer' },
  { need: 'Background workers', aws: 'Separate ECS services from the same image' },
  { need: 'Database', aws: 'Amazon RDS for PostgreSQL 16 or MySQL 8.0' },
  { need: 'Cache', aws: 'Amazon ElastiCache (Valkey, Redis-compatible)' },
  { need: 'File storage', aws: 'Amazon S3 bucket' },
  { need: 'Secrets', aws: 'AWS Secrets Manager in the customer account' },
  { need: 'Network', aws: 'A new, dedicated VPC' },
  { need: 'HTTPS', aws: 'AWS Certificate Manager, for the default URL or a custom domain' },
];

const lifecycle = [
  { title: 'Releases', text: 'Each customer runs the release you select.' },
  { title: 'Status', text: 'See the progress and health of every customer environment.' },
  { title: 'Updates and rollbacks', text: 'You start each update. If the new version fails its health check, the previous one keeps running. A rollback does not reverse database migrations.' },
  { title: 'Removal', text: 'Remove a deployment, then delete its retained data as a separate step.' },
];

const goodFit = [
  'One Linux x86-64 container image, built from your Dockerfile',
  'A web or API service with an HTTP health check',
  'Optional background workers from the same image',
  'Optional PostgreSQL 16 or MySQL 8.0',
  'Optional Redis-compatible cache',
  'S3 file storage',
  'HTTPS, with an optional custom domain',
  'A new, dedicated network in the customer AWS account',
];

const notSupported = [
  'Services that need separate images',
  'Databases other than PostgreSQL and MySQL',
  'Message brokers such as Kafka or RabbitMQ',
  'Existing customer VPCs',
  'Other clouds or on-premises',
  'Kubernetes or serverless apps',
  'GPU workloads or ARM64 images',
  'Attachable disk volumes',
];
---

<Base
  title="How Deployz Works — From GitHub to Customer AWS"
  description="Connect GitHub, review what AI-assisted analysis finds, build a release, and deploy into customer AWS with rule-based guardrails. See each step and what Deployz supports."
>
  <!-- W1. Hero -->
  <PageHeader eyebrow="How it works" title="From GitHub to your customer's AWS in four steps.">
    You prepare a release once. Each customer approves access in their own AWS account, and Deployz
    deploys and updates it there.
    <a slot="actions" class="btn btn-primary btn-lg" href={SIGNUP_URL} data-cta="hiw-hero">{CTA_LABEL}</a>
    <JourneyDiagram slot="visual" />
  </PageHeader>


  <!-- W2. Step 1 -->
  <Section id="ai-guardrails" labelledby="connect-title">
    <div class="grid grid-cols-[minmax(0,1fr)] gap-10 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-16">
      <div>
        <p class="mb-4 inline-flex min-h-7 items-center rounded-full border border-brand-border bg-brand-subtle px-3 text-[13px] font-semibold text-brand-hover">Step 1</p>
        <h2 id="connect-title" class="text-h2">Connect GitHub and analyze your repo</h2>
        <p class="mt-5 max-w-[520px] text-muted-foreground">
          Deployz reads your repository with read-only access and reports what your app needs.
        </p>
        <p class="mt-6 max-w-[520px] text-[18px] leading-snug font-semibold tracking-[-0.01em]">
          AI for understanding. Guardrails for deploying.
        </p>
        <p class="mt-2 max-w-[520px] text-[15px] text-muted-foreground">
          AI does not write your infrastructure, and it does not guarantee that your app is correct or secure.
        </p>
      </div>
      <dl class="min-w-0 border-b border-border">
        {guardrails.map((row) => (
          <div class="grid gap-1 border-t border-border py-4 sm:grid-cols-[180px_minmax(0,1fr)] sm:gap-x-8">
            <dt class="font-semibold">{row.term}</dt>
            <dd class="text-muted-foreground">{row.desc}</dd>
          </div>
        ))}
      </dl>
    </div>
    <div class="mt-12 lg:mt-14">
      <GuardrailsDiagram />
    </div>
  </Section>

  <!-- W3. Step 2 -->
  <Section labelledby="review-title">
    <div class="max-w-[780px]">
      <p class="mb-4 inline-flex min-h-7 items-center rounded-full border border-brand-border bg-brand-subtle px-3 text-[13px] font-semibold text-brand-hover">Step 2</p>
      <h2 id="review-title" class="text-h2">Configure and build a release</h2>
      <p class="text-lead mt-5 text-muted-foreground">
        Review what Deployz detected, fill in what the report asks for, and fix any blockers. Then build a
        versioned release from a commit.
      </p>
    </div>
    <ul class="mt-10 grid gap-10 md:grid-cols-3 md:gap-8 lg:gap-12">
      {reportGroups.map((group) => (
        <li class="border-t border-foreground pt-5">
          <h3 class="text-[18px] font-semibold tracking-[-0.01em]">{group.title}</h3>
          <p class="mt-2 text-muted-foreground">{group.text}</p>
        </li>
      ))}
    </ul>
    <p class="mt-10 max-w-[720px] text-[15px] text-muted-foreground">
      The report is advisory and can miss behavior in your code. For a blocker, Deployz can write fix
      instructions for your own coding tool; it never changes your repository. You can also run one free test
      deployment in your own AWS account.
    </p>
  </Section>

  <!-- W4. Step 3 -->
  <Section labelledby="install-title">
    <div class="grid grid-cols-[minmax(0,1fr)] gap-10 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-16">
      <div>
        <p class="mb-4 inline-flex min-h-7 items-center rounded-full border border-brand-border bg-brand-subtle px-3 text-[13px] font-semibold text-brand-hover">Step 3</p>
        <h2 id="install-title" class="text-h2">Your customer connects AWS</h2>
        <p class="mt-5 max-w-[520px] text-muted-foreground">
          Send each customer an installation link. They do not need a Deployz account. Customers can
          install only while your subscription is active.
        </p>
        <a class="link-arrow mt-6" href="/security/#aws-access">How AWS access works <ArrowRight className="size-4" aria-hidden="true" /></a>
      </div>
      <ol class="min-w-0 max-w-[640px]" aria-label="What your customer does">
        {connection.map((item, index) => (
          <li class="flow-step grid grid-cols-[32px_minmax(0,1fr)] gap-x-5 pb-8 last:pb-0">
            <span class:list={['flow-node', index === 2 && 'flow-node-brand']}>{index + 1}</span>
            <div class="min-w-0">
              <h3 class="text-[17px] leading-8 font-semibold">{item.title}</h3>
              <p class="mt-1 text-muted-foreground">{item.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
    <div class="mt-12 lg:mt-14">
      <InstallDiagram />
    </div>
  </Section>

  <!-- W5. Step 4 -->
  <Section labelledby="manage-title">
    <div class="max-w-[780px]">
      <p class="mb-4 inline-flex min-h-7 items-center rounded-full border border-brand-border bg-brand-subtle px-3 text-[13px] font-semibold text-brand-hover">Step 4</p>
      <h2 id="manage-title" class="text-h2">Deploy and manage updates</h2>
      <p class="text-lead mt-5 text-muted-foreground">
        Deployz's rule-based compiler creates the supported AWS infrastructure. Deployz then deploys the
        release and marks the environment ready when its health check passes.
      </p>
    </div>
    <ul class="mt-10 grid gap-10 md:grid-cols-2 md:gap-8 lg:grid-cols-4 lg:gap-10">
      {lifecycle.map((item) => (
        <li class="border-t border-foreground pt-5">
          <h3 class="text-[18px] font-semibold tracking-[-0.01em]">{item.title}</h3>
          <p class="mt-2 text-muted-foreground">{item.text}</p>
        </li>
      ))}
    </ul>
  </Section>

  <!-- W6. Infrastructure -->
  <Section labelledby="infra-title">
    <SectionHeading id="infra-title" title="What Deployz creates in customer AWS">
      Only the parts your app needs, from one supported architecture. Your customer owns every resource.
    </SectionHeading>
    <div class="mt-10 lg:mt-12">
      <InfraDiagram />
    </div>
    <dl class="mt-10 grid border-b border-border sm:grid-cols-2 sm:gap-x-10 lg:mt-12">
      {infrastructure.map((row) => (
        <div class="grid gap-1 border-t border-border py-4">
          <dt class="font-semibold">{row.need}</dt>
          <dd class="text-[15px] text-muted-foreground">{row.aws}</dd>
        </div>
      ))}
    </dl>
  </Section>

  <!-- W7. Compatibility -->
  <Section id="compatibility" labelledby="fit-title">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,4fr)_minmax(0,8fr)] lg:gap-16">
      <div>
        <h2 id="fit-title" class="text-h2">Will Deployz work with my app?</h2>
        <p class="mt-5 max-w-[440px] text-muted-foreground">
          Deployz supports one application architecture on AWS. Some apps need code changes first.
        </p>
        <a class="link-arrow mt-6" href="/docs/#supported-architecture">Technical requirements <ArrowRight className="size-4" aria-hidden="true" /></a>
      </div>
      <div class="grid gap-10 sm:grid-cols-2 sm:gap-8">
        <div>
          <h3 class="text-[16px] font-semibold">Supported</h3>
          <ul class="mt-4 border-b border-border">
            {goodFit.map((item) => (
              <li class="flex items-start gap-3 border-t border-border py-3">
                <svg aria-hidden="true" viewBox="0 0 16 16" class="mt-[5px] size-4 shrink-0 text-foreground" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8.5l3 3 7-7" /></svg>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
        <div>
          <h3 class="text-[16px] font-semibold">Not supported</h3>
          <ul class="mt-4 border-b border-border">
            {notSupported.map((item) => (
              <li class="flex items-start gap-3 border-t border-border py-3 text-muted-foreground">
                <svg aria-hidden="true" viewBox="0 0 16 16" class="mt-[5px] size-4 shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M3.5 8h9" /></svg>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </Section>

  <CtaSection title="See what Deployz finds in your app." cta="hiw-closing">
    Connect GitHub for a free readiness report.
  </CtaSection>
</Base>

<style>
  .flow-step {
    position: relative;
  }

  .flow-step:not(:last-child)::before {
    content: '';
    position: absolute;
    left: 15.5px;
    top: 40px;
    bottom: 8px;
    width: 1px;
    background: var(--border-strong);
  }

  .flow-node {
    position: relative;
    z-index: 1;
    display: flex;
    height: 32px;
    width: 32px;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--border-strong);
    border-radius: 9999px;
    background: var(--background);
    font-size: 14px;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }

  .flow-node-brand {
    border-color: var(--brand);
    background: var(--brand-subtle);
    color: var(--brand-hover);
  }
</style>
