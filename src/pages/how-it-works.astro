---
import { ArrowRight } from 'lucide-react';
import PageHeader from '@/components/site/PageHeader.astro';
import Section from '@/components/site/Section.astro';
import Base from '../layouts/Base.astro';

const supported = [
  'One web or API container',
  'PostgreSQL 16',
  'Redis-compatible cache',
  'S3 file storage',
  'HTTPS and custom domains',
  'A dedicated network for each customer',
  'No Kubernetes',
];

const steps = [
  { actor: 'You', deployz: false, timing: '', title: 'Connect your repository', text: 'Connect GitHub and select the repository. The access is read-only.' },
  { actor: 'Deployz', deployz: true, timing: 'usually a few minutes', title: 'Get the readiness report', text: 'You see what passed, what needs attention, and what blocks deployment.' },
  { actor: 'You', deployz: false, timing: '', title: 'Build a versioned release', text: 'Select a version number and a commit. Deployz builds the application image.' },
  { actor: 'You and your customer', deployz: false, timing: '', title: 'Send your customer one link', text: 'The customer reviews the access and connects their AWS account. They do not need a Deployz account.' },
  { actor: 'Deployz', deployz: true, timing: 'typically 20 to 45 minutes', title: 'Deploy the application', text: 'Deployz creates the AWS infrastructure and deploys the release. Both sides follow the progress in plain language.' },
  { actor: 'You', deployz: false, timing: '', title: 'Ship updates and stay in control', text: 'You start each update. If a new version fails its health checks, the previous version continues to run.' },
];

const checks = [
  'Container build configuration',
  'Application port',
  'Health-check endpoint',
  'Runtime environment variables',
  'PostgreSQL requirement',
  'Redis requirement',
  'File-storage use',
  'Build, start, and migration commands',
  'Components outside the supported architecture',
];

const youDo = [
  'Connect the repository',
  'Create releases and select the version for each customer',
  'Send the installation link',
  'Start each installation, update, rollback, and removal',
];

const customerDoes = [
  'Owns the AWS account and controls the data',
  'Reviews the access, then launches the connector',
  'Pays AWS directly for the infrastructure',
  'Can remove the connector from their AWS account',
];
---

<Base
  title="How Deployz Works — Private SaaS Deployment on AWS"
  description="Connect your repository, prepare a version, invite your customer, and deploy your SaaS into a customer-owned AWS account."
>
  <PageHeader title="One workflow for every customer deployment">
    You connect your repository one time. Then each new customer is one installation link, not a
    new infrastructure project.
    <a slot="actions" class="btn btn-primary btn-lg" href="/get-started">Check my application</a>
    <!-- Actor matrix: who acts at each step. Deployz steps are the only blue. -->
    <div slot="aside" aria-hidden="true" class="hidden lg:block">
      <div class="matrix">
        <span class="matrix-head"></span>
        <span class="matrix-head">You</span>
        <span class="matrix-head matrix-customer matrix-customer-top">Your customer</span>
        <span class="matrix-head">Deployz</span>
        {steps.map((step, index) => (
          <>
            <span class="matrix-step"><span class="matrix-num">{index + 1}</span>{step.title}</span>
            <span class="matrix-cell">{step.actor.startsWith('You') && <i class="matrix-dot" />}</span>
            <span class:list={['matrix-cell matrix-customer', index === steps.length - 1 && 'matrix-customer-bottom']}>{step.actor.includes('customer') && <i class="matrix-dot" />}</span>
            <span class="matrix-cell">{step.deployz && <i class="matrix-dot matrix-dot-brand" />}</span>
          </>
        ))}
      </div>
    </div>
  </PageHeader>

  <!-- Steps: editorial split with a vertical rail -->
  <Section labelledby="steps-title">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,4fr)_minmax(0,8fr)] lg:gap-16">
      <h2 id="steps-title" class="text-h2 max-w-[420px]">Six steps. Your customer takes part in one.</h2>
      <ol class="max-w-[720px]">
        {steps.map((step, index) => (
          <li class="step grid grid-cols-[32px_minmax(0,1fr)] gap-x-5 pb-10 last:pb-0 sm:gap-x-6">
            <span class:list={['step-node', step.deployz && 'step-node-brand']}>{index + 1}</span>
            <div class="min-w-0">
              <p class="text-[14px] leading-8 text-muted-foreground">
                <span class:list={['font-medium', step.deployz ? 'text-brand-hover' : 'text-foreground']}>{step.actor}</span>{step.timing && ` · ${step.timing}`}
              </p>
              <h3 class="text-h3 mt-1">{step.title}</h3>
              <p class="mt-2 text-muted-foreground">{step.text}</p>
              {index === 1 && (
                <details class="group mt-4 max-w-[720px] border-y border-border">
                  <summary class="flex min-h-12 cursor-pointer list-none items-center justify-between gap-6 py-3 text-[15px] font-medium text-foreground transition-[color] duration-150 hover:text-brand [&::-webkit-details-marker]:hidden">
                    <span>What the analysis checks</span>
                    <svg aria-hidden="true" viewBox="0 0 16 16" class="size-4 shrink-0 text-muted-foreground" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
                      <path d="M3 8h10" />
                      <path d="M8 3v10" class="group-open:hidden" />
                    </svg>
                  </summary>
                  <ul class="pb-3">
                    {checks.map((item) => (
                      <li class="border-t border-border py-2.5 text-[15px] text-muted-foreground first:border-t-0">{item}</li>
                    ))}
                  </ul>
                </details>
              )}
            </div>
          </li>
        ))}
      </ol>
    </div>
  </Section>

  <!-- Who does what: quiet two-column split -->
  <Section divider labelledby="roles-title">
    <h2 id="roles-title" class="text-h2">Who does what</h2>
    <div class="mt-10 grid gap-10 md:grid-cols-2 md:gap-0 lg:mt-12">
      <div class="md:pr-12 lg:pr-16">
        <h3 class="text-h3 border-t border-foreground pt-5">You</h3>
        <ul class="mt-4 border-b border-border">
          {youDo.map((item) => <li class="border-t border-border py-3 text-muted-foreground">{item}</li>)}
        </ul>
      </div>
      <div class="md:border-l md:border-border md:pl-12 lg:pl-16">
        <h3 class="text-h3 border-t border-foreground pt-5">Your customer</h3>
        <ul class="mt-4 border-b border-border">
          {customerDoes.map((item) => <li class="border-t border-border py-3 text-muted-foreground">{item}</li>)}
        </ul>
      </div>
    </div>
  </Section>

  <!-- Currently supported: spec list -->
  <Section id="currently-supported" tone="subtle" labelledby="supported-title" class="scroll-mt-8">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,4fr)_minmax(0,8fr)] lg:gap-16">
      <div>
        <h2 id="supported-title" class="text-h2">Currently supported</h2>
        <p class="mt-4 max-w-[420px] text-muted-foreground">Deployz supports one application architecture on AWS.</p>
        <a class="link-arrow mt-6" href="/docs#supported-architecture">Read the full specification <ArrowRight className="size-4" aria-hidden="true" /></a>
      </div>
      <div class="max-w-[720px]">
        <ul class="border-b border-border-strong">
          {supported.map((item) => (
            <li class="flex items-start gap-3 border-t border-border-strong py-3.5">
              <svg aria-hidden="true" viewBox="0 0 16 16" class="mt-[5px] size-4 shrink-0 text-foreground" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8.5l3 3 7-7" /></svg>
              <span>{item}</span>
            </li>
          ))}
        </ul>
        <p class="mt-8 text-muted-foreground">
          Not supported today: other cloud providers, Kubernetes, serverless, more than one
          service, background workers, other databases, message brokers, disk volumes, existing
          customer VPCs, and GPU workloads.
        </p>
      </div>
    </div>
  </Section>

  <!-- Closing CTA: open, left-aligned -->
  <section aria-labelledby="cta-title">
    <div class="container-site flex flex-col items-start justify-between gap-8 py-16 sm:py-20 lg:flex-row lg:items-center lg:gap-16 lg:py-28">
      <div class="max-w-[640px]">
        <h2 id="cta-title" class="text-h2">Is your application ready? Find out in a few minutes.</h2>
        <p class="text-lead mt-4 text-muted-foreground">The analysis is free, and no card is necessary.</p>
      </div>
      <a class="btn btn-primary btn-lg shrink-0" href="/get-started">Check my application</a>
    </div>
  </section>
</Base>

<style>
  /* Step list: numbered nodes joined by a hairline. */
  .step {
    position: relative;
  }
  .step:not(:last-child)::before {
    content: '';
    position: absolute;
    left: 15.5px;
    top: 40px;
    bottom: 8px;
    width: 1px;
    background: var(--border-strong);
  }
  .step-node {
    position: relative;
    z-index: 1;
    display: flex;
    height: 32px;
    width: 32px;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--border-strong);
    border-radius: 9999px;
    background: var(--background);
    font-size: 14px;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }
  /* Header actor matrix. */
  .matrix {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 56px 104px 64px;
    font-size: 14px;
    line-height: 1.35;
  }
  .matrix-head {
    padding: 14px 0 10px;
    font-size: 12px;
    font-weight: 600;
    color: var(--muted-foreground);
    text-align: center;
  }
  .matrix-step {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 48px;
    padding-right: 12px;
    border-top: 1px solid var(--border);
    font-weight: 500;
    color: var(--foreground);
  }
  .matrix-num {
    flex-shrink: 0;
    width: 18px;
    font-size: 13px;
    color: var(--text-subtle);
    font-variant-numeric: tabular-nums;
  }
  .matrix-cell {
    display: flex;
    align-items: center;
    justify-content: center;
    border-top: 1px solid var(--border);
  }
  .matrix-customer {
    background: var(--surface-subtle);
    border-left: 1px solid var(--border-strong);
    border-right: 1px solid var(--border-strong);
  }
  .matrix-customer-top {
    border-top: 1px solid var(--border-strong);
    border-radius: 12px 12px 0 0;
  }
  .matrix-customer-bottom {
    border-bottom: 1px solid var(--border-strong);
    border-radius: 0 0 12px 12px;
  }
  .matrix-dot {
    display: block;
    width: 10px;
    height: 10px;
    border-radius: 9999px;
    background: var(--foreground);
  }
  .matrix-dot-brand {
    width: 12px;
    height: 12px;
    background: var(--brand-subtle);
    border: 1.5px solid var(--brand);
  }
  .step-node-brand {
    border-color: var(--brand);
    background: var(--brand-subtle);
    color: var(--brand-hover);
  }
</style>
