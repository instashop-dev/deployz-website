---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/site/PageHeader.astro';
import { formatDate, getVisiblePosts, isoDate, isPublished, postUrl } from '@/lib/blog';

const posts = await getVisiblePosts();
const row = 'border-b border-border py-10 sm:py-14 lg:grid lg:grid-cols-[200px_minmax(0,720px)] lg:justify-between lg:gap-16';
---

<Base title="Blog — Deployz" description="Practical guides for delivering software to your customers' cloud.">
  <PageHeader title="Blog">
    Practical guides for delivering software to your customers' cloud.
  </PageHeader>

  <div class="container-site pb-20 sm:pb-28 lg:pb-32">
    {posts.map((post) => (
      <article class={row}>
        <p class="mb-3 text-[14px] text-subtle lg:mb-0 lg:pt-2">
          {post.data.pubDate ? <time datetime={isoDate(post.data.pubDate)}>{formatDate(post.data.pubDate)}</time> : 'Not published'}
          {!isPublished(post) && <span class="block text-foreground">Draft</span>}
        </p>
        <div class="min-w-0">
          <p class="text-eyebrow mb-2 text-muted-foreground">{post.data.category}</p>
          <h2 class="text-h3 sm:text-[26px] sm:leading-tight sm:tracking-[-0.025em]">
            <a href={postUrl(post)} class="inline-flex min-h-11 items-center transition-[color] duration-150 hover:text-brand">{post.data.title}</a>
          </h2>
          <p class="mt-4 text-[17px] leading-[1.7] text-muted-foreground">{post.data.description}</p>
        </div>
      </article>
    ))}

    <article class={row}>
      <p class="mb-3 text-[14px] text-subtle lg:mb-0 lg:pt-2"><time datetime="2026-08-25">August 25, 2026</time></p>
      <div class="min-w-0">
        <h2 class="text-h3 sm:text-[26px] sm:leading-tight sm:tracking-[-0.025em]">Introducing Deployz</h2>
        <div class="mt-6 grid gap-5 text-[17px] leading-[1.7] text-muted-foreground">
          <p>
            Small B2B software companies hear this question more and more: "Can your software run inside
            our AWS account?" Until now, the answer was a custom engineering project — infrastructure
            templates, IAM, networking, upgrades, monitoring, and a support load that grows with every
            customer.
          </p>
          <p>
            Deployz turns that project into a product feature. Connect your application, send each
            customer an installation link, and Deployz provisions supported AWS resources, deploys
            your releases, and reports their status.
          </p>
          <p>Follow this blog for product notes.</p>
        </div>
      </div>
    </article>
  </div>
</Base>
