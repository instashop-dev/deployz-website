---
import { ArrowRight } from 'lucide-react';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/site/PageHeader.astro';
import { formatDate, getVisiblePosts, isoDate, isPublished, postUrl, readingMinutes } from '@/lib/blog';

/*
 * Card summaries written for this index. They are shorter than the article descriptions, which
 * stay in the article metadata for search and social previews. A post without an entry here shows
 * its description. The order of this list also orders posts that share a publication date.
 */
const cardSummaries: Record<string, string> = {
  'saas-in-customer-aws-account': 'What to clarify before saying yes—from application readiness to costs, updates and support.',
  'ai-app-customer-cloud-data-privacy': 'Understand where documents, prompts and model responses travel, including external services and logs.',
};
const rank = (id: string) => {
  const index = Object.keys(cardSummaries).indexOf(id);
  return index === -1 ? Infinity : index;
};

// Production builds list published posts only. The local dev server also lists drafts, marked "Draft".
const posts = (await getVisiblePosts()).sort(
  (a, b) => (b.data.pubDate?.getTime() ?? Infinity) - (a.data.pubDate?.getTime() ?? Infinity) || rank(a.id) - rank(b.id),
);
const intro = 'Practical guides to deploying and running software in your customers’ AWS accounts.';
---

<Base title="The Deployz Blog — Guides for Customer-Hosted Software" description={intro}>
  <PageHeader title="The Deployz Blog">
    {intro}
  </PageHeader>

  <section aria-labelledby="latest-title" class="container-site pb-16 sm:pb-20">
    <h2 id="latest-title" class="text-h3">Latest articles</h2>

    {posts.length > 0 ? (
      <ul class="mt-6 grid gap-5 md:grid-cols-2 md:gap-6">
        {posts.map((post) => (
          <li class="group relative flex flex-col rounded-xl border border-border bg-card p-6 transition-[color,border-color] duration-150 hover:border-border-strong has-[a:focus-visible]:border-ring sm:p-8">
            <p class="text-eyebrow text-muted-foreground">
              {post.data.category}
              {!isPublished(post) && <span class="ml-2 text-foreground">Draft</span>}
            </p>
            <h3 class="mt-3 text-h3 transition-[color] duration-150 group-hover:text-brand">{post.data.title}</h3>
            <p class="mt-3 text-muted-foreground">{cardSummaries[post.id] ?? post.data.description}</p>
            <p class="mt-5 flex flex-wrap gap-x-3 text-[14px] text-subtle">
              {post.data.pubDate && <time datetime={isoDate(post.data.pubDate)}>{formatDate(post.data.pubDate)}</time>}
              <span>{readingMinutes(post)} min read</span>
            </p>
            <a
              href={postUrl(post)}
              aria-label={`Read article: ${post.data.title}`}
              class="link-arrow mt-auto w-fit pt-4 after:absolute after:inset-0 after:rounded-xl after:content-['']"
            >
              Read article
              <ArrowRight aria-hidden="true" className="size-4" />
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <p class="mt-6 text-muted-foreground">No articles are published yet.</p>
    )}
  </section>

  <section aria-labelledby="blog-cta-title" class="container-site pb-20 sm:pb-24 lg:pb-32">
    <div class="max-w-[720px]">
      <h2 id="blog-cta-title" class="text-h3">Your product. Their AWS account.</h2>
      <p class="mt-2 text-muted-foreground">Explore customer-hosted deployment with Deployz.</p>
      <a href="/how-it-works/" class="link-arrow mt-2">
        See how Deployz works
        <ArrowRight aria-hidden="true" className="size-4" />
      </a>
    </div>
  </section>
</Base>
