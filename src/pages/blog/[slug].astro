---
import { existsSync } from 'node:fs';
import { getEntries, getEntry, render } from 'astro:content';
import { ArrowRight } from 'lucide-react';
import PageHeader from '@/components/site/PageHeader.astro';
import {
  formatDate,
  getVisiblePosts,
  isoDate,
  isPublished,
  isVisible,
  POST_CTAS,
  postUrl,
  readingMinutes,
  wordCount,
  type BlogPost,
} from '@/lib/blog';
import { DEFAULT_OG_IMAGE, ORGANIZATION_ID } from '@/lib/seo';
import { SIGNUP_URL } from '@/lib/site';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const posts = await getVisiblePosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
const { title, seoTitle, description, category, author, pubDate, updatedDate, related, cover, coverAlt } = post.data;
const { summary, keyTakeaways, sources, reviewedBy, lastReviewed, cta, toc } = post.data;
const { Content, headings } = await render(post);
const relatedPosts = (await getEntries(related)).filter(isVisible);
const canonicalURL = new URL(postUrl(post), Astro.site);
const isDraft = !isPublished(post);

// The author entry (src/content/authors.json) whose ID matches the byline, if there is one.
const authorEntry = author ? (await getEntry('authors', author.toLowerCase().replace(/[^a-z0-9]+/g, '-')))?.data : undefined;

// Table of contents: the h2 headings. By default only a post with four or more gets one.
const tocHeadings = headings.filter((heading) => heading.depth === 2);
const showToc = toc ?? tocHeadings.length >= 4;

const nextStep = POST_CTAS[cta];
const nextStepHref = nextStep.href === 'SIGNUP' ? SIGNUP_URL : nextStep.href;

// Title template: "{title} | Deployz". A title of more than 50 characters has no suffix.
const shortTitle = seoTitle ?? title;
const pageTitle = shortTitle.length > 50 ? shortTitle : `${shortTitle} | Deployz`;

// Social preview: the generated 1200 × 630 image for this post (scripts/og-images.mjs), else the site default.
const postOgImage = `/og/blog/${post.id}.png`;
const hasPostOgImage = existsSync(`public${postOgImage}`);
const ogImage = hasPostOgImage ? postOgImage : DEFAULT_OG_IMAGE;
const ogImageAlt = hasPostOgImage ? `${title} — Deployz Blog` : undefined;
const images = [
  ...(cover ? [new URL(cover.src, Astro.site).href] : []),
  ...(hasPostOgImage ? [new URL(postOgImage, Astro.site).href] : []),
];

// Truthful BlogPosting data: only the fields the post really has.
const authorType = authorEntry?.type ?? (author?.startsWith('Team ') ? 'Organization' : 'Person');
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  ...(summary && { abstract: summary }),
  url: canonicalURL.href,
  mainEntityOfPage: canonicalURL.href,
  inLanguage: 'en-US',
  articleSection: category,
  wordCount: wordCount(post),
  isPartOf: { '@type': 'Blog', '@id': new URL('/blog/#blog', Astro.site).href, name: 'The Deployz Blog', url: new URL('/blog/', Astro.site).href },
  ...(pubDate && { datePublished: isoDate(pubDate) }),
  ...((updatedDate ?? pubDate) && { dateModified: isoDate((updatedDate ?? pubDate)!) }),
  ...(author && {
    author: {
      '@type': authorType,
      name: author,
      ...(authorEntry?.url && { url: authorEntry.url }),
      ...(authorEntry && authorEntry.sameAs.length > 0 && { sameAs: authorEntry.sameAs }),
    },
  }),
  ...(images.length > 0 && { image: images }),
  ...(sources.length > 0 && {
    citation: sources.map((source) => ({
      '@type': 'CreativeWork',
      name: source.title,
      url: source.url,
      ...(source.publisher && { publisher: { '@type': 'Organization', name: source.publisher } }),
    })),
  }),
  publisher: {
    '@type': 'Organization',
    '@id': ORGANIZATION_ID,
    name: 'Deployz',
    url: new URL('/', Astro.site).href,
    logo: { '@type': 'ImageObject', url: new URL('/android-chrome-512x512.png', Astro.site).href },
  },
};
---

<Base
  title={pageTitle}
  description={description}
  ogType="article"
  noindex={isDraft}
  ogImage={ogImage}
  ogImageAlt={ogImageAlt}
  structuredData={structuredData}
  breadcrumbs={[
    { name: 'Blog', path: '/blog/' },
    { name: title, path: postUrl(post) },
  ]}
>
  <Fragment slot="head">
    {pubDate && <meta property="article:published_time" content={pubDate.toISOString()} />}
    {updatedDate && <meta property="article:modified_time" content={updatedDate.toISOString()} />}
    <meta property="article:section" content={category} />
    {author && <meta name="author" content={author} />}
    {!isDraft && <link rel="alternate" type="text/markdown" title={`${title} (Markdown)`} href={`/blog/${post.id}.md`} />}
  </Fragment>

  <PageHeader eyebrow={category} title={title}>
    {description}
  </PageHeader>

  <div class="container-site pb-20 sm:pb-24 lg:pb-32">
    <div class="max-w-[720px]">
      {isDraft && (
        <p class="mb-8 rounded-lg border border-border-strong px-4 py-3 text-[15px] text-foreground">
          Draft preview. This post shows only on the local dev server. It is not in the production build.
        </p>
      )}

      <p class="flex flex-wrap gap-x-3 gap-y-1 border-b border-border pb-6 text-[14px] text-subtle">
        {author && <span>{author}</span>}
        {pubDate ? <span>Published <time datetime={isoDate(pubDate)}>{formatDate(pubDate)}</time></span> : <span>Not published</span>}
        {updatedDate && <span>Updated <time datetime={isoDate(updatedDate)}>{formatDate(updatedDate)}</time></span>}
        <span>{readingMinutes(post)} min read</span>
      </p>

      {summary && (
        <section aria-labelledby="short-answer-title" class="mt-10 rounded-xl border border-brand-border bg-brand-subtle px-5 py-5 sm:px-6">
          <h2 id="short-answer-title" class="text-eyebrow text-foreground">Short answer</h2>
          <p class="mt-2 text-[17px] leading-[1.65] text-foreground" data-summary>{summary}</p>
        </section>
      )}

      {cover && (
        <img
          src={cover.src}
          width={cover.width}
          height={cover.height}
          alt={coverAlt}
          class="mt-10 h-auto w-full rounded-xl border border-border"
          loading="eager"
          decoding="async"
        />
      )}

      {showToc && (
        <nav aria-labelledby="toc-title" class="mt-10 border-l border-border-strong pl-5">
          <h2 id="toc-title" class="text-eyebrow text-muted-foreground">In this article</h2>
          <ol class="mt-2 grid text-[15px]">
            {tocHeadings.map((heading) => (
              <li>
                <a href={`#${heading.slug}`} class="flex min-h-11 items-center text-muted-foreground transition-[color] duration-150 hover:text-brand">
                  {heading.text}
                </a>
              </li>
            ))}
          </ol>
        </nav>
      )}

      <article class="post mt-10">
        <Content />
      </article>

      {keyTakeaways.length > 0 && (
        <section aria-labelledby="takeaways-title" class="mt-14 border-t border-border pt-8">
          <h2 id="takeaways-title" class="text-h3">Key takeaways</h2>
          <ul class="mt-4 grid list-disc gap-2 pl-[22px] text-[17px] leading-[1.65] text-muted-foreground marker:text-subtle">
            {keyTakeaways.map((item) => <li>{item}</li>)}
          </ul>
        </section>
      )}

      {sources.length > 0 && (
        <section aria-labelledby="sources-title" class="mt-12">
          <h2 id="sources-title" class="text-h3">Sources</h2>
          <ol class="mt-4 grid list-decimal pl-[22px] text-[15px] text-muted-foreground marker:text-subtle">
            {sources.map((source) => (
              <li>
                <a href={source.url} class="inline-flex min-h-11 items-center text-brand underline underline-offset-3 [overflow-wrap:anywhere] hover:text-brand-hover">
                  {source.title}
                </a>
                {source.publisher && <span class="text-subtle"> · {source.publisher}</span>}
              </li>
            ))}
          </ol>
        </section>
      )}

      {(reviewedBy || authorEntry) && (
        <section aria-label="About this article" class="mt-12 rounded-xl border border-border px-5 py-5 text-[15px] sm:px-6">
          {authorEntry && (
            <p class="text-muted-foreground">
              <span class="font-medium text-foreground">
                {authorEntry.url ? <a href={authorEntry.url} class="inline-flex min-h-11 items-center hover:text-brand">{authorEntry.name}</a> : authorEntry.name}
              </span>
              {authorEntry.role && <span>, {authorEntry.role}</span>}. {authorEntry.bio}
            </p>
          )}
          {reviewedBy && (
            <p class:list={['text-subtle', authorEntry && 'mt-3']}>
              Facts checked against the Deployz product by {reviewedBy}
              {lastReviewed && <> on <time datetime={isoDate(lastReviewed)}>{formatDate(lastReviewed)}</time></>}.
            </p>
          )}
        </section>
      )}

      <section aria-labelledby="next-step-title" class="mt-12 border-t border-border pt-8">
        <h2 id="next-step-title" class="text-h3">{nextStep.title}</h2>
        <p class="mt-2 text-muted-foreground">{nextStep.text}</p>
        <a href={nextStepHref} class="link-arrow mt-2" data-cta={`blog-${cta}`}>
          {nextStep.label}
          <ArrowRight aria-hidden="true" className="size-4" />
        </a>
      </section>

      {relatedPosts.length > 0 && (
        <section aria-labelledby="related-title" class="mt-16">
          <h2 id="related-title" class="text-h3">Related articles</h2>
          <ul class="mt-4 border-b border-border">
            {relatedPosts.map((item) => (
              <li class="border-t border-border py-4">
                <a href={postUrl(item)} class="flex min-h-11 items-center text-[17px] font-medium text-foreground transition-[color] duration-150 hover:text-brand">
                  {item.data.title}
                </a>
                <p class="text-[15px] text-muted-foreground">{item.data.description}</p>
              </li>
            ))}
          </ul>
        </section>
      )}

      <p class="mt-12"><a href="/blog/" class="link-arrow">All articles</a></p>
    </div>
  </div>
</Base>

<style>
  .post {
    font-size: 17px;
    line-height: 1.7;
    color: var(--muted-foreground);
  }

  .post :global(h2) {
    margin-top: 56px;
    font-size: 24px;
    line-height: 1.3;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--foreground);
  }

  .post :global(h3) {
    margin-top: 40px;
    font-size: 19px;
    line-height: 1.35;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--foreground);
  }

  .post :global(> :first-child) {
    margin-top: 0;
  }

  .post :global(p),
  .post :global(ul),
  .post :global(ol),
  .post :global(table),
  .post :global(blockquote),
  .post :global(pre),
  .post :global(img) {
    margin-top: 20px;
  }

  .post :global(h2 + *),
  .post :global(h3 + *) {
    margin-top: 14px;
  }

  .post :global(ul),
  .post :global(ol) {
    display: grid;
    gap: 8px;
    padding-left: 22px;
  }

  .post :global(ul) {
    list-style: disc;
  }

  .post :global(ol) {
    list-style: decimal;
  }

  .post :global(li::marker) {
    color: var(--text-subtle);
  }

  .post :global(strong) {
    font-weight: 600;
    color: var(--foreground);
  }

  /* Links keep a 44px target, and long URLs wrap instead of overflowing. */
  .post :global(a) {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    color: var(--brand);
    text-decoration: underline;
    text-underline-offset: 3px;
    overflow-wrap: anywhere;
  }

  .post :global(a:hover) {
    color: var(--brand-hover);
  }

  .post :global(blockquote) {
    border-left: 2px solid var(--border-strong);
    padding-left: 20px;
    color: var(--foreground);
  }

  .post :global(code) {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.9em;
  }

  /* Inline code such as an IAM action name has no break points. Let it wrap, so that the text never
     overflows a narrow screen or a zoomed page. Code blocks scroll instead (pre, below). */
  .post :global(:not(pre) > code) {
    overflow-wrap: anywhere;
  }

  .post :global(pre) {
    overflow-x: auto;
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 16px;
    font-size: 14px;
    line-height: 1.6;
  }

  .post :global(img) {
    display: block;
    max-width: 100%;
    height: auto;
    border: 1px solid var(--border);
    border-radius: 12px;
  }

  .post :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 15px;
    line-height: 1.55;
  }

  .post :global(th),
  .post :global(td) {
    padding: 10px 12px 10px 0;
    border-bottom: 1px solid var(--border);
    text-align: left;
    vertical-align: top;
    overflow-wrap: break-word;
    hyphens: auto;
  }

  /* At zoom-equivalent widths, long words break anywhere so that the table never overflows. */
  @media (max-width: 359px) {
    .post :global(th),
    .post :global(td) {
      overflow-wrap: anywhere;
    }
  }

  .post :global(th) {
    font-weight: 600;
    color: var(--foreground);
    border-bottom-color: var(--border-strong);
  }
</style>
