---
import { LOGIN_URL } from '@/lib/site';
import Logo from './Logo.astro';

const footerGroups = [
  {
    title: 'Product',
    links: [
      { href: '/how-it-works/', label: 'How It Works' },
      { href: '/case-studies/', label: 'Case Studies' },
      { href: '/pricing/', label: 'Pricing' },
      { href: '/security/', label: 'Security' },
    ],
  },
  {
    title: 'Resources',
    links: [
      { href: '/docs/', label: 'Documentation' },
      { href: '/blog/', label: 'Blog' },
      { href: LOGIN_URL, label: 'Log In' },
    ],
  },
  {
    title: 'Legal',
    links: [
      { href: '/privacy/', label: 'Privacy Policy' },
      { href: '/terms/', label: 'Terms of Service' },
      { href: '/gdpr/', label: 'GDPR' },
      { href: '/dpa/', label: 'DPA' },
    ],
  },
];
---

<footer>
  <div class="container-site pt-16 pb-10 lg:pt-20 lg:pb-12">
    <div class="grid gap-12 md:grid-cols-[minmax(0,1fr)_auto] md:gap-16">
      <div>
        <a href="/" class="-ml-1 flex min-h-11 w-fit items-center rounded-md px-1" aria-label="Deployz home">
          <Logo size={26} />
        </a>
        <p class="mt-3 text-[15px] text-muted-foreground">Deploy your SaaS in your customers' AWS accounts.</p>
      </div>
      <nav aria-label="Footer navigation" class="grid grid-cols-2 gap-x-12 gap-y-10 sm:grid-cols-3 lg:gap-x-16">
        {footerGroups.map((group) => (
          <div>
            <p class="text-[14px] font-semibold text-foreground">{group.title}</p>
            <ul class="mt-2">
              {group.links.map((link) => (
                <li>
                  <a
                    class="flex min-h-11 items-center text-[14px] text-muted-foreground transition-[color] duration-150 hover:text-foreground"
                    href={link.href}
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </nav>
    </div>
    <p class="mt-16 border-t border-border pt-8 text-[14px] text-muted-foreground">&copy; {new Date().getFullYear()} Deployz. Built by Thalia Technologies.</p>
  </div>
</footer>
