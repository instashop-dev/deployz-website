---
/*
 * Diagram connector (see src/styles/diagrams.css). Vertical in narrow containers,
 * horizontal in wide ones. Decorative: the figure states the relationship in text.
 *   variant  neutral (default) | brand (the single Deployz-controlled connector) | blocked
 *   reverse  arrow points up / left instead of down / right
 */
interface Props {
  label?: string;
  sub?: string;
  variant?: 'neutral' | 'brand' | 'blocked';
  reverse?: boolean;
  class?: string;
}

const { label, sub, variant = 'neutral', reverse = false, class: className } = Astro.props;
---

<div
  class:list={['dg-link', variant !== 'neutral' && `dg-link-${variant}`, reverse && 'dg-link-reverse', className]}
  aria-hidden="true"
>
  <span class="dg-link-line"></span>
  {variant === 'blocked' ? (
    <span class="dg-link-stop"><svg viewBox="0 0 10 10"><path d="M2 2l6 6M8 2L2 8" /></svg></span>
  ) : (
    <svg class="dg-link-head" viewBox="0 0 12 12"><path d="M4 1.5L9.5 6 4 10.5" /></svg>
  )}
  {label && (
    <span class="dg-link-label">
      {label}
      {sub && <span class="dg-link-sub">{sub}</span>}
    </span>
  )}
</div>
