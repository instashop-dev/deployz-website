---
/*
 * "Process at a glance" journey: readiness report, install page, live deployment.
 * Scene system: src/styles/scene.css. The drawing is aria-hidden; the sr-only caption describes it.
 */
import { Link as LinkIcon } from 'lucide-react';
import Beam from '@/components/site/scene/Beam.astro';
import GithubMark from '@/components/site/scene/GithubMark.astro';
import Mark from '@/components/site/scene/Mark.astro';

const installSteps = [
  'AWS account connected',
  'Create infrastructure',
  'Start application',
  'Check application',
  'Set up HTTPS',
];
---

<figure class="sc journey-sc mx-auto w-full max-w-[1120px]">
  <figcaption class="sr-only">
    Steps 1 and 2: you connect GitHub, fix anything the readiness report flags, and build a release. Step 3:
    you send your customer an installation link; they review the Region, resources, and cost, then connect
    their AWS account. Step 4: Deployz deploys the release in their account and shows each step until it is
    live.
  </figcaption>

  <div class="sc-stage" aria-hidden="true">
    <div class="sc-flow">
      <!-- 1. Readiness report -->
      <div class="journey-step">
        <p class="journey-tag"><span class="journey-num">1–2</span>You prepare a release</p>
        <div class="sc-card">
          <div class="sc-head">
            <span class="sc-icon sc-icon-dark"><GithubMark /></span>
            <p class="sc-head-title">your-org/your-app<small class="sc-mono">main</small></p>
          </div>
          <div class="sc-body">
            <div class="flex flex-wrap items-center justify-between gap-x-3 gap-y-1.5">
              <span class="text-[13px] font-medium">11 of 12 checks passed</span>
              <span class="sc-badge sc-badge-warn">Needs input</span>
            </div>
            <div class="sc-progress mt-2"><span style="width: 92%"></span></div>
            <ul class="sc-checks mt-3">
              <li><Mark /><span>Dockerfile</span><span class="sc-mono">found</span></li>
              <li><Mark /><span>Port</span><span class="sc-mono">3000</span></li>
              <li><Mark /><span>Health check</span><span class="sc-mono">/health</span></li>
              <li><Mark state="warn" /><span>Environment variables</span><span class="sc-mono">1 value to set</span></li>
            </ul>
          </div>
          <div class="sc-foot">
            <span class="sc-label">Release</span>
            <span class="sc-btn sc-btn-dark">Build release</span>
          </div>
        </div>
      </div>

      <Beam label="install link" variant="neutral" />

      <!-- 2. Install page -->
      <div class="journey-step">
        <p class="journey-tag"><span class="journey-num">3</span>Your customer connects AWS</p>
        <div class="sc-card">
          <div class="sc-head">
            <span class="sc-icon"><LinkIcon strokeWidth={1.75} /></span>
            <p class="sc-head-title">Install your app<small>Installation link</small></p>
          </div>
          <div class="sc-body">
            <ul class="sc-kv">
              <li><span>Region</span><span>eu-west-1</span></li>
              <li><span>Resources</span><span>app, database, storage</span></li>
              <li><span>Estimated cost</span><span>shown before connecting</span></li>
            </ul>
            <p class="mt-3 text-[12px] leading-snug text-muted-foreground">PostgreSQL and stored files are retained</p>
          </div>
          <div class="sc-foot">
            <span class="sc-btn sc-btn-dark journey-full">Connect AWS account</span>
          </div>
        </div>
      </div>

      <Beam label="deploy v1.4.0" variant="brand" delay={1.3} />

      <!-- 3. Deployment -->
      <div class="journey-step">
        <p class="journey-tag"><span class="journey-num">4</span>Deployz deploys</p>
        <div class="sc-card sc-card-brand">
          <div class="sc-head">
            <span class="sc-icon sc-icon-brand"><img src="/deployz-icon-master.svg" alt="" width="16" height="16" /></span>
            <p class="sc-head-title">Customer A<small class="sc-mono">eu-west-1</small></p>
            <span class="sc-badge sc-badge-live"><span class="sc-dot sc-dot-pulse"></span>Live</span>
          </div>
          <div class="sc-body">
            <ul class="sc-checks">
              {installSteps.map((step) => <li><Mark /><span>{step}</span></li>)}
            </ul>
          </div>
          <div class="sc-foot">
            <span class="sc-label">Release</span>
            <span class="sc-mono text-foreground">v1.4.0</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</figure>

<style>
  /* Equal columns: the three steps are peers of one size. */
  .journey-sc .sc-flow {
    --sc-cols: minmax(0, 1fr) 112px minmax(0, 1fr) 112px minmax(0, 1fr);
    --journey-tag: 32px; /* 22px tag + 10px gap */
  }

  .journey-step {
    display: flex;
    min-width: 0;
    flex-direction: column;
  }

  .journey-step > .sc-card {
    display: flex;
    flex: 1;
    flex-direction: column;
  }

  .journey-step .sc-body {
    flex: 1;
  }

  .journey-tag {
    display: flex;
    align-items: center;
    gap: 8px;
    min-height: 22px;
    margin-bottom: 10px;
    font-size: 12px;
    line-height: 1.3;
    font-weight: 600;
    color: var(--foreground);
  }

  .journey-num {
    display: inline-flex;
    flex-shrink: 0;
    min-width: 22px;
    padding: 0 5px;
    height: 22px;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--border-strong);
    border-radius: 6px;
    background: var(--background);
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    color: var(--muted-foreground);
  }

  .journey-full {
    width: 100%;
  }

  /* Vertical flow: keep the step cells apart from the beams. */
  .journey-sc .sc-flow > .journey-step {
    width: 100%;
  }

  @container sc (min-width: 960px) {
    .journey-sc .sc-flow {
      align-items: stretch;
    }

    .journey-tag {
      white-space: nowrap;
    }

    .journey-sc .sc-flow > :global(.sc-beam) {
      margin-top: var(--journey-tag);
    }

    .journey-sc :global(.sc-stage) {
      padding-inline: 28px;
    }

    .journey-sc :global(.sc-beam-chip) {
      max-width: none;
    }
  }

  /* Just above the horizontal breakpoint: slimmer beams, chips may wrap to two lines. */
  @container sc (min-width: 960px) and (max-width: 1119px) {
    .journey-sc .sc-flow {
      --sc-cols: minmax(0, 1fr) 104px minmax(0, 1fr) 104px minmax(0, 1fr);
    }

    .journey-sc :global(.sc-stage) {
      padding-inline: 20px;
    }

    .journey-sc :global(.sc-beam-chip) {
      max-width: 100%;
      white-space: normal;
    }
  }
</style>
