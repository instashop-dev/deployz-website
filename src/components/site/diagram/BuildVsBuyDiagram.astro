---
/*
 * "Build it yourself vs. use Deployz" scene for the pricing page value section.
 * The same list of work appears twice. Built in-house, your team owns every row. With
 * Deployz, your team keeps the product and Deployz takes the deployment rows.
 * Scene system: src/styles/scene.css. The drawing is aria-hidden; the sr-only text describes it.
 */
const work = [
  'Your product',
  'AWS infrastructure templates',
  'Customer installer and AWS access',
  'Release builds',
  'Updates and rollbacks',
  'Status for every customer',
];

const columns = [
  { title: 'Build it yourself', owners: work.map(() => 'team'), total: `Your team owns ${work.length} of ${work.length}` },
  { title: 'With Deployz', owners: work.map((_, index) => (index === 0 ? 'team' : 'deployz')), total: `Your team owns 1 of ${work.length}`, brand: true },
];
---

<figure class="sc bvb-sc">
  <p class="sr-only">
    Comparison of the same six pieces of work. Build it yourself: your team owns all six — your product, AWS
    infrastructure templates, the customer installer and AWS access, release builds, updates and rollbacks,
    and status for every customer. With Deployz: your team owns your product, and Deployz handles the other
    five.
  </p>

  <div class="sc-stage sc-stage-plain" aria-hidden="true">
    <div class="bvb-grid">
      {columns.map((column) => (
        <div class:list={['sc-card', column.brand && 'sc-card-brand']}>
          <div class="sc-head">
            {column.brand
              ? <span class="sc-icon sc-icon-brand"><img src="/deployz-icon-master.svg" alt="" width="16" height="16" /></span>
              : <span class="sc-icon"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M10.5 2.5l3 3-7.5 7.5H3v-3z" /></svg></span>}
            <p class="sc-head-title">{column.title}</p>
          </div>
          <ul class="sc-body bvb-rows">
            {work.map((item, index) => (
              <li class="bvb-row">
                <span class:list={['bvb-item', index === 0 && 'bvb-item-product']}>{item}</span>
                {column.owners[index] === 'team'
                  ? <span class="sc-badge">Your team</span>
                  : <span class="sc-badge sc-badge-brand">Deployz</span>}
              </li>
            ))}
          </ul>
          <div class="sc-foot">
            <span class:list={['bvb-total', column.brand && 'bvb-total-brand']}>{column.total}</span>
          </div>
        </div>
      ))}
    </div>
  </div>
</figure>

<style>
  .bvb-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 20px;
    max-width: 480px;
    margin-inline: auto;
  }

  .bvb-rows {
    display: grid;
  }

  .bvb-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 4px 12px;
    min-height: 40px;
    padding-block: 6px;
    border-top: 1px solid var(--border);
  }

  .bvb-row:first-child {
    border-top: 0;
  }

  .bvb-item {
    min-width: 0;
    font-size: 13px;
    line-height: 1.4;
    color: var(--muted-foreground);
  }

  .bvb-item-product {
    font-weight: 600;
    color: var(--foreground);
  }

  .bvb-total {
    font-size: 13px;
    font-weight: 600;
    color: var(--foreground);
  }

  .bvb-total-brand {
    color: var(--brand-hover);
  }

  @container sc (min-width: 720px) {
    .bvb-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 28px;
      max-width: 880px;
    }
  }
</style>
