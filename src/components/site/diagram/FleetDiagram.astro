---
/*
 * One release, many customer AWS accounts, drawn like a git branch graph. Scene system:
 * src/styles/scene.css. The drawing is aria-hidden; the sr-only caption describes it.
 */
import { Cloud } from 'lucide-react';

const accounts = [
  { name: 'Customer A', region: 'us-east-1', version: 'v1.4.0', state: 'live' },
  { name: 'Customer B', region: 'eu-west-1', version: 'v1.4.0', state: 'updating' },
  { name: 'Customer C', region: 'ap-southeast-2', version: '\u2014', state: 'waiting' },
];
---

<figure class="sc fleet-sc">
  <figcaption class="sr-only">
    One release of your app installs into each customer's own AWS account. Each account shows its own
    status: live, updating, or waiting for the customer to connect.
  </figcaption>

  <div class="sc-stage" aria-hidden="true">
    <div class="fleet-graph">
      <div class="sc-card sc-card-brand fleet-release">
        <div class="sc-head fleet-nohead">
          <span class="sc-icon sc-icon-brand"><img src="/deployz-icon-master.svg" alt="" width="16" height="16" /></span>
          <p class="sc-head-title">Release v1.4.0<small class="sc-mono">your-org/your-app<span class="fleet-sep"> &middot; </span><span class="fleet-sha">a1f9c3e</span></small></p>
          <span class="sc-badge sc-badge-brand">Ready</span>
        </div>
      </div>

      <ul class="fleet-rows">
        <li class="fleet-light"><span></span></li>
        {accounts.map((a) => (
          <li class={`fleet-row fleet-${a.state}`}>
            <div class="sc-card">
              <div class="sc-head fleet-nohead">
                <span class="sc-icon"><Cloud strokeWidth={1.75} /></span>
                <p class="sc-head-title">{a.name}<small class="sc-mono">{a.region}</small></p>
                <span class="fleet-meta">
                  <span class="sc-mono fleet-ver">{a.version}</span>
                  {a.state === 'live' && (
                    <span class="sc-badge sc-badge-live"><span class="sc-dot sc-dot-pulse"></span>Live</span>
                  )}
                  {a.state === 'updating' && <span class="sc-badge sc-badge-brand">Updating</span>}
                  {a.state === 'waiting' && <span class="sc-badge">Waiting for customer</span>}
                </span>
              </div>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </div>
</figure>

<style>
  .fleet-sc {
    --fl-x: 18px;
    --fl-indent: 42px;
    --fl-gap: 10px;
    --fl-line: var(--brand-border);
  }

  .fleet-graph {
    max-width: 440px;
    margin-inline: auto;
  }

  .fleet-nohead {
    border-bottom: 0;
    flex-wrap: wrap;
  }

  .fleet-nohead .sc-head-title {
    flex: 1 1 110px;
  }

  /* Release card port where the trunk starts. */
  .fleet-release::after,
  .fleet-row::after {
    content: '';
    position: absolute;
    z-index: 2;
    width: 7px;
    height: 7px;
    border: 1.5px solid var(--brand);
    border-radius: 9999px;
    background: var(--background);
  }

  .fleet-release::after {
    left: calc(var(--fl-x) - 3.75px);
    bottom: -4px;
  }

  .fleet-rows {
    position: relative;
    padding-top: 16px;
  }

  .fleet-row {
    position: relative;
    margin-top: var(--fl-gap);
    margin-left: var(--fl-indent);
  }

  .fleet-light + .fleet-row {
    margin-top: 0;
  }

  /* Port dot on the card's left edge. */
  .fleet-row::after {
    left: -4px;
    top: calc(50% - 3.75px);
  }

  .fleet-waiting::after {
    border-color: var(--border-strong);
  }

  /* Rounded elbow from the trunk into the card. */
  .fleet-row::before {
    content: '';
    position: absolute;
    left: calc(var(--fl-x) - var(--fl-indent));
    top: calc(-1 * var(--fl-gap));
    width: calc(var(--fl-indent) - var(--fl-x));
    height: calc(50% + var(--fl-gap));
    border-left: 1.5px solid var(--fl-line);
    border-bottom: 1.5px solid var(--fl-line);
    border-bottom-left-radius: 10px;
  }

  .fleet-light + .fleet-row::before {
    top: -16px;
    height: calc(50% + 16px);
  }

  .fleet-waiting::before {
    border-color: var(--border-strong);
  }

  /* Commit node on the trunk where it branches and keeps going. */
  .fleet-row .sc-card::before {
    content: '';
    position: absolute;
    z-index: 2;
    left: calc(var(--fl-x) - var(--fl-indent) - 3.75px);
    top: calc(50% - 3.75px);
    width: 7px;
    height: 7px;
    border-radius: 9999px;
    background: var(--brand);
    box-shadow: 0 0 0 2px var(--background);
  }

  .fleet-waiting .sc-card::before {
    display: none;
  }

  /* Trunk segment from this branch point down to the next row's elbow. */
  .fleet-row:not(:last-child) .sc-card::after {
    content: '';
    position: absolute;
    left: calc(var(--fl-x) - var(--fl-indent) - 0.75px);
    top: 50%;
    bottom: calc(-1 * var(--fl-gap));
    border-left: 1.5px solid var(--fl-line);
  }

  /* Travelling light on the straight part of the trunk (release card to the last branch). */
  .fleet-light {
    position: absolute;
    left: calc(var(--fl-x) - 0.75px);
    top: 0;
    bottom: 27px;
    width: 1.5px;
    overflow: hidden;
    pointer-events: none;
  }

  .fleet-light span {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 40%;
    background: linear-gradient(180deg, transparent, var(--brand) 70%, transparent);
    animation: sc-beam-y 2.6s cubic-bezier(0.45, 0, 0.55, 1) infinite;
  }

  .fleet-meta {
    display: inline-flex;
    flex: 0 1 auto;
    align-items: center;
    gap: 10px;
    margin-left: auto;
  }

  @container sc (max-width: 419px) {
    .fleet-rows {
      --fl-x: 12px;
      --fl-indent: 30px;
    }

    .fleet-ver,
    .fleet-sep {
      display: none;
    }

    .fleet-sha {
      display: block;
    }

    .fleet-nohead .sc-head-title {
      flex-basis: 96px;
    }

    .fleet-waiting .fleet-meta {
      flex-basis: 100%;
      margin: 0 0 0 38px;
    }
  }

  @container sc (max-width: 259px) {
    .fleet-meta {
      min-width: 0;
      max-width: 100%;
      flex-wrap: wrap;
    }

    .fleet-meta .sc-badge {
      min-width: 0;
      max-width: 100%;
      flex-shrink: 1;
      white-space: normal;
      line-height: 1.2;
      padding-block: 3px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .fleet-light span {
      animation: none;
      display: none;
    }
  }
</style>
