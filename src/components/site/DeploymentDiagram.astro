---
/*
 * Signature hero scene: GitHub repository -> Deployz release -> your app live in the customer's
 * AWS account. Three quiet cards joined by unlabelled beams whose lights run left to right.
 * Minimal text; one small loop per card: the readiness segments fill, the resource tiles light
 * up one by one, and the live dot pulses. Without motion, every part shows its finished state.
 * Scene system: src/styles/scene.css. The drawing is aria-hidden; the sr-only caption describes it.
 */
import { Box, Database, HardDrive, Layers, Lock } from 'lucide-react';
import Beam from '@/components/site/scene/Beam.astro';
import GithubMark from '@/components/site/scene/GithubMark.astro';
import Mark from '@/components/site/scene/Mark.astro';

const segments = Array.from({ length: 12 }, (_, index) => index);
const resources = [Box, Database, Layers, HardDrive];
---

<figure class="sc hero-sc mx-auto w-full max-w-[1120px]">
  <figcaption class="sr-only">
    Deployz reads your GitHub repository with read-only access and checks what your app needs. When the
    readiness checks pass, it deploys a release of your app into your customer's AWS account, where the
    container, database, cache, and file storage run.
  </figcaption>

  <div class="sc-stage" aria-hidden="true">
    <div class="sc-flow">
      <!-- 1. Your repository -->
      <div class="sc-card hero-card">
        <div class="sc-head">
          <span class="sc-icon sc-icon-dark"><GithubMark /></span>
          <p class="sc-head-title sc-mono hero-repo">your-org/your-app</p>
        </div>
        <div class="sc-body hero-body">
          <div class="hero-branch">
            <span class="sc-badge sc-mono">main</span>
            <span class="sc-badge"><Lock strokeWidth={2} />Read-only</span>
          </div>
          <p class="hero-commit"><span class="hero-commit-node"></span><span class="sc-mono">a1f9c3e</span></p>
        </div>
      </div>

      <Beam variant="neutral" />

      <!-- 2. Deployz: readiness and release -->
      <div class="sc-card sc-card-brand hero-card">
        <div class="sc-head">
          <span class="sc-icon sc-icon-brand"><img src="/deployz-icon-master.svg" alt="" width="16" height="16" /></span>
          <p class="sc-head-title">Release</p>
          <span class="sc-badge sc-badge-brand sc-mono">v1.4.0</span>
        </div>
        <div class="sc-body hero-body">
          <div class="hero-segments">
            {segments.map((index) => <span style={`--i: ${index}`}></span>)}
          </div>
          <p class="hero-ready"><Mark />Ready to deploy</p>
        </div>
      </div>

      <Beam variant="brand" delay={1.3} />

      <!-- 3. Customer AWS -->
      <div class="sc-boundary hero-aws">
        <span class="sc-boundary-tag">Customer AWS</span>
        <div class="sc-card hero-app">
          <div class="sc-head">
            <span class="sc-icon"><Box strokeWidth={1.75} /></span>
            <p class="sc-head-title">Your app</p>
            <span class="sc-badge sc-badge-live"><span class="sc-dot sc-dot-pulse"></span>Live</span>
          </div>
        </div>
        <ul class="hero-tiles">
          {resources.map((Icon, index) => (
            <li style={`--i: ${index}`}><Icon strokeWidth={1.75} /></li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</figure>

<style>
  .hero-sc .sc-flow {
    --sc-cols: minmax(0, 1fr) 104px minmax(0, 1fr) 104px minmax(0, 1fr);
  }

  .hero-repo {
    overflow: hidden;
    color: var(--foreground);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .hero-body {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 12px;
    min-height: 88px;
  }

  .hero-branch {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .hero-branch :global(svg) {
    width: 12px;
    height: 12px;
  }

  .hero-commit {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }

  .hero-commit .sc-mono {
    color: var(--foreground);
  }

  .hero-commit-node {
    width: 10px;
    height: 10px;
    border: 1.5px solid var(--border-strong);
    border-radius: 9999px;
    background: var(--background);
    box-shadow: 0 0 0 3px var(--surface-subtle);
  }

  /* Readiness: twelve segments, all passed. */
  .hero-segments {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 3px;
  }

  .hero-segments > span {
    height: 6px;
    border-radius: 9999px;
    background: var(--brand);
  }

  .hero-ready {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    font-weight: 500;
    color: var(--foreground);
  }

  /* Customer AWS: the app, then its resources as icon tiles. */
  .hero-app .sc-head {
    border-bottom: 0;
  }

  .hero-tiles {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 8px;
    margin-top: 10px;
  }

  .hero-tiles > li {
    display: flex;
    height: 40px;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--border);
    border-radius: 9px;
    background: var(--background);
    box-shadow: 0 1px 2px rgb(17 17 17 / 0.04);
    color: var(--foreground);
  }

  .hero-tiles :global(svg) {
    width: 16px;
    height: 16px;
  }

  @container sc (min-width: 960px) {
    .hero-sc .sc-flow {
      align-items: stretch;
    }

    .hero-sc .hero-card,
    .hero-sc .hero-aws {
      display: flex;
      flex-direction: column;
    }

    .hero-sc .hero-card > .sc-body {
      flex: 1;
    }

    .hero-sc .hero-aws {
      justify-content: center;
    }

    .hero-sc :global(.sc-stage) {
      padding: 56px 44px;
    }
  }

  @container sc (min-width: 960px) and (max-width: 1039px) {
    .hero-sc .sc-flow {
      --sc-cols: minmax(0, 1fr) 80px minmax(0, 1fr) 80px minmax(0, 1fr);
    }
  }

  /* Motion, one 5.2s cycle: the segments fill, then the resources light up after the deploy beam. */
  @media (prefers-reduced-motion: no-preference) {
    .hero-segments > span {
      animation: hero-fill 5.2s ease-out infinite;
      animation-delay: calc(var(--i) * 70ms);
    }

    .hero-tiles > li {
      animation: hero-light 5.2s ease-in-out infinite;
      animation-delay: calc(2.4s + var(--i) * 0.18s);
    }
  }

  @keyframes hero-fill {
    0% { background: var(--border); }
    14%, 88% { background: var(--brand); }
    100% { background: var(--brand); }
  }

  @keyframes hero-light {
    0%, 100% { border-color: var(--border); background: var(--background); color: var(--foreground); }
    8% { border-color: var(--brand-border); background: var(--brand-subtle); color: var(--brand); }
    22% { border-color: var(--border); background: var(--background); color: var(--foreground); }
  }
</style>
