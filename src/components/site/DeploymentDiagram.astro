---
/*
 * Signature hero diagram: GitHub -> Deployz -> customer-owned AWS account.
 * Built from the shared diagram system (src/styles/diagrams.css): vertical in narrow
 * containers, horizontal in wide ones. Connectors are decorative; the sr-only caption
 * states the flow.
 */
import { Cloud, GitBranch } from 'lucide-react';
import Connector from '@/components/site/diagram/Connector.astro';

const resources = ['Database (optional)', 'Redis-compatible cache (optional)', 'S3 file storage'];
---

<figure class="dg hero-dg mx-auto w-full max-w-[1080px]" aria-labelledby="hero-dg-caption">
  <figcaption id="hero-dg-caption" class="sr-only">
    Deployz reads your GitHub repository, prepares a release, and deploys and updates it in your
    customer's AWS account, where the application and its resources run.
  </figcaption>
  <div role="list" class="dg-flow">
    <div role="listitem" class="dg-node">
      <p class="dg-role"><GitBranch aria-hidden="true" strokeWidth={1.75} /> GitHub</p>
      <p class="dg-title">Connect your code</p>
      <p class="dg-text">Your repository stays where it is.</p>
      <ul class="dg-rows">
        <li><span>Repository access</span><span class="dg-chip-meta">Read-only</span></li>
        <li><span>You select each release</span></li>
      </ul>
    </div>

    <Connector label="Reads your repository" />

    <div role="listitem" class="dg-node dg-node-brand">
      <p class="dg-role">
        <img src="/deployz-icon-master.svg" alt="" width="16" height="16" />
        Deployz
      </p>
      <p class="dg-title">Configure &amp; deploy</p>
      <p class="dg-text">Checks what your app needs, then deploys it.</p>
      <ul class="dg-rows">
        <li><span>Readiness report</span></li>
        <li><span>Releases, updates, and status</span></li>
      </ul>
    </div>

    <Connector label="Deploys and updates" variant="brand" />

    <div role="listitem" class="dg-boundary">
      <p class="dg-role"><Cloud aria-hidden="true" strokeWidth={1.75} /> Customer AWS</p>
      <p class="dg-title">Run in their cloud</p>
      <p class="dg-text">They own the infrastructure and the data.</p>
      <div class="mt-4">
        <p class="dg-chip dg-chip-strong">Application container</p>
        <ul class="dg-tree" aria-label="Resources in their AWS account">
          {resources.map((resource) => <li><span class="dg-chip">{resource}</span></li>)}
        </ul>
      </div>
    </div>
  </div>
</figure>

<style>
  .hero-dg .dg-flow {
    --dg-cols: minmax(0, 1fr) 88px minmax(0, 1.06fr) 112px minmax(0, 1.14fr);
  }

  /* The two vendor-side nodes share one height, so the flow reads as one line. */
  @container dg (min-width: 760px) {
    .hero-dg .dg-node {
      align-self: center;
      min-height: 212px;
    }
  }
</style>
