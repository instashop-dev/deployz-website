---
/*
 * Signature hero scene: GitHub repository -> Deployz readiness and release -> the app
 * running live in the customer's AWS account. Scene system: src/styles/scene.css.
 * The drawing is aria-hidden; the sr-only caption describes it.
 */
import { Box, Cloud, Database, HardDrive, Layers } from 'lucide-react';
import Beam from '@/components/site/scene/Beam.astro';
import GithubMark from '@/components/site/scene/GithubMark.astro';
import Mark from '@/components/site/scene/Mark.astro';

const checks = [
  { label: 'Port', value: '3000' },
  { label: 'Health check', value: '/health' },
  { label: 'PostgreSQL', value: '16' },
  { label: 'File storage', value: 'S3' },
];

const tiles = [
  { icon: Box, title: 'Container', meta: 'ECS Fargate' },
  { icon: Database, title: 'Database', meta: 'PostgreSQL' },
  { icon: Layers, title: 'Cache', meta: 'Valkey' },
  { icon: HardDrive, title: 'Storage', meta: 'S3' },
];
---

<figure class="sc hero-sc mx-auto w-full max-w-[1120px]">
  <figcaption class="sr-only">
    Deployz reads your GitHub repository with read-only access and checks what your app needs. When
    the readiness checks pass, it deploys a release of your app into your customer's AWS account, where
    the container, database, cache, and file storage run.
  </figcaption>

  <div class="sc-stage" aria-hidden="true">
    <div class="sc-flow">
      <!-- 1. GitHub -->
      <div class="sc-card">
        <div class="sc-head">
          <span class="sc-icon sc-icon-dark"><GithubMark /></span>
          <p class="sc-head-title">GitHub<small class="sc-mono">your-org/your-app</small></p>
        </div>
        <div class="sc-body">
          <ul class="sc-kv">
            <li><span>Access</span><span>read-only</span></li>
            <li><span>Branch</span><span>main</span></li>
            <li><span>Commit</span><span>a1f9c3e</span></li>
          </ul>
          <ul class="sc-checks mt-3 border-t border-border pt-3">
            <li><Mark /><span>Dockerfile found</span></li>
          </ul>
        </div>
      </div>

      <Beam label="reads repo" variant="neutral" />

      <!-- 2. Deployz -->
      <div class="sc-card sc-card-brand">
        <div class="sc-head">
          <span class="sc-icon sc-icon-brand"><img src="/deployz-icon-master.svg" alt="" width="16" height="16" /></span>
          <p class="sc-head-title">Deployz<small>Readiness report</small></p>
          <span class="sc-badge sc-badge-brand">Ready</span>
        </div>
        <div class="sc-body">
          <div class="flex items-baseline justify-between gap-3">
            <span class="text-[13px] font-medium">12 of 12 checks passed</span>
          </div>
          <div class="sc-progress mt-2"><span style="width: 100%"></span></div>
          <ul class="sc-checks mt-3">
            {checks.map((check) => (
              <li><Mark /><span>{check.label}</span><span class="sc-mono">{check.value}</span></li>
            ))}
          </ul>
        </div>
        <div class="sc-foot">
          <span class="sc-label">Release</span>
          <span class="sc-mono text-foreground">v1.4.0</span>
        </div>
      </div>

      <Beam label="deploy v1.4.0" variant="brand" delay={1.3} />

      <!-- 3. Customer AWS -->
      <div class="sc-boundary hero-aws">
        <span class="sc-boundary-tag"><Cloud strokeWidth={1.75} /> Customer AWS <span class="sc-mono">us-east-1</span></span>
        <div class="sc-card hero-app">
          <div class="sc-head">
            <span class="sc-icon"><Box strokeWidth={1.75} /></span>
            <p class="sc-head-title">Your app<small class="sc-mono">v1.4.0 · HTTPS</small></p>
            <span class="sc-badge sc-badge-live"><span class="sc-dot sc-dot-pulse"></span>Live</span>
          </div>
        </div>
        <ul class="sc-tiles mt-2.5">
          {tiles.map((tile) => (
            <li class="sc-tile">
              <span class="sc-icon sc-icon-sm"><tile.icon strokeWidth={1.75} /></span>
              <span class="sc-tile-text">{tile.title}<span class="sc-mono">{tile.meta}</span></span>
            </li>
          ))}
        </ul>
        <p class="mt-3 text-[12px] leading-snug text-muted-foreground">Their account. Their data.</p>
      </div>
    </div>
  </div>
</figure>

<style>
  .hero-sc .sc-flow {
    --sc-cols: minmax(0, 0.92fr) 136px minmax(0, 1.04fr) 152px minmax(0, 1.18fr);
  }

  .hero-app .sc-head {
    border-bottom: 0;
  }

  @container sc (min-width: 960px) {
    .hero-sc .sc-card-brand {
      transform: translateY(-6px);
    }
  }

  @container sc (min-width: 960px) and (max-width: 1039px) {
    .hero-sc .sc-flow {
      --sc-cols: minmax(0, 0.95fr) 116px minmax(0, 1.06fr) 128px minmax(0, 1.1fr);
    }

    .hero-sc .sc-tiles {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
