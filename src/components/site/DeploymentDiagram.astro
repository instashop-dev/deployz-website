---
/*
 * Signature hero diagram: vendor -> Deployz -> customer-owned AWS account.
 * One HTML composition with two layouts: vertical below 900px, horizontal above.
 * Every label comes from existing site copy. Connectors are decorative (aria-hidden).
 */
const resources = ['PostgreSQL database', 'Redis-compatible cache', 'S3 file storage'];
---

<figure class="diagram mx-auto w-full max-w-[1080px]">
  <div role="list" aria-label="How control is divided between you, Deployz, and your customer" class="diagram-grid">
    <!-- 1. Vendor -->
    <div role="listitem" class="node node-vendor">
      <p class="node-role">You</p>
      <p class="node-title">Your application</p>
      <p class="node-text">You select each release.</p>
      <ul class="node-rows" aria-label="Your side">
        <li><span>GitHub repository</span><span class="node-tag">Read-only</span></li>
        <li><span>Versioned releases</span></li>
      </ul>
    </div>

    <div class="connector" aria-hidden="true">
      <span class="connector-label">Releases</span>
      <svg class="connector-h" viewBox="0 0 100 12" preserveAspectRatio="none"><path d="M0 6H99" /></svg>
      <svg class="connector-head-h" viewBox="0 0 8 12"><path d="M1 1.5L6.5 6 1 10.5" /></svg>
      <svg class="connector-v" viewBox="0 0 12 100" preserveAspectRatio="none"><path d="M6 0V99" /></svg>
      <svg class="connector-head-v" viewBox="0 0 12 8"><path d="M1.5 1L6 6.5 10.5 1" /></svg>
    </div>

    <!-- 2. Deployz -->
    <div role="listitem" class="node node-deployz">
      <p class="node-role node-role-brand">
        <img src="/deployz-icon-master.svg" alt="" width="18" height="18" class="size-[18px]" />
        Deployz
      </p>
      <p class="node-title">Installation and updates</p>
      <p class="node-text">Deployz deploys it and reports the status.</p>
      <ul class="node-rows node-rows-brand" aria-label="Deployz side">
        <li><span>Builds and stores the images</span></li>
        <li><span>Coordinates and reports</span></li>
      </ul>
    </div>

    <div class="connector connector-brand" aria-hidden="true">
      <span class="connector-label">Installs and updates</span>
      <svg class="connector-h" viewBox="0 0 100 12" preserveAspectRatio="none"><path d="M0 6H99" /></svg>
      <svg class="connector-head-h" viewBox="0 0 8 12"><path d="M1 1.5L6.5 6 1 10.5" /></svg>
      <svg class="connector-v" viewBox="0 0 12 100" preserveAspectRatio="none"><path d="M6 0V99" /></svg>
      <svg class="connector-head-v" viewBox="0 0 12 8"><path d="M1.5 1L6 6.5 10.5 1" /></svg>
    </div>

    <!-- 3. Customer-owned AWS account boundary -->
    <div role="listitem" class="boundary">
      <p class="node-role">Your customer</p>
      <p class="node-title">Their AWS account</p>
      <p class="node-text">They own the infrastructure and the data.</p>
      <div class="boundary-inner">
        <p class="app-node">Application container</p>
        <ul class="resource-list" aria-label="Resources in their AWS account">
          {resources.map((resource) => <li><span class="resource-node">{resource}</span></li>)}
        </ul>
      </div>
    </div>
  </div>
</figure>

<style>
  .diagram {
    --stroke: var(--border-strong);
    --node-pad: 20px;
  }

  .diagram-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    justify-items: stretch;
    max-width: 440px;
    margin-inline: auto;
    text-align: left;
  }

  /* ---- Nodes ---- */
  .node,
  .boundary {
    position: relative;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--background);
    padding: var(--node-pad);
  }

  .node-deployz {
    background: var(--brand-subtle);
    border-color: var(--brand-border);
  }

  .boundary {
    background: var(--surface-subtle);
    border-color: var(--border-strong);
  }

  .node-role {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    line-height: 1.5;
    font-weight: 600;
    color: var(--muted-foreground);
  }

  .node-role-brand {
    color: var(--brand-hover);
  }

  .node-title {
    margin-top: 6px;
    font-size: 16px;
    line-height: 1.35;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--foreground);
  }

  .node-text {
    margin-top: 4px;
    font-size: 14px;
    line-height: 1.45;
    color: var(--muted-foreground);
  }

  .node-rows {
    margin-top: 16px;
    border-top: 1px solid var(--border);
  }

  .node-rows-brand {
    border-color: var(--brand-border);
  }

  .node-rows li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding-top: 10px;
    font-size: 14px;
    line-height: 1.4;
    font-weight: 500;
    color: var(--foreground);
  }

  .node-tag {
    flex-shrink: 0;
    font-size: 12px;
    font-weight: 500;
    color: var(--muted-foreground);
  }

  .boundary-inner {
    margin-top: 16px;
  }

  .app-node {
    border: 1px solid var(--border-strong);
    border-radius: 8px;
    background: var(--background);
    padding: 12px 14px;
    font-size: 14px;
    line-height: 1.4;
    font-weight: 600;
    color: var(--foreground);
  }

  /* Resources hang from the application container as a thin tree. */
  .resource-list {
    display: grid;
    gap: 8px;
    margin-left: 18px;
    padding-top: 8px;
  }

  .resource-list li {
    position: relative;
    padding-left: 22px;
  }

  .resource-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: -8px;
    bottom: 50%;
    width: 14px;
    border-left: 1.5px solid var(--stroke);
    border-bottom: 1.5px solid var(--stroke);
    border-bottom-left-radius: 6px;
  }

  .resource-list li:not(:last-child)::after {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    bottom: -8px;
    border-left: 1.5px solid var(--stroke);
  }

  .resource-node {
    display: block;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--background);
    padding: 8px 12px;
    font-size: 14px;
    line-height: 1.35;
    font-weight: 500;
    color: var(--muted-foreground);
  }

  /* ---- Connectors ---- */
  .connector {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 64px;
    color: var(--stroke);
  }

  .connector-brand {
    color: var(--brand);
  }

  .connector svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }

  .connector svg path {
    vector-effect: non-scaling-stroke;
  }

  .connector-h,
  .connector-head-h {
    display: none;
  }

  .connector-v {
    position: absolute;
    left: 50%;
    top: 0;
    width: 12px;
    height: calc(100% - 2px);
    transform: translateX(-50%);
  }

  .connector-head-v {
    position: absolute;
    left: 50%;
    bottom: 0;
    width: 12px;
    height: 8px;
    transform: translateX(-50%);
  }

  .connector-label {
    position: absolute;
    left: calc(50% + 14px);
    top: 50%;
    transform: translateY(-50%);
    font-size: 12px;
    line-height: 1.3;
    font-weight: 500;
    color: var(--muted-foreground);
    max-width: calc(50% - 14px);
  }

  .connector-brand .connector-label {
    color: var(--brand-hover);
  }

  @media (min-width: 560px) {
    .diagram-grid {
      max-width: 520px;
    }
  }

  /* ---- Wide: horizontal architecture ---- */
  @media (min-width: 900px) {
    .diagram-grid {
      max-width: none;
      grid-template-columns: minmax(0, 1fr) 72px minmax(0, 1.08fr) 96px minmax(0, 1.16fr);
      align-items: center;
    }

    .connector {
      height: auto;
      align-self: stretch;
    }

    .connector-v,
    .connector-head-v {
      display: none;
    }

    .connector-h {
      display: block;
      position: absolute;
      left: 0;
      right: 2px;
      top: 50%;
      width: calc(100% - 2px);
      height: 12px;
      transform: translateY(-50%);
    }

    .connector-head-h {
      display: block;
      position: absolute;
      right: 0;
      top: 50%;
      width: 8px;
      height: 12px;
      transform: translateY(-50%);
    }

    .connector-label {
      left: 50%;
      top: auto;
      bottom: calc(50% + 10px);
      transform: translateX(-50%);
      text-align: center;
      white-space: normal;
      width: 100%;
      max-width: none;
      padding-inline: 4px;
    }

    .boundary {
      --node-pad: 24px;
    }
  }

  @media (min-width: 1200px) {
    .diagram-grid {
      grid-template-columns: minmax(0, 1fr) 96px minmax(0, 1.04fr) 124px minmax(0, 1.16fr);
    }
  }
</style>
