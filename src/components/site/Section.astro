---
interface Props {
  id?: string;
  tone?: 'default' | 'subtle';
  labelledby?: string;
  label?: string;
  class?: string;
  innerClass?: string;
}

const { id, tone = 'default', labelledby, label, class: className, innerClass } = Astro.props;
---

<section
  id={id}
  aria-labelledby={labelledby}
  aria-label={label}
  class:list={[
    'section-y',
    tone === 'subtle' && 'bg-surface-subtle',
    className,
  ]}
>
  <div class:list={['container-site', innerClass]}>
    <slot />
  </div>
</section>
