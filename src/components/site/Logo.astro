---
interface Props {
  size?: number;
  class?: string;
}

const { size = 28, class: className } = Astro.props;
---

<span class:list={['inline-flex items-center gap-[9px] text-foreground', className]}>
  <img src="/deployz-icon-master.svg" alt="" width={size} height={size} class="block shrink-0" style={`width:${size}px;height:${size}px`} />
  <span class="text-[19px] leading-none font-semibold tracking-[-0.02em]">deployz</span>
</span>
