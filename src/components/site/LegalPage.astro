---
/*
 * Shared layout for the legal documents (src/legal/*.md). The text is published as supplied;
 * do not edit it here. Each page passes its rendered Markdown in the default slot.
 */
import PageHeader from '@/components/site/PageHeader.astro';
import Base from '../../layouts/Base.astro';

interface Props {
  title: string;
  updated: string;
  description: string;
  current: string;
}

const { title, updated, description, current } = Astro.props;

const documents = [
  { href: '/privacy/', label: 'Privacy Policy' },
  { href: '/terms/', label: 'Terms of Service' },
  { href: '/gdpr/', label: 'GDPR & Data Protection' },
  { href: '/dpa/', label: 'Data Processing Addendum' },
];
---

<Base title={`${title} — Deployz`} description={description}>
  <PageHeader eyebrow="Legal" title={title}>
    Last updated: {updated}
  </PageHeader>

  <div class="container-site pb-20 sm:pb-24 lg:grid lg:grid-cols-[200px_minmax(0,720px)] lg:justify-between lg:gap-16 lg:pb-32">
    <nav aria-label="Legal documents" class="mb-10 lg:sticky lg:top-24 lg:mb-0 lg:self-start">
      <p class="text-eyebrow mb-2 text-subtle">Legal</p>
      <ul class="grid grid-cols-1 gap-x-6 sm:grid-cols-2 lg:grid-cols-1">
        {documents.map((doc) => (
          <li>
            <a
              href={doc.href}
              aria-current={doc.href === current ? 'page' : undefined}
              class="flex min-h-11 items-center text-[15px] text-muted-foreground transition-[color] duration-150 hover:text-brand aria-[current=page]:font-medium aria-[current=page]:text-foreground"
            >
              {doc.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <article class="legal min-w-0">
      <slot />
    </article>
  </div>
</Base>

<style>
  .legal {
    font-size: 16px;
    line-height: 1.7;
    color: var(--muted-foreground);
  }

  .legal :global(h2) {
    margin-top: 48px;
    font-size: 22px;
    line-height: 1.3;
    font-weight: 600;
    letter-spacing: -0.015em;
    color: var(--foreground);
  }

  .legal :global(h2:first-child) {
    margin-top: 0;
  }

  .legal :global(p),
  .legal :global(ul),
  .legal :global(table) {
    margin-top: 16px;
  }

  .legal :global(h2 + p),
  .legal :global(h2 + ul),
  .legal :global(h2 + table) {
    margin-top: 12px;
  }

  .legal :global(ul) {
    display: grid;
    gap: 8px;
    padding-left: 20px;
    list-style: disc;
  }

  .legal :global(li::marker) {
    color: var(--text-subtle);
  }

  .legal :global(li > p) {
    margin-top: 0;
  }

  .legal :global(strong) {
    font-weight: 600;
    color: var(--foreground);
  }

  /* Links keep a 44px target, and long URLs wrap instead of overflowing. */
  .legal :global(a) {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    color: var(--brand);
    text-decoration: underline;
    text-underline-offset: 3px;
    overflow-wrap: anywhere;
  }

  .legal :global(a:hover) {
    color: var(--brand-hover);
  }

  .legal :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 15px;
  }

  .legal :global(th),
  .legal :global(td) {
    padding: 10px 12px 10px 0;
    border-bottom: 1px solid var(--border);
    text-align: left;
    vertical-align: top;
    overflow-wrap: anywhere;
  }

  .legal :global(th) {
    font-weight: 600;
    color: var(--foreground);
    border-bottom-color: var(--border-strong);
  }
</style>
