---
import { buttonVariants } from '@/components/ui/button';
import { Separator } from '@/components/ui/separator';
import { cn } from '@/lib/utils';
import '@/styles/globals.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Customers ask for your SaaS in their AWS account. Deployz installs and updates your application there (BYOC), and you do not build a deployment platform.',
} = Astro.props;

const navLinks = [
  { href: '/how-it-works', label: 'How It Works' },
  { href: '/security', label: 'Security' },
  { href: '/pricing', label: 'Pricing' },
  { href: '/docs', label: 'Docs' },
];
const footerGroups = [
  {
    title: 'Product',
    links: [
      { href: '/how-it-works', label: 'How It Works' },
      { href: '/pricing', label: 'Pricing' },
      { href: '/get-started', label: 'Get Started' },
    ],
  },
  {
    title: 'Resources',
    links: [
      { href: '/docs', label: 'Documentation' },
      { href: '/security', label: 'Security' },
      { href: '/blog', label: 'Blog' },
    ],
  },
];

const pathname = Astro.url.pathname;
const canonicalURL = new URL(pathname, Astro.site);
const isCurrent = (href: string) => pathname === href || pathname.startsWith(`${href}/`);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="Deployz" />
    <meta property="og:image" content={new URL('/android-chrome-512x512.png', Astro.site)} />
    <meta name="twitter:card" content="summary" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/deployz-icon-master.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="mask-icon" href="/safari-pinned-tab.svg" color="#000000" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#000000" />
  </head>
  <body class="flex min-h-screen flex-col">
    <a
      class="fixed top-3 left-3 z-50 -translate-y-20 rounded-lg bg-primary px-4 py-3 text-sm font-medium text-primary-foreground transition-transform focus:translate-y-0 focus:outline-none focus:ring-3 focus:ring-ring/50"
      href="#main-content"
    >
      Skip to content
    </a>
    <header>
      <nav
        aria-label="Primary navigation"
        class="mx-auto grid w-full max-w-6xl grid-cols-1 items-center gap-3 px-4 py-3 min-[300px]:grid-cols-[1fr_auto] md:flex md:min-h-16 md:px-6 xl:px-8"
      >
        <a
          class="flex min-h-11 items-center gap-2 text-base font-semibold tracking-tight text-foreground focus-visible:rounded-lg focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-ring/50"
          href="/"
        >
          <img src="/deployz-icon-master.svg" alt="" width="24" height="24" />
          deployz
        </a>
        <div class="flex flex-wrap items-center justify-start gap-1 min-[300px]:justify-end md:order-3 md:ml-auto">
          <a class={cn(buttonVariants({ variant: 'ghost' }), 'min-h-11')} href="https://app.deployz.dev/sign-in">Sign in</a>
          <a class={cn(buttonVariants(), 'h-auto min-h-11 shrink text-center whitespace-normal')} href="/get-started">Check my application</a>
        </div>
        <div class="col-span-1 flex flex-wrap items-center gap-1 min-[300px]:col-span-2 md:order-2 md:col-auto md:ml-5">
          {navLinks.map((link) => (
            <a class={cn(buttonVariants({ variant: isCurrent(link.href) ? 'secondary' : 'ghost' }), 'min-h-11')} href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>{link.label}</a>
          ))}
        </div>
      </nav>
    </header>
    <Separator />
    <main id="main-content" class="mx-auto w-full max-w-6xl flex-1 px-4 py-8 md:px-6 md:py-12 xl:px-8">
      <slot />
    </main>
    <Separator />
    <footer class="mx-auto w-full max-w-6xl px-4 py-8 text-sm text-muted-foreground md:px-6 xl:px-8">
      <nav aria-label="Footer navigation" class="grid gap-8 sm:grid-cols-2">
        {footerGroups.map((group) => (
          <div>
            <p class="font-medium text-foreground">{group.title}</p>
            <ul class="mt-2">
              {group.links.map((link) => (
                <li>
                  <a
                    class="flex min-h-11 items-center hover:text-foreground hover:underline focus-visible:rounded-lg focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-ring/50"
                    href={link.href}
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </nav>
      <p class="mt-8">&copy; {new Date().getFullYear()} Deployz</p>
    </footer>
  </body>
</html>
