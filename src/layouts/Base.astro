---
import { buttonVariants } from '@/components/ui/button';
import { Separator } from '@/components/ui/separator';
import { cn } from '@/lib/utils';
import '@/styles/globals.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Deployz deploys and operates your product inside every customer AWS account. Connect once, share a Deploy to Your AWS link, and let Deployz run the deployment layer.',
} = Astro.props;

const pathname = Astro.url.pathname;
const canonicalURL = new URL(pathname, Astro.site);
const isCurrent = (href: string) => pathname === href || pathname.startsWith(`${href}/`);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="flex min-h-screen flex-col">
    <a
      class="fixed top-3 left-3 z-50 -translate-y-20 rounded-lg bg-primary px-4 py-3 text-sm font-medium text-primary-foreground transition-transform focus:translate-y-0 focus:outline-none focus:ring-3 focus:ring-ring/50"
      href="#main-content"
    >
      Skip to content
    </a>
    <header>
      <nav
        aria-label="Primary navigation"
        class="mx-auto grid w-full max-w-6xl grid-cols-1 items-center gap-3 px-4 py-3 min-[300px]:grid-cols-[1fr_auto] sm:px-6 md:flex md:min-h-16 md:px-8"
      >
        <a
          class="flex min-h-11 items-center text-base font-semibold tracking-tight text-foreground focus-visible:rounded-lg focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-ring/50"
          href="/"
        >
          deployz
        </a>
        <div class="flex items-center justify-start gap-1 min-[300px]:justify-end md:order-3 md:ml-auto">
          <a class={cn(buttonVariants({ variant: 'ghost' }), 'min-h-11')} href="https://app.deployz.dev/sign-in">Sign in</a>
          <a class={cn(buttonVariants(), 'min-h-11')} href="https://app.deployz.dev/sign-up">Sign up</a>
        </div>
        <div class="col-span-1 flex items-center gap-1 min-[300px]:col-span-2 md:order-2 md:col-auto md:ml-5">
          <a class={cn(buttonVariants({ variant: isCurrent('/docs') ? 'secondary' : 'ghost' }), 'min-h-11')} href="/docs" aria-current={isCurrent('/docs') ? 'page' : undefined}>Docs</a>
          <a class={cn(buttonVariants({ variant: isCurrent('/blog') ? 'secondary' : 'ghost' }), 'min-h-11')} href="/blog" aria-current={isCurrent('/blog') ? 'page' : undefined}>Blog</a>
        </div>
      </nav>
    </header>
    <Separator />
    <main id="main-content" class="mx-auto w-full max-w-6xl flex-1 px-4 py-16 sm:px-6 md:px-8 md:py-20">
      <slot />
    </main>
    <Separator />
    <footer class="mx-auto flex min-h-20 w-full max-w-6xl flex-col justify-center gap-2 px-4 py-5 text-sm text-muted-foreground sm:flex-row sm:items-center sm:justify-between sm:px-6 md:px-8">
      <span>&copy; {new Date().getFullYear()} Deployz</span>
      <a
        class="flex min-h-11 items-center text-foreground hover:underline focus-visible:rounded-lg focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-ring/50"
        href="https://deployz.dev"
      >
        deployz.dev
      </a>
    </footer>
  </body>
</html>
